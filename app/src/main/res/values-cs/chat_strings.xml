    <string name="chat_template_child_sick_title">Dítě je nemocné</string>
    <string name="chat_template_child_sick_content">[Dítě] má dnes [příznaky] a teplotu [teplota]. Zůstáváme doma, do [čas] ti dám vědět, jak to vypadá.</string>
