    <string name="chat_template_doctor_visit_content">Posílám shrnutí dnešní návštěvy u lékaře s [dítětem]. Důvod: [důvod]. Závěr lékaře: [diagnóza a léčba]. Léky: [název, dávkování, do kdy]. Další kontrola: [datum].</string>
    <string name="chat_template_school_event_title">Školní akce</string>
    <string name="chat_template_school_event_content">Ve škole bude [akce], [datum] v [čas]. Chystám se tam. Půjdeš taky?</string>
    <string name="chat_template_parent_teacher_meeting_title">Třídní schůzky</string>
    <string name="chat_template_parent_teacher_meeting_content">Třídní schůzky jsou [datum] v [čas], škola chce probrat [téma]. Půjdeš? Pokud ne, pošlu ti potom shrnutí.</string>
    <string name="chat_template_school_update_title">Zpráva ze školy</string>
