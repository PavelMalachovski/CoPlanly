    <!-- MON-19: the lexical hint over the composer. Plain observations of what was typed, never a verdict. -->
    <string name="chat_nudge_shouting">Velká písmena mohou působit jako křik.</string>
    <string name="chat_nudge_punctuation">Opakované !!! nebo ??? mohou působit jako zvýšený hlas.</string>
    <string name="chat_nudge_listed_words">Slova jako %1$s mohou vyznít tvrději, než chcete.</string>
    <!-- MON-19: a short, mild list of words that tend to land harder than meant. Matching ignores
         case and accents; an entry ending in * matches every word starting with it, so an
         inflected word is listed once. Keep it short and mild: this is a nudge, not a filter. -->
    <string-array name="chat_nudge_words">
    <item>vždy</item>
    <item>vždycky</item>
    <item>nikdy</item>
    <item>směšn*</item>
    <item>hloup*</item>
    <item>trapn*</item>
    <item>neschopn*</item>
    <item>sobeck*</item>
    <item>nezodpovědn*</item>
    <item>typick*</item>
  </string-array>
