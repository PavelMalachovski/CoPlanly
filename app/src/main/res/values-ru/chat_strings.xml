    <string name="chat_day_today">Сегодня</string>
    <string name="chat_day_yesterday">Вчера</string>

    <!-- Thread header: whether your own messages actually left the device. -->
    <string name="chat_header_synced">Всё отправлено</string>

    <!-- Accessibility label for the change-request card's clickable bubble. -->
    <string name="chat_open_change_request">Открыть запрос на изменение</string>

    <!-- Message templates (domain/model/MessageTemplate.kt). The body is seeded into the
         composer for the user to edit before sending, so the bracketed hints are translated
         too: they are prompts to the reader, not substitution tokens. -->
    <string name="chat_templates_sheet_title">Шаблоны сообщений</string>
    <string name="chat_template_category_handover">Передача и график</string>
    <string name="chat_template_category_health">Здоровье</string>
    <string name="chat_template_category_school">Школа</string>
    <string name="chat_template_category_holidays">Каникулы и поездки</string>
    <string name="chat_template_category_expenses">Расходы</string>
    <string name="chat_template_category_replies">Ответы</string>
    <string name="chat_template_handover_confirm_title">Подтвердить передачу</string>
    <string name="chat_template_handover_confirm_content">Подтверждаю передачу: [день] в [время], место: [место]. Если что-то изменится, напиши, пожалуйста.</string>
    <string name="chat_template_pickup_delay_title">Опаздываю</string>
    <string name="chat_template_pickup_delay_content">Опаздываю на передачу примерно на [сколько] минут, буду не позже [время]. Извини за ожидание.</string>
    <string name="chat_template_pickup_early_title">Передача пораньше</string>
    <string name="chat_template_pickup_early_content">Можно [день] сделать передачу пораньше, в [время]? Если неудобно, оставим обычное время.</string>
    <string name="chat_template_packing_title">Что собрать</string>
    <string name="chat_template_packing_content">Можешь, пожалуйста, собрать на [день] [вещи]? Они понадобятся для [чего]. Спасибо.</string>
    <string name="chat_template_schedule_change_title">Поменяться днями</string>
    <string name="chat_template_schedule_change_content">Можем поменяться днями? Ты берёшь [дата], а я взамен — [другая дата]. Напиши, пожалуйста, до [дата].</string>
    <string name="chat_template_child_sick_title">Ребёнок заболел</string>
    <string name="chat_template_child_sick_content">У [ребёнка] сегодня [симптомы], температура [температура]. Мы остаёмся дома, до [время] напишу, как дела.</string>
    <string name="chat_template_doctor_visit_title">После визита к врачу</string>
    <string name="chat_template_doctor_visit_content">Сегодня мы с [ребёнком] были у врача. Причина: [причина]. Заключение: [диагноз и лечение]. Лекарства: [название, дозировка, до какого числа]. Следующий приём: [дата].</string>
    <string name="chat_template_school_event_title">Школьное мероприятие</string>
    <string name="chat_template_school_event_content">В школе [дата] в [время] будет [мероприятие]. Я собираюсь пойти. Ты тоже пойдёшь?</string>
    <string name="chat_template_parent_teacher_meeting_title">Родительское собрание</string>
    <string name="chat_template_parent_teacher_meeting_content">Родительское собрание — [дата] в [время], учитель хочет обсудить [тему]. Ты пойдёшь? Если нет, потом расскажу, о чём говорили.</string>
    <string name="chat_template_school_update_title">Новости из школы</string>
    <string name="chat_template_school_update_content">Новости из школы про [ребёнка]: [что случилось]. От тебя ничего не нужно, просто держу тебя в курсе.</string>
    <string name="chat_template_holiday_plan_title">План на каникулы</string>
    <string name="chat_template_holiday_plan_content">Давай спланируем [каникулы]. Моё предложение: [предложение]. Напиши, пожалуйста, до [дата], подходит ли тебе, или предложи свой вариант.</string>
    <string name="chat_template_travel_abroad_title">Поездка за границу</string>
    <string name="chat_template_travel_abroad_content">Планирую поездку с [ребёнком] в [страну] с [дата] по [дата]. Жить будем по адресу: [адрес], мой телефон: [телефон]. Напиши, пожалуйста, до [дата], даёшь ли ты согласие.</string>
    <string name="chat_template_expense_share_title">Доля в расходах</string>
    <string name="chat_template_expense_share_content">Общий расход: [что] от [дата], всего [сумма]. Твоя доля — [сумма]. Сможешь перевести до [дата]? Чек могу переслать.</string>
    <string name="chat_template_acknowledge_title">Сообщение получено</string>
    <string name="chat_template_acknowledge_content">Спасибо за сообщение про [тему]. Отвечу до [день].</string>
    <string name="chat_template_confirm_agreement_title">Подтвердить договорённость</string>
    <string name="chat_template_confirm_agreement_content">Чтобы не было разночтений, вот о чём мы договорились: [договорённость]. Если ты понимаешь это иначе, напиши, пожалуйста.</string>
    <string name="chat_failed_to_send_retry">Не отправлено — нажмите, чтобы повторить</string>
    <string name="chat_load_earlier">Загрузить более ранние сообщения</string>

    <!-- MON-15: search inside the open conversation. Local to this phone; never a server. -->
    <string name="chat_search">Искать в переписке</string>
    <string name="chat_search_close">Закрыть поиск</string>
    <string name="chat_search_clear">Очистить</string>
    <string name="chat_search_placeholder">Поиск по сообщениям</string>
    <string name="chat_search_prompt_title">Поиск в этой переписке</string>
    <string name="chat_search_prompt_description">Поиск идёт по сообщениям, которые уже есть на этом телефоне. Введённый текст никуда не отправляется.</string>
    <string name="chat_search_no_results_title">Подходящих сообщений нет</string>
    <string name="chat_search_no_results_description">В этой переписке ничего не найдено по запросу «%1$s».</string>
    <string name="chat_search_failed_title">Поиск не сработал</string>
    <string name="chat_search_failed_description">Поиск не выполнен. Попробуйте ещё раз чуть позже.</string>
    <string name="chat_search_truncated">Показаны самые новые совпадения: %1$d. Добавьте слово, чтобы сузить поиск.</string>
    <string name="chat_search_result_meta">%1$s · %2$s</string>
    <string name="chat_search_show_in_thread">Показать в переписке</string>
    <!-- MON-19: pause before sending. A held message, with its countdown in seconds. -->
    <string name="chat_pending_send">Отправка через %1$d с…</string>
    <string name="chat_pending_send_undo">Отменить</string>
    <!-- MON-19: the lexical hint over the composer. Plain observations of what was typed, never a verdict. -->
    <string name="chat_nudge_shouting">Заглавные буквы могут читаться как крик.</string>
    <string name="chat_nudge_punctuation">Повторяющиеся !!! или ??? могут читаться как повышенный тон.</string>
    <string name="chat_nudge_listed_words">Слова вроде %1$s могут прозвучать резче, чем вы хотите.</string>
    <!-- MON-19: a short, mild list of words that tend to land harder than meant. Matching ignores
         case and accents; an entry ending in * matches every word starting with it, so an
         inflected word is listed once. Keep it short and mild: this is a nudge, not a filter. -->
    <string-array name="chat_nudge_words">
        <item>всегда</item>
        <item>никогда</item>
        <item>нелеп*</item>
        <item>глуп*</item>
        <item>жалк*</item>
        <item>бесполезн*</item>
        <item>бестолк*</item>
        <item>эгоист*</item>
        <item>безответствен*</item>
        <item>типичн*</item>
    </string-array>
    <!-- A thread kept after the co-parent deleted their account (GDPR review, September 2026). %1$s = their name, %2$s = the day the thread is deleted. -->
    <string name="chat_departed_banner">%1$s: аккаунт удалён. Эта переписка будет удалена %2$s — экспортируйте её до этого срока.</string>
    <string name="chat_departed_export">Экспортировать</string>
    <string name="chat_departed_no_sending">В эту переписку больше нельзя отправлять сообщения.</string>
    <string name="chat_departed_unnamed">Второй родитель</string>
</resources>
