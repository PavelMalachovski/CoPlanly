<?xml version="1.0" encoding="utf-8"?>
<!-- Chat feature strings. Kept out of strings.xml because strings.xml is
     gitignored in this project (it holds local OAuth values). -->
<resources>
    <string name="chat_new_conversation">New conversation</string>
    <string name="chat_empty_title">No conversations yet</string>
    <string name="chat_empty_description">Start a conversation with your co-parent to coordinate schedules and share updates.</string>
    <string name="chat_no_messages">No messages yet</string>
    <string name="chat_messages_empty_title">No messages yet</string>
    <string name="chat_messages_empty_description">Start the conversation by sending a message to your co-parent.</string>
    <string name="chat_type_message">Type a message…</string>
    <string name="chat_send">Send</string>
    <string name="chat_status_sending">Sending</string>
    <string name="chat_status_error">Error</string>
    <string name="chat_status_sent">Sent</string>
    <!-- Tick content description: the message reached the co-parent's device but has not been read yet. -->
    <string name="chat_status_delivered">Delivered</string>
    <!-- Tick content description: the co-parent has opened the thread past this message. -->
    <string name="chat_status_read">Read</string>
    <string name="chat_sending_ellipsis">Sending…</string>
    <string name="chat_failed_to_send">Failed to send</string>
    <string name="chat_title_fallback">Chat</string>
    <string name="chat_back">Back</string>
    <string name="chat_request_change">Request change</string>
    <string name="chat_request_change_title">Request a change</string>
    <string name="chat_no_upcoming_events">No upcoming events to propose a change for.</string>
    <string name="chat_pick_event_to_reschedule">Pick the event you\'d like to reschedule:</string>
    <!-- Shown when the co-parent action is used on an account that has no co-parent linked. -->
    <string name="chat_no_coparent">You are not linked with a co-parent yet.</string>
    <!-- Snackbar action next to chat_no_coparent; opens the pairing screen. -->
    <string name="chat_no_coparent_action">Pair</string>
    <!-- Shown when the pairing state has not resolved in time; the action is worth retrying. -->
    <string name="chat_coparent_link_pending">Still checking your co-parent link. Try again in a moment.</string>

    <!-- Screen-reader content description for the unread-message badge on the bottom nav's Chat tab. -->
    <plurals name="chat_unread_messages_badge">
        <item quantity="one">%1$d unread message</item>
        <item quantity="other">%1$d unread messages</item>
    </plurals>
    <!-- Visible badge text once the unread count passes the display cap, e.g. "99+". -->
    <string name="chat_unread_count_overflow">%1$d+</string>

    <!-- Composer action chips and day separators (Aug 2026 design refresh). -->
    <string name="chat_templates">Templates</string>
    <string name="chat_day_today">Today</string>
    <string name="chat_day_yesterday">Yesterday</string>

    <!-- Thread header: whether your own messages actually left the device. -->
    <string name="chat_header_synced">Up to date</string>

    <!-- Accessibility label for the change-request card's clickable bubble. -->
    <string name="chat_open_change_request">Open the change request</string>

    <!-- Message templates (domain/model/MessageTemplate.kt). The body is seeded into the
         composer for the user to edit before sending, so the bracketed hints are translated
         too: they are prompts to the reader, not substitution tokens. -->
    <string name="chat_templates_sheet_title">Message templates</string>
    <string name="chat_template_category_handover">Handovers and schedule</string>
    <string name="chat_template_category_health">Health</string>
    <string name="chat_template_category_school">School</string>
    <string name="chat_template_category_holidays">Holidays and travel</string>
    <string name="chat_template_category_expenses">Expenses</string>
    <string name="chat_template_category_replies">Replies</string>
    <string name="chat_template_handover_confirm_title">Confirm a handover</string>
    <string name="chat_template_handover_confirm_content">Confirming the handover on [day] at [time], at [place]. Please let me know if anything changes.</string>
    <string name="chat_template_pickup_delay_title">Running late</string>
    <string name="chat_template_pickup_delay_content">I\'m running about [number] minutes late for the handover and will be there by [time]. Sorry for the wait.</string>
    <string name="chat_template_pickup_early_title">Ask for an earlier handover</string>
    <string name="chat_template_pickup_early_content">Would it work to do the handover earlier on [day], at [time]? If not, the usual time is fine.</string>
    <string name="chat_template_packing_title">Things to pack</string>
    <string name="chat_template_packing_content">Could you please pack [items] for [day]? They\'re needed for [what for]. Thank you.</string>
    <string name="chat_template_schedule_change_title">Ask to swap days</string>
    <string name="chat_template_schedule_change_content">Could we swap days? You\'d take [date], and I\'d take [other date] in return. Please let me know by [date].</string>
    <string name="chat_template_child_sick_title">Child is unwell</string>
    <string name="chat_template_child_sick_content">[Child] has [symptoms] today and a temperature of [temperature]. We\'re staying at home, and I\'ll give you an update by [time].</string>
    <string name="chat_template_doctor_visit_title">After a doctor\'s visit</string>
    <string name="chat_template_doctor_visit_content">I took [child] to the doctor today. Reason: [reason]. Diagnosis and treatment: [what the doctor said]. Medicine: [name, dose, until when]. Next check-up: [date].</string>
    <string name="chat_template_school_event_title">School event</string>
    <string name="chat_template_school_event_content">The school\'s [event] is on [date] at [time]. I\'m planning to go. Are you going too?</string>
    <string name="chat_template_parent_teacher_meeting_title">Parent-teacher meeting</string>
    <string name="chat_template_parent_teacher_meeting_content">The parent-teacher meeting is on [date] at [time], and the teacher would like to discuss [topic]. Are you going? If not, I\'ll send you a summary afterwards.</string>
    <string name="chat_template_school_update_title">School update</string>
    <string name="chat_template_school_update_content">An update from school about [child]: [what happened]. Nothing is needed from you, this is just so you know.</string>
    <string name="chat_template_holiday_plan_title">Plan the holidays</string>
    <string name="chat_template_holiday_plan_content">Let\'s plan [holiday]. My suggestion: [proposal]. Could you let me know by [date] whether that works, or suggest something else?</string>
    <string name="chat_template_travel_abroad_title">Travel abroad</string>
    <string name="chat_template_travel_abroad_content">I\'m planning a trip with [child] to [country] from [date] to [date]. We\'ll stay at [address], and you can reach me on [phone]. Could you let me know by [date] whether you agree?</string>
    <string name="chat_template_expense_share_title">Share of an expense</string>
    <string name="chat_template_expense_share_content">Shared expense: [what], [date], [amount] in total. Your share is [amount]. Could you send it by [date]? I can forward the receipt.</string>
    <string name="chat_template_acknowledge_title">Got your message</string>
    <string name="chat_template_acknowledge_content">Thanks for your message about [topic]. I\'ll reply by [day].</string>
    <string name="chat_template_confirm_agreement_title">Confirm what we agreed</string>
    <string name="chat_template_confirm_agreement_content">To make sure we\'re on the same page, here\'s what we agreed: [agreement]. If you see it differently, please let me know.</string>
    <string name="chat_failed_to_send_retry">Not sent — tap to retry</string>
    <string name="chat_load_earlier">Load earlier messages</string>

    <!-- MON-15: search inside the open conversation. Local to this phone; never a server. -->
    <string name="chat_search">Search this conversation</string>
    <string name="chat_search_close">Close search</string>
    <string name="chat_search_clear">Clear</string>
    <string name="chat_search_placeholder">Search messages</string>
    <string name="chat_search_prompt_title">Search this conversation</string>
    <string name="chat_search_prompt_description">Searches the messages already on this phone. Nothing you type here leaves it.</string>
    <string name="chat_search_no_results_title">No matching messages</string>
    <string name="chat_search_no_results_description">Nothing in this conversation matches “%1$s”.</string>
    <string name="chat_search_failed_title">Search did not work</string>
    <string name="chat_search_failed_description">Nothing was searched. Try again in a moment.</string>
    <string name="chat_search_truncated">Showing the %1$d newest matches. Add a word to narrow them down.</string>
    <string name="chat_search_result_meta">%1$s · %2$s</string>
    <string name="chat_search_show_in_thread">Show in conversation</string>
    <!-- MON-19: pause before sending. A held message, with its countdown in seconds. -->
    <string name="chat_pending_send">Sending in %1$d s…</string>
    <string name="chat_pending_send_undo">Undo</string>
    <!-- MON-19: the lexical hint over the composer. Plain observations of what was typed, never a verdict. -->
    <string name="chat_nudge_shouting">Capitals can read as shouting.</string>
    <string name="chat_nudge_punctuation">Repeated !!! or ??? can read as a raised voice.</string>
    <string name="chat_nudge_listed_words">Words like %1$s can land harder than you mean.</string>
    <!-- MON-19: a short, mild list of words that tend to land harder than meant. Matching ignores
         case and accents; an entry ending in * matches every word starting with it, so an
         inflected word is listed once. Keep it short and mild: this is a nudge, not a filter. -->
    <string-array name="chat_nudge_words">
        <item>always</item>
        <item>never</item>
        <item>ridiculous</item>
        <item>stupid</item>
        <item>pathetic</item>
        <item>useless</item>
        <item>whatever</item>
        <item>typical</item>
        <item>selfish</item>
        <item>irresponsible</item>
    </string-array>
    <!-- A thread kept after the co-parent deleted their account (GDPR review, September 2026). %1$s = their name, %2$s = the day the thread is deleted. -->
    <string name="chat_departed_banner">%1$s deleted their account. This conversation will be deleted on %2$s. Export it before then.</string>
    <string name="chat_departed_export">Export</string>
    <string name="chat_departed_no_sending">Messages can no longer be sent in this conversation.</string>
    <string name="chat_departed_unnamed">Your co-parent</string>
    <!-- Report and block (play-final audit F-10). A report opens the parent's email app to the
         support address with the message's ids and time; the message text is never included. Block
         opens the existing unpair confirmation: unpairing ends messaging and sharing. -->
    <string name="chat_more_actions">More actions</string>
    <string name="chat_block">Block and stop sharing</string>
    <string name="chat_report_message">Report message</string>
    <string name="chat_report_subject">CoPlanly: report a chat message</string>
    <string name="chat_report_body">Tell us what is wrong with this message:\n\n\n---\nThe message text is not included. If you want us to read it, paste it above.\nMessage ID: %1$s\nConversation ID: %2$s\nSent at (UTC): %3$s</string>
    <string name="chat_report_no_email_app">No email app is set up. To report the message, write to %1$s.</string>
</resources>
