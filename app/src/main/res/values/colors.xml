<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand colors for CoPlanly app.
         brand_primary is the ONE brand colour (UX-14) and must equal CoPlanlyColors.BrandPrimary
         (presentation/theme/Color.kt), which is the source of truth: the light theme's primary.
         The system splash (themes.xml), the Compose splash and the launcher icon background all
         draw it, so the four surfaces a cold start shows in a row read as one colour. -->
    <color name="brand_primary">#4F46E5</color>
    <color name="brand_secondary">#958DA5</color>

    <!-- Parent identity colours: slot 1 pink, slot 2 blue. They identify a person, not a role. -->
    <color name="mom_pink">#E91E63</color>
    <color name="dad_blue">#1976D2</color>

    <!-- Basic colors -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Adaptive launcher icon background, drawn by drawable/ic_launcher_background.xml
         (which mipmap-anydpi-v26 references). The brand colour, not a colour of its own. -->
    <color name="ic_launcher_background">@color/brand_primary</color>

    <!-- The window behind Compose before its first frame, per theme (UX-13). values-night
         overrides it, so a cold start in dark mode no longer flashes white. Equal to
         CoPlanlyColors.LightBackground / DarkBackground. -->
    <color name="window_background">#FCFBFF</color>
</resources>

