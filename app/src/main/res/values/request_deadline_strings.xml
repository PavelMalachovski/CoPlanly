<?xml version="1.0" encoding="utf-8"?>
<!-- A request's clock (phase 3a): its deadline, the last chance and the outcome nobody chose.
     Never the words "Mom" or "Dad": every parent label goes through ParentNames. -->
<resources>
    <!-- The outcome of a request nobody answered by the end of its clock. Its own outcome, never
         "Declined": the other parent said nothing, which is not saying no. -->
    <string name="request_clock_no_answer">No answer</string>
    <!-- The local notices a request's clock posts (phase 3a, spec §4.3–§4.4). %1$s is the other
         parent's name, never a role; %2$s the deadline as answerByText words it. -->
    <string name="request_notice_reminder_title">Waiting for your answer</string>
    <string name="request_notice_reminder_body">%1$s is waiting for your answer until %2$s.</string>
    <string name="request_notice_deadline_title">%1$s didn\'t answer by the deadline</string>
    <string name="request_notice_deadline_body">Nothing has changed in the calendar. You can give more time.</string>
    <string name="request_notice_no_answer_title">No answer from %1$s</string>
    <string name="request_notice_no_answer_body">The request is closed as “No answer”. Nothing has changed in the calendar.</string>
    <!-- The deadline block in the four forms (phase 3a, spec §6.1). %1$s is a time as answerByText
         words it, %2$s the other parent's name, %3$d the number of reminders. -->
    <string name="answer_by_title">Answer by</string>
    <string name="answer_by_tomorrow">Tomorrow</string>
    <string name="answer_by_three_days">3 days</string>
    <string name="answer_by_week">A week</string>
    <string name="answer_by_pick_date">Pick a date…</string>
    <string name="answer_by_compressed">By %1$s</string>
    <plurals name="answer_by_reminders">
        <item quantity="one">By %1$s. %2$s gets up to %3$d reminder, none at night.</item>
        <item quantity="other">By %1$s. %2$s gets up to %3$d reminders, none at night.</item>
    </plurals>
    <string name="answer_by_outcome">No answer by then — you\'ll be told and can give 24 more hours. Nothing changes in the calendar without an answer.</string>
    <string name="answer_by_outcome_short">No answer by then — you\'ll be told and can give a little more time. Nothing changes in the calendar without an answer.</string>
    <string name="answer_by_fixed">Answer by %1$s</string>
    <string name="answer_by_too_soon">Too soon for a deadline — it goes out as a plain request.</string>
    <string name="answer_by_picker_ok">OK</string>
    <string name="answer_by_picker_cancel">Cancel</string>
    <!-- The deadline on each inbox card (phase 3a, spec §6.2–§6.5). Every time is worded by
         answerByText; %2$s after " · " is how long is left (request_left_*). A name is the other
         parent's, never a role. -->
    <string name="request_clock_answer_by">Answer by %1$s · %2$s</string>
    <string name="request_clock_sent">Sent · Answer by %1$s</string>
    <string name="request_clock_opened">%1$s opened it · %2$s</string>
    <string name="request_clock_not_opened">%1$s hasn\'t opened it yet</string>
    <string name="request_clock_reminders">Reminders: %1$d of %2$d</string>
    <string name="request_clock_reminders_next">Reminders: %1$d of %2$d · next %3$s</string>
    <string name="request_clock_last_chance_until">More time until %1$s · %2$s</string>
    <string name="request_clock_deadline_passed">Deadline passed %1$s</string>
    <string name="request_clock_calendar_unchanged">Nothing has changed in the calendar.</string>
    <string name="request_clock_give_last_chance">Give 24 more hours</string>
    <string name="request_clock_give_last_chance_until">Give more time — until %1$s</string>
    <string name="request_clock_last_chance_once">Once. %1$s will have until %2$s.</string>
    <string name="request_clock_responder_unanswered">You didn\'t answer by the deadline. %1$s can give you more time, until %2$s.</string>
    <string name="request_last_chance_banner_title">More time · %1$s left</string>
    <string name="request_last_chance_banner_text">Answer by %1$s. Without an answer the request closes as “No answer”.</string>
    <string name="request_last_chance_failed">The extra time couldn\'t be sent. Try again.</string>
    <plurals name="request_left_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <plurals name="request_left_hours">
        <item quantity="one">%1$d h</item>
        <item quantity="other">%1$d h</item>
    </plurals>
    <plurals name="request_left_minutes">
        <item quantity="one">%1$d min</item>
        <item quantity="other">%1$d min</item>
    </plurals>
    <!-- The meta line of a "No answer" row in History (spec §6.6), parts joined with " · ". -->
    <string name="request_history_meta_deadline">Deadline %1$s</string>
    <string name="request_history_meta_last_chance">more time until %1$s</string>
    <string name="request_history_meta_opened">opened %1$s</string>
    <string name="request_history_meta_unchanged">calendar unchanged</string>
    <plurals name="request_history_meta_reminders">
        <item quantity="one">%1$d reminder</item>
        <item quantity="other">%1$d reminders</item>
    </plurals>
</resources>
