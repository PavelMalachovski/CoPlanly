<?xml version="1.0" encoding="utf-8"?>
<!-- A request's clock (phase 3a): its deadline, the last chance and the outcome nobody chose.
     Never the words "Mom" or "Dad": every parent label goes through ParentNames. -->
<resources>
    <!-- The outcome of a request nobody answered by the end of its clock. Its own outcome, never
         "Declined": the other parent said nothing, which is not saying no. -->
    <string name="request_clock_no_answer">No answer</string>
    <!-- The local notices a request's clock posts (phase 3a, spec §4.3–§4.4). %1$s is the other
         parent's name, never a role; %2$s the deadline as answerByText words it. -->
    <string name="request_notice_reminder_title">Waiting for your answer</string>
    <string name="request_notice_reminder_body">%1$s is waiting for your answer until %2$s.</string>
    <string name="request_notice_deadline_title">%1$s didn\'t answer by the deadline</string>
    <string name="request_notice_deadline_body">Nothing has changed in the calendar. You can give a last chance.</string>
    <string name="request_notice_no_answer_title">No answer from %1$s</string>
    <string name="request_notice_no_answer_body">The request is closed as “No answer”. Nothing has changed in the calendar.</string>
    <!-- The deadline block in the four forms (phase 3a, spec §6.1). %1$s is a time as answerByText
         words it, %2$s the other parent's name, %3$d the number of reminders. -->
    <string name="answer_by_title">Answer by</string>
    <string name="answer_by_tomorrow">Tomorrow</string>
    <string name="answer_by_three_days">3 days</string>
    <string name="answer_by_week">A week</string>
    <string name="answer_by_pick_date">Pick a date…</string>
    <string name="answer_by_compressed">By %1$s</string>
    <plurals name="answer_by_reminders">
        <item quantity="one">By %1$s. %2$s gets up to %3$d reminder, none at night.</item>
        <item quantity="other">By %1$s. %2$s gets up to %3$d reminders, none at night.</item>
    </plurals>
    <string name="answer_by_outcome">No answer by then — you\'ll be told and can give a last chance of 24 hours. Nothing changes in the calendar without an answer.</string>
    <string name="answer_by_outcome_short">No answer by then — you\'ll be told and can give a shorter last chance. Nothing changes in the calendar without an answer.</string>
    <string name="answer_by_fixed">Answer by %1$s</string>
    <string name="answer_by_too_soon">Too soon for a deadline — it goes out as a plain request.</string>
    <string name="answer_by_picker_ok">OK</string>
    <string name="answer_by_picker_cancel">Cancel</string>
</resources>
