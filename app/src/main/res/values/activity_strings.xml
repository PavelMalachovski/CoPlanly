<?xml version="1.0" encoding="utf-8"?>
<!-- Announcements of a change, rendered by the READER in the reader's own language.
     The two parents may not read the same language, so a card composed by the sender is a card
     the recipient may not be able to read. Each key takes the entity's own name as %1$s and never
     concatenates it, because word order differs by language. -->
<resources>
    <string name="activity_event_created">New event: %1$s</string>
    <string name="activity_event_updated">Event changed: %1$s</string>
    <string name="activity_event_deleted">Event removed: %1$s</string>
    <string name="activity_event_accepted">Event accepted: %1$s</string>
    <string name="activity_event_declined">Event declined: %1$s</string>
    <string name="activity_change_requested">New time proposed for %1$s</string>
    <string name="activity_change_accepted">New time agreed for %1$s</string>
    <string name="activity_change_declined">New time turned down for %1$s</string>
    <string name="activity_expense_added">New expense: %1$s</string>
    <string name="activity_expense_updated">Expense changed: %1$s</string>
    <string name="activity_expense_deleted">Expense removed: %1$s</string>
    <string name="activity_day_swap_offered">Day swap offered: %1$s</string>
    <string name="activity_day_swap_accepted">Day swap agreed: %1$s</string>
    <string name="activity_day_swap_declined">Day swap turned down: %1$s</string>
    <string name="activity_day_swap_withdrawn">Day swap withdrawn: %1$s</string>
    <string name="activity_custody_proposed">New custody schedule proposed</string>
    <string name="activity_custody_accepted">New custody schedule agreed</string>
    <string name="activity_custody_declined">Custody proposal turned down</string>
    <string name="activity_custody_withdrawn">Custody proposal withdrawn</string>
    <string name="activity_request_last_chance">More time to answer: %1$s</string>
    <string name="activity_request_unanswered">No answer: %1$s</string>
    <!-- The %1$s of the two request cards above when the request is a custody proposal, which has
         no title of its own. Lower case: it follows a colon. -->
    <string name="activity_subject_custody_schedule">custody schedule</string>
    <string name="activity_settle_up_you_owe">Settle up for %1$s: you owe %2$s</string>
    <string name="activity_settle_up_owed_to_you">Settle up for %1$s: you are owed %2$s</string>
    <!-- An expense split proposal and its answers. No shares: the card names no parent, and a share
         without a name does not say whose it is. -->
    <string name="activity_split_proposed">New expense split proposed</string>
    <string name="activity_split_accepted">New expense split agreed</string>
    <string name="activity_split_declined">Expense split proposal turned down</string>
    <string name="activity_split_withdrawn">Expense split proposal withdrawn</string>
    <!-- The %1$s of the two request cards above when the request is an expense split proposal.
         Lower case: it follows a colon. -->
    <string name="activity_subject_expense_split">expense split</string>
</resources>
