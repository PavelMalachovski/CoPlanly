<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme. AppCompat parent is required by AppCompatActivity, which in turn
         is required for per-app language support (AppCompatDelegate.setApplicationLocales);
         all real theming happens in Compose (CoPlanlyTheme).

         DayNight, not Light, with a per-theme window background (UX-13): the window is what
         shows between the splash and Compose's first frame, and a Light parent painted it
         white on every dark-mode cold start. @color/window_background is overridden in
         values-night/colors.xml. It follows the *system* night mode — the in-app theme choice
         lives in Compose and is not known until the Activity has started. -->
    <style name="Theme.CoPlanly" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Splash Screen theme for Android 12+ -->
    <!-- Based on Material3 SplashScreen API -->
    <style name="Theme.CoPlanly.Starting" parent="Theme.SplashScreen">
        <!-- Background color for the splash screen -->
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <!-- Center animated icon/logo -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- Animation duration in milliseconds -->
        <item name="windowSplashScreenAnimationDuration">300</item>
        <!-- Theme to use after splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.CoPlanly</item>
    </style>
</resources>

