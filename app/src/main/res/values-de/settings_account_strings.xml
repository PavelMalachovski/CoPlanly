    <!-- Account deletion. Irreversible: the server erases the account and everything it
         holds, and the device is wiped. The second dialog is deliberate, matching unpair. -->
    <string name="settings_account_delete">Konto löschen</string>
    <string name="settings_account_delete_description">Dieses Konto und alle Daten löschen</string>
    <string name="settings_account_delete_confirm_title">Dieses Konto löschen?</string>
    <string name="settings_account_delete_confirm_message">Alles, was du eingetragen hast, wird von unseren Servern und von diesem Telefon gelöscht: deine Termine, Ausgaben und die Angaben zu deinem Kind. Dein Chat bleibt für den anderen Elternteil 30 Tage lang erhalten, damit er ihn exportieren kann, und wird dann gelöscht; er wird darüber informiert. Der andere Elternteil behält, was er selbst erstellt hat, und sein Telefon behält die Kopien, die es bereits geladen hat. Das lässt sich nicht rückgängig machen.</string>
    <string name="settings_account_delete_final_title">Endgültig löschen?</string>
    <string name="settings_account_delete_final_message">Es gibt keinen Weg zurück: Wir bewahren keine Kopie zur Wiederherstellung auf. Wenn du dich nur von diesem Gerät abmelden möchtest, melde dich stattdessen ab.</string>
    <string name="settings_account_delete_final_yes">Endgültig löschen</string>
    <string name="settings_account_delete_cancel">Konto behalten</string>
    <string name="settings_account_delete_progress">Konto wird gelöscht…</string>
