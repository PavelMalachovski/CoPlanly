    <!-- MON-19: the lexical hint over the composer. Plain observations of what was typed, never a verdict. -->
    <string name="chat_nudge_shouting">Großbuchstaben können wie Schreien wirken.</string>
    <string name="chat_nudge_punctuation">Wiederholte !!! oder ??? können wie eine erhobene Stimme wirken.</string>
    <string name="chat_nudge_listed_words">Wörter wie %1$s können härter ankommen, als du es meinst.</string>
    <!-- MON-19: a short, mild list of words that tend to land harder than meant. Matching ignores
         case and accents; an entry ending in * matches every word starting with it, so an
         inflected word is listed once. Keep it short and mild: this is a nudge, not a filter. -->
    <string-array name="chat_nudge_words">
        <item>immer</item>
        <item>nie</item>
        <item>niemals</item>
        <item>lächerlich*</item>
        <item>dumm*</item>
        <item>peinlich*</item>
        <item>unfähig*</item>
        <item>egoistisch*</item>
        <item>verantwortungslos*</item>
        <item>typisch</item>
    </string-array>
    <!-- A thread kept after the co-parent deleted their account (GDPR review, September 2026). %1$s = their name, %2$s = the day the thread is deleted. -->
