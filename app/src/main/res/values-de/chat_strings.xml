    <!-- Message templates (domain/model/MessageTemplate.kt). The body is seeded into the
         composer for the user to edit before sending, so the bracketed hints are translated
         too: they are prompts to the reader, not substitution tokens. -->
    <string name="chat_templates_sheet_title">Nachrichtenvorlagen</string>
    <string name="chat_template_category_handover">Übergaben und Betreuungsplan</string>
    <string name="chat_template_category_health">Gesundheit</string>
    <string name="chat_template_category_school">Schule</string>
    <string name="chat_template_category_holidays">Ferien und Reisen</string>
    <string name="chat_template_category_expenses">Ausgaben</string>
    <string name="chat_template_category_replies">Antworten</string>
    <string name="chat_template_handover_confirm_title">Übergabe bestätigen</string>
    <string name="chat_template_handover_confirm_content">Ich bestätige die Übergabe am [Tag] um [Uhrzeit], Treffpunkt: [Ort]. Sag mir bitte Bescheid, falls sich etwas ändert.</string>
    <string name="chat_template_pickup_delay_title">Verspätung</string>
    <string name="chat_template_pickup_delay_content">Ich komme etwa [Anzahl] Minuten später zur Übergabe und bin spätestens um [Uhrzeit] da. Entschuldige die Wartezeit.</string>
    <string name="chat_template_pickup_early_title">Frühere Übergabe anfragen</string>
    <string name="chat_template_pickup_early_content">Könnten wir die Übergabe am [Tag] auf [Uhrzeit] vorziehen? Falls nicht, bleibt es bei der üblichen Zeit.</string>
    <string name="chat_template_packing_title">Sachen einpacken</string>
    <string name="chat_template_packing_content">Kannst du bitte für [Tag] [Sachen] einpacken? Sie werden für [wofür] gebraucht. Danke.</string>
    <string name="chat_template_schedule_change_title">Tage tauschen</string>
    <string name="chat_template_schedule_change_content">Können wir Tage tauschen? Du übernimmst [Datum], ich dafür [anderes Datum]. Gib mir bitte bis [Datum] Bescheid.</string>
    <string name="chat_template_child_sick_title">Kind ist krank</string>
    <string name="chat_template_child_sick_content">[Kind] hat heute [Symptome], Temperatur: [Temperatur]. Wir bleiben zu Hause, bis [Uhrzeit] melde ich mich wieder.</string>
    <string name="chat_template_doctor_visit_title">Nach dem Arztbesuch</string>
    <string name="chat_template_doctor_visit_content">Ich war heute mit [Kind] beim Arzt. Grund: [Grund]. Befund und Behandlung: [was der Arzt gesagt hat]. Medikamente: [Name, Dosierung, bis wann]. Nächste Kontrolle: [Datum].</string>
    <string name="chat_template_school_event_title">Schulveranstaltung</string>
    <string name="chat_template_school_event_content">Am [Datum] um [Uhrzeit] ist in der Schule [Veranstaltung]. Ich habe vor hinzugehen. Kommst du auch?</string>
    <string name="chat_template_parent_teacher_meeting_title">Elterngespräch</string>
    <string name="chat_template_parent_teacher_meeting_content">Das Elterngespräch ist am [Datum] um [Uhrzeit], die Lehrkraft möchte über [Thema] sprechen. Gehst du hin? Falls nicht, schicke ich dir danach eine Zusammenfassung.</string>
    <string name="chat_template_school_update_title">Neues aus der Schule</string>
    <string name="chat_template_school_update_content">Kurze Info aus der Schule zu [Kind]: [was passiert ist]. Du musst nichts tun, das ist nur zu deiner Information.</string>
    <string name="chat_template_holiday_plan_title">Ferien planen</string>
    <string name="chat_template_holiday_plan_content">Lass uns [Ferien] planen. Mein Vorschlag: [Vorschlag]. Sag mir bitte bis [Datum], ob das für dich passt, oder schlag etwas anderes vor.</string>
    <string name="chat_template_travel_abroad_title">Reise ins Ausland</string>
    <string name="chat_template_travel_abroad_content">Ich plane mit [Kind] eine Reise nach [Land] vom [Datum] bis [Datum]. Unterkunft: [Adresse], erreichbar bin ich unter [Telefonnummer]. Gib mir bitte bis [Datum] Bescheid, ob du einverstanden bist.</string>
    <string name="chat_template_expense_share_title">Anteil an einer Ausgabe</string>
    <string name="chat_template_expense_share_content">Gemeinsame Ausgabe: [wofür], [Datum], insgesamt [Betrag]. Dein Anteil ist [Betrag]. Kannst du ihn mir bis [Datum] überweisen? Den Beleg kann ich dir schicken.</string>
    <string name="chat_template_acknowledge_title">Nachricht erhalten</string>
    <string name="chat_template_acknowledge_content">Danke für deine Nachricht zu [Thema]. Ich antworte dir bis [Tag].</string>
    <string name="chat_template_confirm_agreement_title">Absprache bestätigen</string>
    <string name="chat_template_confirm_agreement_content">Damit wir vom Gleichen ausgehen, hier unsere Absprache: [Absprache]. Falls du es anders verstanden hast, sag mir bitte Bescheid.</string>
    <string name="chat_failed_to_send_retry">Nicht gesendet – zum Wiederholen tippen</string>
    <string name="chat_load_earlier">Ältere Nachrichten laden</string>

