    <!-- Message templates (domain/model/MessageTemplate.kt). The body is seeded into the
         composer for the user to edit before sending, so the bracketed hints are translated
         too: they are prompts to the reader, not substitution tokens. -->
    <string name="chat_templates_sheet_title">Шаблони повідомлень</string>
    <string name="chat_template_category_handover">Передача та графік</string>
    <string name="chat_template_category_health">Здоровʼя</string>
    <string name="chat_template_category_school">Школа</string>
    <string name="chat_template_category_holidays">Канікули та поїздки</string>
    <string name="chat_template_category_expenses">Витрати</string>
    <string name="chat_template_category_replies">Відповіді</string>
    <string name="chat_template_handover_confirm_title">Підтвердити передачу</string>
    <string name="chat_template_handover_confirm_content">Підтверджую передачу: [день] о [час], місце: [місце]. Якщо щось зміниться, напиши, будь ласка.</string>
    <string name="chat_template_pickup_delay_title">Запізнююся</string>
    <string name="chat_template_pickup_delay_content">Запізнююся на передачу приблизно на [скільки] хвилин, буду до [час]. Вибач за очікування.</string>
    <string name="chat_template_pickup_early_title">Передача раніше</string>
    <string name="chat_template_pickup_early_content">Можна [день] зробити передачу раніше, о [час]? Якщо незручно, залишимо звичайний час.</string>
    <string name="chat_template_packing_title">Що зібрати</string>
    <string name="chat_template_packing_content">Можеш, будь ласка, зібрати на [день] [речі]? Вони знадобляться для [чого]. Дякую.</string>
    <string name="chat_template_schedule_change_title">Помінятися днями</string>
    <string name="chat_template_schedule_change_content">Можемо помінятися днями? Ти береш [дата], а я натомість — [інша дата]. Напиши, будь ласка, до [дата].</string>
    <string name="chat_template_child_sick_title">Дитина захворіла</string>
    <string name="chat_template_child_sick_content">У [дитини] сьогодні [симптоми], температура [температура]. Ми залишаємося вдома, до [час] напишу, як справи.</string>
    <string name="chat_template_doctor_visit_title">Після візиту до лікаря</string>
    <string name="chat_template_doctor_visit_content">Сьогодні ми з [дитиною] були в лікаря. Причина: [причина]. Висновок: [діагноз і лікування]. Ліки: [назва, дозування, до якого числа]. Наступний прийом: [дата].</string>
    <string name="chat_template_school_event_title">Шкільний захід</string>
    <string name="chat_template_school_event_content">У школі [дата] о [час] буде [захід]. Я збираюся піти. Ти теж підеш?</string>
    <string name="chat_template_parent_teacher_meeting_title">Батьківські збори</string>
    <string name="chat_template_parent_teacher_meeting_content">Батьківські збори — [дата] о [час], учитель хоче обговорити [тему]. Ти підеш? Якщо ні, потім розповім, про що говорили.</string>
    <string name="chat_template_school_update_title">Новини зі школи</string>
    <string name="chat_template_school_update_content">Новини зі школи про [дитину]: [що сталося]. Від тебе нічого не потрібно, просто тримаю тебе в курсі.</string>
    <string name="chat_template_holiday_plan_title">План на канікули</string>
    <string name="chat_template_holiday_plan_content">Сплануймо [канікули]. Моя пропозиція: [пропозиція]. Напиши, будь ласка, до [дата], чи тобі підходить, або запропонуй свій варіант.</string>
    <string name="chat_template_travel_abroad_title">Поїздка за кордон</string>
    <string name="chat_template_travel_abroad_content">Планую поїздку з [дитиною] до [країни] з [дата] до [дата]. Житимемо за адресою: [адреса], мій телефон: [телефон]. Напиши, будь ласка, до [дата], чи даєш ти згоду.</string>
    <string name="chat_template_expense_share_title">Частка у витратах</string>
    <string name="chat_template_expense_share_content">Спільна витрата: [що] від [дата], усього [сума]. Твоя частка — [сума]. Зможеш переказати до [дата]? Чек можу переслати.</string>
    <string name="chat_template_acknowledge_title">Повідомлення отримано</string>
    <string name="chat_template_acknowledge_content">Дякую за повідомлення про [тему]. Відповім до [день].</string>
    <string name="chat_template_confirm_agreement_title">Підтвердити домовленість</string>
    <string name="chat_template_confirm_agreement_content">Щоб ми однаково розуміли, ось про що ми домовилися: [домовленість]. Якщо ти розумієш це інакше, напиши, будь ласка.</string>
    <string name="chat_failed_to_send_retry">Не надіслано — натисніть, щоб повторити</string>
    <string name="chat_load_earlier">Завантажити давніші повідомлення</string>

