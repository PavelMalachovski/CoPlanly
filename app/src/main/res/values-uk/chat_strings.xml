    <!-- MON-19: the lexical hint over the composer. Plain observations of what was typed, never a verdict. -->
    <string name="chat_nudge_shouting">Великі літери можуть читатися як крик.</string>
    <string name="chat_nudge_punctuation">Повторювані !!! або ??? можуть читатися як підвищений тон.</string>
    <string name="chat_nudge_listed_words">Слова на кшталт %1$s можуть прозвучати різкіше, ніж ви хочете.</string>
    <!-- MON-19: a short, mild list of words that tend to land harder than meant. Matching ignores
         case and accents; an entry ending in * matches every word starting with it, so an
         inflected word is listed once. Keep it short and mild: this is a nudge, not a filter. -->
    <string-array name="chat_nudge_words">
        <item>завжди</item>
        <item>ніколи</item>
        <item>безглузд*</item>
        <item>дурн*</item>
        <item>жалюгідн*</item>
        <item>егоїст*</item>
        <item>безвідповідальн*</item>
        <item>типов*</item>
    </string-array>
    <!-- A thread kept after the co-parent deleted their account (GDPR review, September 2026). %1$s = their name, %2$s = the day the thread is deleted. -->
    <string name="chat_departed_banner">%1$s: акаунт видалено. Цю розмову буде видалено %2$s. Експортуйте її до того часу.</string>
