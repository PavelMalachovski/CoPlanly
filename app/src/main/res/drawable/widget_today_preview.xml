<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows for the "Today" widget: a schematic of its tall layout in the
  light theme — the date, whose day it is in slot 1's default pink, the handover in slot 2's
  default blue, and three events with their owners' marks. A drawable, not a layout: the widget
  itself is Glance, and this app adds no XML layout (CLAUDE.md, hard project rules).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="180dp"
    android:height="180dp"
    android:viewportWidth="180"
    android:viewportHeight="180">
    <!-- The widget's surface, with its 16 dp corners. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M16,0 L164,0 A16,16 0 0 1 180,16 L180,164 A16,16 0 0 1 164,180 L16,180 A16,16 0 0 1 0,164 L0,16 A16,16 0 0 1 16,0 Z" />
    <!-- Today · date -->
    <path
        android:fillColor="#FF47464F"
        android:pathData="M12,14 L84,14 L84,22 L12,22 Z" />
    <!-- Whose day it is -->
    <path
        android:fillColor="#FFC2185B"
        android:pathData="M12,30 L132,30 L132,42 L12,42 Z" />
    <!-- The next handover -->
    <path
        android:fillColor="#FF0D47A1"
        android:pathData="M12,50 L120,50 L120,59 L12,59 Z" />
    <!-- Three events: the owner's mark, the time, the title -->
    <path
        android:fillColor="#FFE91E63"
        android:pathData="M12,76 L15,76 L15,92 L12,92 Z" />
    <path
        android:fillColor="#FF1976D2"
        android:pathData="M12,100 L15,100 L15,116 L12,116 Z" />
    <path
        android:fillColor="#FFE91E63"
        android:pathData="M12,124 L15,124 L15,140 L12,140 Z" />
    <path
        android:fillColor="#FF777680"
        android:pathData="M23,80 L53,80 L53,88 L23,88 Z M23,104 L53,104 L53,112 L23,112 Z M23,128 L53,128 L53,136 L23,136 Z" />
    <path
        android:fillColor="#FF1B1B21"
        android:pathData="M61,80 L150,80 L150,88 L61,88 Z M61,104 L138,104 L138,112 L61,112 Z M61,128 L160,128 L160,136 L61,136 Z" />
    <!-- +N more -->
    <path
        android:fillColor="#FF777680"
        android:pathData="M12,152 L56,152 L56,159 L12,159 Z" />
</vector>
