<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-icon background: the one brand colour (UX-14), the same value the system splash
     draws, so the icon and the startup screen are one colour. It used to be a
     #6750A4 -> #4F46E5 gradient, and the first stop was not the app's colour at all. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0 H108 V108 H0 Z" />
</vector>
