<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      Voice dictation in the chat composer, and nothing else. Asked for on the first tap of the
      composer's microphone, never on start. The audio goes to the phone's on-device speech
      recognizer only (OnDeviceSpeechDictation) and is not recorded, stored or sent.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      firebase-analytics declares the advertising-id permission on the app's behalf. This app
      shows no ads and its Data Safety form says it collects no advertising id; the merged
      manifest must agree with that, or the declaration is a policy violation rather than a
      typo. Removed here, and adid collection is switched off below for good measure.
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Camera is used for QR pairing only; keep it optional so devices without a
         camera (e.g. some ChromeOS/tablets) can still install the app. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Dictation is optional too: a device without a microphone installs and simply has no
         dictation (the button appears only where on-device recognition is available). -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".CoPlanlyApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CoPlanly.Starting"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="33">
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CoPlanly.Starting"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Pairing deep link. A custom scheme, not an App Link: the project
                 owns no domain, so https links could never be verified. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coplanly" android:host="pair" />
            </intent-filter>

            <!-- Guest-access deep link. A separate host from `pair`, not a query
                 parameter on it: the two invitation kinds are redeemed by two
                 different callables, and the link is what tells the app which
                 one it is holding before it asks the server anything. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coplanly" android:host="guest" />
            </intent-filter>

            <!-- Chat deep link, opened by a chat-message push notification
                 (see CoPlanlyMessagingService). Same shape as the pairing link
                 above: a separate filter rather than a second <data> tag on it,
                 since combining <data> tags within one filter would cross their
                 attributes into every scheme/host pairing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="coplanly" android:host="chat" />
            </intent-filter>
        </activity>

        <!--
          QR Scanner Activity.

          Not exported: it has no intent-filter and is only ever started explicitly from
          within the app. While it was exported, any installed app could launch it and
          collect the scanned invite code from setResult() — an invite code is a bearer
          credential for the whole family's calendar, chat and finances.

          No orientation lock (release audit, week 8): Android 16 ignores one on a large screen,
          so the scanner has to work sideways anyway, and a lock that held only on phones would
          leave that path untried everywhere it is easy to try.
        -->
        <activity
            android:name=".presentation.pairing.QRScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.CoPlanly" />

        <!--
          Persists the per-app language chosen via AppCompatDelegate.setApplicationLocales
          across process restarts (and syncs it to the system per-app language setting on
          Android 13+). The service is never started; AppCompat only reads its meta-data.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          The "Today" home-screen widget (presentation/widget/TodayWidget.kt). Exported because the
          launcher's AppWidgetService delivers APPWIDGET_UPDATE to it; home screen only, see
          res/xml/today_widget_info.xml.
        -->
        <receiver
            android:name=".presentation.widget.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".data.remote.firebase.CoPlanlyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          WorkManager is initialized on-demand via Hilt (CoPlanlyApplication implements
          Configuration.Provider). Remove the default WorkManagerInitializer that the
          work-runtime library merges in, so it does not conflict with the custom
          configuration. Required by the RemoveWorkManagerInitializer lint check.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Shares camera output files with the camera app when photographing a receipt -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Default notification channel for FCM. Every push is data-only and worded by
             PushNotifier, which picks its own channel (PushRouting.channelOf), so this is only
             the fallback for a notification message FCM would display itself. It names the
             Family channel because the one channel this used to name, coparently_notifications,
             is deleted when the four channels are created (docs/AUDIT-2026-10-design.md D-13). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="coplanly_family" />

        <!--
          Default small icon FCM uses when it auto-displays a push from the
          system tray (app backgrounded/killed) instead of going through
          CoPlanlyMessagingService.onMessageReceived. Without this, that path
          falls back to a framework default rather than our monochrome icon.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!--
          REL-5. Both SDKs auto-initialise before any of our code runs, so the consent gate has
          to start here rather than in Kotlin: without these two entries a release build collects
          in the window between process start and TelemetryConsentApplier.start(), which is
          exactly the "collects by default" the gate exists to end.

          `..._collection_enabled=false` is the resumable knob — setAnalyticsCollectionEnabled /
          setCrashlyticsCollectionEnabled can turn it back on once the user agrees.
          `..._collection_deactivated` below is a DIFFERENT knob and must stay false: setting it
          true disables Analytics permanently and no runtime call can re-enable it, so a granted
          consent would silently do nothing.
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Enable automatic initialization of Firebase Messaging -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="true" />
    </application>

</manifest>

