rules_version = '2';

// Cloud Storage rules for CoPlanly.
//
// **Every block in this file decides who reads a file from its path alone.** The first segment
// under each prefix names who the file belongs to: a family id — `FamilyKey.of(uidA, uidB)`, the
// two parents' uids sorted and joined with `__` — or, for a record photograph taken before its
// uploader had a family, `solo_{uid}`. So "is the caller one of this family's parents" is a
// question about the path, answered with no document read, exactly as `firestore.rules`'
// `isFamilyMember` answers it. That is the approach chosen over a custom claim or a cross-service
// `firestore.get()` because it is the one the Storage emulator can execute:
// `firestore-tests/rules/storage-*.test.js` runs every branch for real. (Cross-service rules exist,
// but the emulator does not resolve them — firebase-js-sdk#6803, firebase-tools#5251 — and this
// project has already shipped one broken delete rule by testing a rule any other way.)
//
// **What it costs, stated so nobody mistakes it for more.** A path names its pair for ever, so the
// gate does not move at unpair: an ex-partner who kept a path can still fetch that file. The
// Firestore records narrow at unpair (`SHARED_AUDIENCE_COLLECTIONS`), so the app stops *showing*
// it, but the bytes stay readable to both uids — the same posture as the chat history, which the
// ex-partner also keeps. The stronger rule is a live-partner check through `firestore.exists()`;
// it cannot be tested here, and this file records why an untested rule is not deployed.
//
// **Nobody else reads anything.** A guest, a calendar friend or a professional is never one of a
// family's two uids, so none of them can fetch a photograph or a file — an owner decision for
// record photos (L-4), and the app draws those records without their photos for them.
//
// **No download URL is ever minted by the app.** A token URL bypasses these rules for whoever
// holds it, for as long as the object exists; every reader downloads through the SDK as themselves.
//
// Common to every create: the caller stamps `uploader` (themselves) and `sha256` in custom metadata,
// the type and size are bounded, and nothing may be overwritten (`resource == null`) — the digest a
// record carries has to keep describing the bytes at its path. Nothing may be listed (`list` is
// never granted; the Firestore documents are the index).
service firebase.storage {
  match /b/{bucket}/o {
    function isOneOfPair(pairId) {
      return request.auth != null &&
             pairId.split('__').size() == 2 &&
             request.auth.uid in pairId.split('__');
    }

    // ---- L-4: record photographs ------------------------------------------------------------
    //
    // A child's medical photos, a pet's photos, an expense's receipt and an event's photo, at
    // `{prefix}/{owner}/{recordId}/{objectName}` — `{objectName}` a fresh random name per upload,
    // so replacing a photo is a new object plus a delete of the old one. `{owner}` is the record's
    // family, or `solo_{uid}` while the uploader has no co-parent: then only the uploader may read,
    // create or delete it, and when the pair forms `onFamilyCreated` (functions/index.js,
    // `movePhotosToFamily`) copies it, as admin, into the family's folder and deletes it here.
    //
    // Both parents of a family may delete its photos — the app lets either parent edit a child's or
    // a pet's record — and nobody else may. The flat layouts from before L-4 (`receipts/{id}.jpg`,
    // `medical_photos/{childId}/{photoId}.jpg`, …) match no block and are closed to every client;
    // `purgeLegacyPhotoPaths` removes what is left of them.
    //
    // Images only, under 10 MB — `RecordPhotoPolicy` in the app says the same and
    // `RecordPhotoTest` pins it. The app re-encodes every photo to a JPEG of at most 1600 px.
    function isRecordPhotoOwner(owner) {
      return isOneOfPair(owner) ||
             (request.auth != null && owner == 'solo_' + request.auth.uid);
    }

    function isAcceptableRecordPhoto() {
      return resource == null &&
             request.resource.size > 0 &&
             request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType in ['image/jpeg', 'image/png', 'image/heic',
                                              'image/heif', 'image/webp'] &&
             request.resource.metadata.uploader == request.auth.uid &&
             request.resource.metadata.sha256.matches('^[0-9a-f]{64}$');
    }

    match /medical_photos/{owner}/{recordId}/{objectName} {
      allow get: if isRecordPhotoOwner(owner);
      allow create: if isRecordPhotoOwner(owner) && isAcceptableRecordPhoto();
      allow delete: if isRecordPhotoOwner(owner);
    }

    match /pet_photos/{owner}/{recordId}/{objectName} {
      allow get: if isRecordPhotoOwner(owner);
      allow create: if isRecordPhotoOwner(owner) && isAcceptableRecordPhoto();
      allow delete: if isRecordPhotoOwner(owner);
    }

    match /receipts/{owner}/{recordId}/{objectName} {
      allow get: if isRecordPhotoOwner(owner);
      allow create: if isRecordPhotoOwner(owner) && isAcceptableRecordPhoto();
      allow delete: if isRecordPhotoOwner(owner);
    }

    match /event_images/{owner}/{recordId}/{objectName} {
      allow get: if isRecordPhotoOwner(owner);
      allow create: if isRecordPhotoOwner(owner) && isAcceptableRecordPhoto();
      allow delete: if isRecordPhotoOwner(owner);
    }

    // ---- MON-23: the document vault and chat attachments -----------------------------------
    //
    // Both are family paths only — a vault document and a chat thread need a family to exist.
    // PDF or one of five image types, under 20 MB (`SharedFilePolicy`).
    //
    // `resource == null` is stated rather than left to the `create`/`update` split: the Storage
    // emulator evaluated an overwrite of an existing object as a `create`, and a rule that
    // relies on the split alone let the uploader replace the bytes a stored digest describes.
    function isAcceptableSharedFile() {
      return resource == null &&
             request.resource.size > 0 &&
             request.resource.size < 20 * 1024 * 1024 &&
             request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png',
                                              'image/heic', 'image/heif', 'image/webp'] &&
             request.resource.metadata.uploader == request.auth.uid &&
             request.resource.metadata.sha256.matches('^[0-9a-f]{64}$');
    }

    // The vault: family_documents/{familyId}/{docId}/{fileName}. The uploader may delete their
    // own file (a failed index write leaves an orphan the client cleans up); the co-parent may
    // not. After a tombstone the file stays until `sweepDeletedDocuments` removes both.
    match /family_documents/{familyId}/{docId}/{fileName} {
      allow get: if isOneOfPair(familyId);
      allow create: if isOneOfPair(familyId) && isAcceptableSharedFile();
      allow delete: if isOneOfPair(familyId) &&
                      resource.metadata.uploader == request.auth.uid;
    }

    // Chat: chat_attachments/{conversationId}/{messageId}/{fileName}. No delete for anybody: a
    // message cannot be deleted or edited (`firestore.rules`), and the file is part of it. Only
    // account deletion removes these, as admin, with the rest of the thread.
    match /chat_attachments/{conversationId}/{messageId}/{fileName} {
      allow get: if isOneOfPair(conversationId);
      allow create: if isOneOfPair(conversationId) && isAcceptableSharedFile();
    }

    // Everything else is closed by default — including every flat photo path from before L-4.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
