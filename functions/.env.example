# Copy this file to `.env` (never commit `.env` itself — see .gitignore) and fill in real
# values. The Firebase CLI loads `.env` into `process.env` for every deployed function, 1st
# and 2nd gen alike, with no `runWith` binding required — see the "Admin operations" section
# of README.md for why this project uses a plain `.env` var here rather than a Secret Manager
# secret.

# Comma-separated Firebase Auth UIDs allowed to invoke the operator callables
# (`backfillParentSlots`, `backfillFamilyDocuments`, `backfillRecordFamilyIds`,
# `purgeLegacyPhotoPaths`, `purgeParentHealthFields`).
# Whitespace around each uid is trimmed; empty entries (e.g. a trailing comma) are ignored.
# Leave unset (or empty) to keep the callables refusing every caller, which is the safe
# default — see backfillAdminUids() in index.js.
BACKFILL_ADMIN_UIDS=

# The Google OAuth web client the server-side token exchange speaks for (SEC-1): its client id.
# Both this and the secret below must be set, or Google Calendar sign-in is refused.
GOOGLE_OAUTH_CLIENT_ID=

# That client's secret. It lives here only, never in the APK.
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: the base URL calendar-feed links point at (a Hosting rewrite or custom domain),
# without a trailing slash. Unset, links use the `calendarFeed` function's own default URL.
CALENDAR_FEED_BASE_URL=
