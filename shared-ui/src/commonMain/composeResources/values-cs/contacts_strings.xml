<?xml version="1.0" encoding="utf-8"?>
<!-- Obrazovka kontaktů: čísla, která je třeba najít ve spěchu. -->
<resources>
    <string name="contacts_title">Kontakty</string>
    <string name="contacts_back">Zpět</string>

    <!-- Trailing action on a contact row. Opens the dialler pre-filled; it never places the
         call itself, so no permission is asked for. -->
    <string name="contacts_call">Zavolat</string>

    <string name="contacts_empty">Zatím žádné kontakty.</string>
    <string name="contacts_empty_hint">Přidejte k údajům dítěte prarodiče, lékaře nebo rodiče kamarádů a budete jim moci zavolat jedním klepnutím.</string>

    <!-- Shown when there is no dialler to open — rare, but a silent no-op looks like a broken
         button. -->
    <string name="contacts_no_dialer">Toto zařízení neumí volat.</string>
    <string name="contacts_vet">Veterinář</string>

    <!-- Empty-state action: opens the children, where a contact is added. -->
    <string name="contacts_empty_action">Přidat kontakt</string>
</resources>
