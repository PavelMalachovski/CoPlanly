<?xml version="1.0" encoding="utf-8"?>
<!-- Home dashboard strings. -->
<resources>

    <!-- Pairing call-to-action, shown while the account is not yet paired. -->
    <string name="home_pairing_title">Share this with your co-parent</string>
    <string name="home_pairing_prompt">Once your co-parent joins, you both see the same days, agree changes before they happen and split costs in one place.</string>
    <string name="home_pairing_cta">Pair with your co-parent</string>

    <!-- Custody handover hero. %1$s = parent taking over, %2$d = whole days until then. -->
    <string name="home_handover_current">Today with %1$s</string>
    <string name="home_handover_current_you">Today with you</string>
    <string name="home_handover_hero_today">Handover to %1$s today</string>
    <string name="home_handover_hero_tomorrow">Handover to %1$s tomorrow</string>
    <plurals name="home_handover_hero_in_days">
        <item quantity="one">Handover to %1$s in %2$d day</item>
        <item quantity="other">Handover to %1$s in %2$d days</item>
    </plurals>
    <!-- The same headline when the handover is to the reader (owner request, 28 October 2026). -->
    <string name="home_handover_hero_today_you">Handover to you today</string>
    <string name="home_handover_hero_tomorrow_you">Handover to you tomorrow</string>
    <plurals name="home_handover_hero_in_days_you">
        <item quantity="one">Handover to you in %1$d day</item>
        <item quantity="other">Handover to you in %1$d days</item>
    </plurals>

    <!-- Stat tiles. Both are deep links, so each carries an action caption. -->
    <plurals name="home_stat_unread_count">
        <item quantity="one">%1$d unread</item>
        <item quantity="other">%1$d unread</item>
    </plurals>
    <string name="home_stat_open_chat">Open chat →</string>
    <!-- %1$s = amount, already formatted with its currency symbol. -->
    <string name="home_stat_owed_to_you">You are owed %1$s\u00A0→</string>
    <string name="home_stat_you_owe">You owe %1$s\u00A0→</string>
    <string name="home_stat_settled">All settled →</string>

    <!-- Section headers. %1$s = the co-parent's name. -->
    <string name="home_section_this_week">This week</string>

    <!-- Timeline row. %1$s = day and time, %2$s = the parent whose day it is. -->
    <string name="home_timeline_meta">%1$s · %2$s\u0027s day</string>
    <string name="home_timeline_meta_you">%1$s · your day</string>

    <!-- Contacts: item 16's one button, between the changes feed and the spend tile. -->
    <string name="home_contacts">Contacts</string>
    <string name="home_contacts_supporting">Grandparents, doctors, a friend\u0027s parents</string>

    <!-- Activity feed. %1$s = event title; the section header already names who made the
         change, so the row states the action rather than repeating "Co-parent". -->
    <string name="home_activity_event_created">Added %1$s</string>
    <string name="home_activity_event_updated">Updated %1$s</string>
    <string name="home_activity_pickup_confirmed">Confirmed pickup for %1$s</string>
    <string name="home_activity_change_requested">Asked to change %1$s</string>
    <string name="home_activity_review">Review</string>

    <!-- Parent identity labels. -->
    <string name="home_dialog_swap_title">Day swap</string>
    <string name="home_dialog_requests_title">Requests</string>
    <string name="home_dialog_requests_message">Your co-parent has requests waiting for your answer.</string>
    <string name="home_dialog_requests_message_named">%1$s is waiting for your answer on some requests.</string>
    <string name="home_dialog_later">Later</string>
    <string name="home_dialog_review">Review</string>

    <!-- Home's Open requests card (phase 2; redesign, November 2026). -->
    <plurals name="home_requests_waiting_on_you">
        <item quantity="one">%1$d waiting for your answer</item>
        <item quantity="other">%1$d waiting for your answer</item>
    </plurals>
    <plurals name="home_requests_waiting_on_them">
        <item quantity="one">%1$d waiting for %2$s</item>
        <item quantity="other">%1$d waiting for %2$s</item>
    </plurals>
    <!-- The co-parent's answers to this parent's requests, in the feed headed by their name. -->
    <string name="home_activity_accepted_new_time">Accepted your new time for %1$s</string>
    <string name="home_activity_declined_new_time">Declined your new time for %1$s</string>
    <string name="home_activity_accepted_swap">Accepted your day swap: %1$s</string>
    <string name="home_activity_declined_swap">Declined your day swap: %1$s</string>
    <string name="home_activity_accepted_event">Accepted %1$s</string>
    <string name="home_activity_declined_event">Declined %1$s</string>
    <!-- Home, variant A (redesign, November 2026): the Updates card, the open requests, the
         handover card and the money tile. %1$s = the co-parent; %1$d = whole days. -->
    <string name="home_updates_title">Updates</string>
    <string name="home_updates_empty">Nothing new from %1$s</string>
    <string name="home_updates_see_all">See all</string>
    <string name="home_open_requests_title">Open requests</string>
    <string name="home_waiting_for_you">Waiting for you</string>
    <string name="home_waiting_for_coparent">Waiting for %1$s</string>
    <plurals name="home_handover_in_days">
        <item quantity="one">Handover in %1$d day</item>
        <item quantity="other">Handover in %1$d days</item>
    </plurals>
    <string name="home_handover_today">Handover today</string>
    <string name="home_expenses_tile">Expenses this month</string>
    <!-- Under the handover card's headline: whom the days go to. -->
    <string name="home_handover_goes_to_you">Goes to you</string>
    <string name="home_handover_goes_to">Goes to %1$s</string>
    <!-- A week tile's spoken description on a day with events. %1$s = the day and whose it is. -->
    <string name="home_week_tile_with_events">%1$s, has events</string>
</resources>
