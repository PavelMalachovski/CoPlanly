rules_version = '2';

// Production Firestore rules for CoPlanly.
//
// These rules are aligned with the ACTUAL document schema the app writes
// (EventRepositoryImpl.toFirestoreMap / SyncService): date fields are ISO
// *strings*, not Firestore timestamps, and documents carry the full field set
// (~18 keys for events), not a fixed minimal subset. Earlier versions of this
// file validated `is timestamp` and an exact key set, which rejected every
// real write — that is why the permissive `firestore.rules.simple` had to be
// deployed instead. Keep these in sync with `toFirestoreMap()`.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A `users` document does not necessarily carry a `partnerId` key: FcmService writes
    // `users/{uid}` with `set({fcmToken}, merge)`, which creates the document on accounts
    // whose profile write never landed. Reading a missing key is an *evaluation error* in
    // Rules, not null, and `exists()` only guards the missing-document case — so the read
    // goes through `data.get('partnerId', '')`, which yields a value for every shape.
    // Verified in firestore-tests/rules/is-partner-of.test.js.
    // `userId != request.auth.uid` is the second half of closing the self-pairing hole, and it
    // is here as well as on the `users` write rule on purpose: this helper is what every other
    // collection's partner branch resolves to, so it has to be false for "myself" even if a
    // document written before that rule existed still carries `partnerId == own uid`. Nobody is
    // ever their own co-parent, so nothing legitimate is lost.
    // A person may co-parent with more than one other adult, so the stored answer is
    // `partnerIds`, an array (docs/DESIGN-multi-family.md, M-4). Both shapes are read: the
    // singular `partnerId` is still written for a co-parent on an older build, and a document
    // mid-migration may carry a value the array has not caught up with. M-5 drops the fallback.
    //
    // **An array does not widen what this admits, and that is the finding that made it safe.**
    // Every rule still resolving to this helper asks a *pairwise* question — may this person
    // read that profile, may they address a change request to that uid — and both of somebody's
    // co-parents may legitimately answer yes. The one place `isPartnerOf` was standing in for
    // "in the same family" was `expenses` and `budgets`, which have moved to `isFamilyMember`;
    // an array here without that move would have shown each co-parent the other's money.
    function isPartnerOf(userId) {
      return isAuthenticated() &&
             userId != request.auth.uid &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             (request.auth.uid in get(/databases/$(database)/documents/users/$(userId))
                .data.get('partnerIds', []) ||
              get(/databases/$(database)/documents/users/$(userId))
                .data.get('partnerId', '') == request.auth.uid);
    }

    // True when [familyId] names a co-parenting relationship the caller is one of the two
    // adults in.
    //
    // **No document read.** The id is `FamilyKey.of(uidA, uidB)` — the two uids sorted and
    // joined — so membership is the id itself, the same reasoning `custody_models`' `allow get`
    // already applies to `modelId`. That keeps this cheap enough to sit on a per-document read
    // rule, and it works for a pair whose `families/{id}` has not been written yet.
    //
    // It grants nothing a caller did not already have. A record's `familyId` is written by
    // whoever writes the record, and the create rules require `createdByFirebaseUid` to be the
    // caller — so a person can only put their own uid into a family id on a document that is
    // already theirs. Naming a family they are not in makes the record readable by those two
    // and not by them, which is sharing, not escalation.
    //
    // The empty string is "no family", which is what an unpaired parent's records carry and
    // what every document written before the field existed reads as. It matches nobody: an
    // empty id splits to a single empty part, and no uid is blank.
    //
    // **Exactly two parts.** `FamilyKey.of` always joins two uids, and an id with a third part
    // would otherwise make its writer a "member" of a family that also names two other people —
    // a parenting plan or a friend invitation filed under `carol__igor__zuzana` is one both
    // strangers could later be pointed at.
    function isFamilyMember(familyId) {
      return isAuthenticated() &&
             familyId is string &&
             familyId.size() > 0 &&
             familyId.split('__').size() == 2 &&
             request.auth.uid in familyId.split('__');
    }

    // True when [familyId] names a family the caller is in **and that family still exists**.
    //
    // `isFamilyMember` alone reads the id and nothing else, so it stays true after the
    // relationship ends: an ex-partner kept reading — and, on `budgets`, editing — every expense
    // and budget of the household they left, because those records carry no per-document audience
    // for unpair to narrow. `unpairCoParent` deletes `families/{id}` in the same transaction that
    // clears the pairing (and account deletion runs unpair first), so the document's existence is
    // the relationship's liveness. The id check runs first, so a blank or foreign id never builds
    // a path and never costs a read.
    //
    // The cost: a pair must have a `families/{id}` document. Pairing has written one since M-1,
    // and `backfillFamilyDocuments` creates it for a pair formed before that — which is why that
    // callable must have run before these rules are deployed (functions/README.md).
    //
    // List queries still validate: the app's own queries constrain `familyId` by equality
    // (`FirestoreExpenseDataSource`, `FirestoreBudgetDataSource`), which is what lets the rules
    // engine evaluate this `exists()` once for the whole query.
    function isLiveFamilyMember(familyId) {
      return isFamilyMember(familyId) &&
             exists(/databases/$(database)/documents/families/$(familyId));
    }

    // The family a caller may stamp on a record they write: one they are in, or none.
    //
    // `isFamilyMember` used to be the whole of the story — "a person can only put their own
    // uid into a family id" — and that was true of *reading*, not of *writing*. Nothing bound
    // the `familyId` a creator stamped, so any signed-in account could write an expense or a
    // budget carrying `alice__bob` and have it served to both of them: the create rules only
    // ever required `createdByFirebaseUid` to be the caller. The blank string stays legal —
    // it is what an unpaired parent's records carry, and what a device whose backfill has not
    // run writes over a stamped document (docs/DESIGN-multi-family.md, M-2).
    function familyIsMineOrBlank(familyId) {
      return familyId == '' || isFamilyMember(familyId);
    }

    // The uids a caller may put in a per-document audience: themselves and their live
    // co-parents, read off their own profile, as a Set. A caller with no profile document yet
    // — the first upload can race `ensureProfile` — is a family of one, not an error: an
    // erroring rule denies, and here it would deny a parent narrowing their own record's
    // audience to themselves.
    //
    // The blank `partnerId` an unpaired profile carries is harmless in the set: no uid is blank,
    // so nothing in an audience ever matches it.
    function myAudience() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? profileAudience(
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          : [request.auth.uid].toSet();
    }

    function profileAudience(me) {
      return me.get('partnerIds', []).toSet()
        .union([request.auth.uid, me.get('partnerId', '')].toSet());
    }

    // True when every uid in [audience] (a List) is the caller or one of their co-parents.
    //
    // This is what stops a stranger writing a document *into* somebody's calendar: `events`,
    // `child_info` and `pets` are read purely by membership of `sharedWith`, and their create
    // rules bound only the creator field — so any account could write a document listing a
    // victim in its audience, have both parents' sync pull it into Room, and leave them unable
    // to delete it (delete is creator-only). Spelled as "nothing is left once the family is
    // taken out" with Set arithmetic, which is the one vocabulary the rules language is
    // unambiguous about.
    function isMyAudience(audience) {
      return audience.toSet().difference(myAudience()).size() == 0;
    }

    // True when every uid an update *adds* to `sharedWith` is the caller or a co-parent.
    //
    // The bound on a creator's update is on the additions, not on the whole list, on purpose.
    // A uid already in the audience got there through `create` (bounded above), through the
    // server, or before this rule existed — and a creator editing the title of a record whose
    // audience still names a swept ex-partner must not be locked out of their own record
    // until some other write happens to tidy the list. What a creator may never do is hand
    // the record to somebody new who is not family.
    function onlyFamilyAdded(before, after) {
      return after.get('sharedWith', []).toSet()
        .difference(before.get('sharedWith', []).toSet())
        .difference(myAudience())
        .size() == 0;
    }

    // The four maps a parenting plan document is made of, and nothing else (MON-5).
    //
    // Listed rather than left open so that a future field has to be added here on purpose: an
    // unlisted key would be a place one parent could write something the per-key checks below
    // never look at.
    function planFieldsOnly(after) {
      return after.keys().hasOnly(
               ['answers', 'agreedTo', 'catalogueVersions', 'updatedAt']);
    }

    // On a create: every map carries this parent's key and no other.
    //
    // `.get(field, {})` throughout, because a half-written plan legitimately omits a map — a
    // parent who has answered nothing but ticked nothing writes no `agreedTo` — and reading a
    // missing key in Rules is an evaluation error, which denies.
    function planHalfIsMine(after) {
      return after.get('answers', {}).keys().hasOnly([request.auth.uid]) &&
             after.get('agreedTo', {}).keys().hasOnly([request.auth.uid]) &&
             after.get('catalogueVersions', {}).keys().hasOnly([request.auth.uid]) &&
             after.get('updatedAt', {}).keys().hasOnly([request.auth.uid]);
    }

    // On an update: each map's diff touches this parent's key and no other.
    //
    // The diff rather than the keys, because the co-parent's half is already in the document and
    // demanding `hasOnly([uid])` on the whole map would deny every write made after the other
    // parent has written anything at all. Both sides go through `.get(field, {})` for the reason
    // above — and it also means a write that removes a map outright diffs as both parents'
    // entries changing, and is refused rather than erroring.
    function planDiffIsMine(after, before) {
      return after.get('answers', {}).diff(before.get('answers', {}))
               .affectedKeys().hasOnly([request.auth.uid]) &&
             after.get('agreedTo', {}).diff(before.get('agreedTo', {}))
               .affectedKeys().hasOnly([request.auth.uid]) &&
             after.get('catalogueVersions', {}).diff(before.get('catalogueVersions', {}))
               .affectedKeys().hasOnly([request.auth.uid]) &&
             after.get('updatedAt', {}).diff(before.get('updatedAt', {}))
               .affectedKeys().hasOnly([request.auth.uid]);
    }

    // Validate string field length (inclusive bounds).
    function isValidLength(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // True when the caller is a *live* calendar friend of the family the record at [familyId]
    // belongs to, and [ownerUid] is one of that family's two parents — a trusted third person
    // (item 16) let in to read the calendar, never a parent.
    //
    // The grant lives centrally at `calendar_friends/{familyId}__{friendUid}` rather than being
    // fanned out into every event's `sharedWith`, so admitting or removing a friend never rewrites
    // an event document. This helper is only ever reached on the *last* disjunct of the events
    // read rule, after the creator and shared-partner checks have already failed — so a parent
    // reading their own events never triggers the `get()` (Firestore short-circuits `||`). The
    // two `get()`s resolve to one billed read (Firestore caches identical gets within a request).
    //
    // **One grant per family, keyed like a professional grant (L-5).** The id is built from the
    // record's own `familyId` and the caller's uid, so a grandmother admitted by two families
    // holds two documents and reads both calendars; the grant used to live at
    // `calendar_friends/{friendUid}`, one per person, and a second family's invitation silently
    // overwrote the first. The id alone is not trusted: the stored `familyId` and `friendUid`
    // must repeat it.
    //
    // **[familyId] is the M-6 fix, and it is the whole point of the helper.** The grant used to
    // be checked against the event's *creator* alone: `ownerUid in familyParents`. Once a person
    // can co-parent with two other adults (M-4), that question has the wrong shape — a
    // grandmother admitted by Alice-and-Bob names Alice among her two parents, so every event
    // **Alice** created passed, including the ones belonging to Alice's family with Carol, whom
    // the grandmother has never met. The grant carries the `familyId` it was issued for and the
    // record must name the same one — and since L-5 the record's family also picks which grant
    // is read at all.
    //
    // Both checks stay, and the second is not redundant: an event's `familyId` is written by the
    // client and is not pinned by the create rule (see docs/DESIGN-multi-family.md, M-2), so
    // without `ownerUid in familyParents` any account could stamp a foreign family's id onto
    // their own event and have it appear in that family's friend view.
    //
    // A record with no `familyId` — everything written before M-2, until
    // `backfillRecordFamilyIds` has run — is simply not visible to a friend. That direction is
    // safe: this disjunct only ever *widens* access, so narrowing it can deny a friend but can
    // never deny the app its own writes.
    //
    // **No fallback to the per-person grant.** A `calendar_friends/{friendUid}` document from
    // before L-5 admits nothing here. Reading it too would be the same M-6 check (it carries its
    // `familyId`), but it would keep a second shape alive in the rule, in the friend's own query
    // and in every writer, for pre-release data only; instead `backfillRecordFamilyIds` re-keys
    // every legacy grant (`backfillCalendarFriendFamilyIds`) and the callable re-keys the
    // redeemer's own on their next redemption. Run the backfill right after deploying this rule.
    //
    // `exists()` guards the missing-grant case the way `isPartnerOf` does — a bare `get()` on a
    // document that is not there is an evaluation error, not null. Expiry is enforced here against
    // `request.time`, so access ends the instant the grant lapses, with no sweep in the path.
    function isCalendarFriendOf(ownerUid, familyId) {
      return isAuthenticated() &&
             familyId is string &&
             familyId.size() > 0 &&
             exists(/databases/$(database)/documents/calendar_friends/$(familyId + '__' + request.auth.uid)) &&
             calendarFriendGrantAdmits(
               get(/databases/$(database)/documents/calendar_friends/$(familyId + '__' + request.auth.uid)).data,
               ownerUid, familyId);
    }

    // The stored half of [isCalendarFriendOf]: the grant names this family and this caller, the
    // record's creator is one of the family's two parents, and it has not run out.
    function calendarFriendGrantAdmits(grant, ownerUid, familyId) {
      return grant.get('familyId', '') == familyId &&
             grant.get('friendUid', '') == request.auth.uid &&
             ownerUid in grant.get('familyParents', []) &&
             request.time.toMillis() < grant.get('expiresAtMillis', 0);
    }

    // True when the caller holds an **active** professional grant (MON-18) over [familyId]: a
    // mediator, lawyer, guardian ad litem or therapist admitted to read this one family's
    // calendar, parenting plan and custody schedule — never its chat, money or child records.
    //
    // Keyed `professional_grants/{familyId}__{callerUid}`, so the rule builds the path from what
    // it already holds and reads one document. The id alone is not trusted: the stored
    // `familyId` and `proUid` must repeat it.
    //
    // **Active means both parents said yes.** `consents` is a map keyed by parent uid, each
    // parent adds only their own key (the update rule below), and the grant opens nothing until
    // it holds *both* of `familyParents`. The asymmetry with revocation is the point: letting a
    // professional in needs two people, ending it needs one — either parent deletes the grant.
    //
    // **Always expiring**: a missing or past `expiresAtMillis` reads as 0 and admits nothing,
    // compared against `request.time` so access ends the instant the grant lapses, with no sweep
    // in the path. Like `isCalendarFriendOf`, this is only ever reached on a *last* disjunct, so
    // a parent's own read never pays for the `get()`.
    function isProfessionalOf(familyId) {
      return isAuthenticated() &&
             familyId is string &&
             familyId.size() > 0 &&
             exists(/databases/$(database)/documents/professional_grants/$(familyId + '__' + request.auth.uid)) &&
             professionalGrantActive(
               get(/databases/$(database)/documents/professional_grants/$(familyId + '__' + request.auth.uid)).data,
               familyId);
    }

    // The stored half of [isProfessionalOf]: the grant names this family and this caller, has
    // exactly two parents, both of whom have consented, and has not run out.
    function professionalGrantActive(grant, familyId) {
      return grant.get('familyId', '') == familyId &&
             grant.get('proUid', '') == request.auth.uid &&
             grant.get('familyParents', []).size() == 2 &&
             grant.get('consents', {}).keys().hasAll(grant.get('familyParents', [])) &&
             request.time.toMillis() < grant.get('expiresAtMillis', 0);
    }

    // [isProfessionalOf] for a record: the record names the family, and its creator is one of
    // that family's two parents. The second check is the one `isCalendarFriendOf` keeps for the
    // same reason — an event's `familyId` is client-written, so without it any account could put
    // a family's id on its own event and have it appear in the professional's view.
    function isProfessionalOfRecord(ownerUid, familyId) {
      return isProfessionalOf(familyId) &&
             ownerUid in get(/databases/$(database)/documents/professional_grants/$(familyId + '__' + request.auth.uid))
                          .data.get('familyParents', []);
    }

    // True when the map at `key` differs between `before` and `after` in at most the
    // caller's own uid. `get(key, {})` is load-bearing: a conversation created before
    // this change has no such field, and reading a missing key in Firestore Rules is an
    // evaluation error rather than null — the same hazard that already bit `isPartnerOf`
    // in this file.
    function ownMarkOnly(before, after, key) {
      return after.get(key, {}).diff(before.get(key, {}))
                  .affectedKeys().hasOnly([request.auth.uid]);
    }

    // True when the map at `key` in a *newly created* document carries no foreign uid.
    // There is no `before` document to diff against on create, so `ownMarkOnly` cannot
    // apply here; the strictest safe shape is enforced directly instead: the map must be
    // absent, empty, or contain only the creator's own uid. Without this, whoever's
    // client wins the race to create the (deterministic-id) conversation could plant a
    // forged mark for the other participant baked into the initial document.
    function noForeignMarksOnCreate(data, key) {
      return data.get(key, {}).keys().hasOnly([request.auth.uid]);
    }

    // The marks `deleteAccount` leaves on a conversation it keeps for the parent who remains
    // (GDPR review, September 2026): the deadline the daily sweep deletes it at, who left, and
    // their name. Written by the Cloud Function alone. A client that could write them could keep
    // a thread past its deadline, cut it short, or banner an ordinary thread as the other
    // parent's deleted account.
    function departureMarks() {
      return ['retainedUntilMillis', 'departedUid', 'departedName'];
    }

    // ---- One-off day swaps (custody_models.dayOverrides) ---------------
    //
    // A swap is an *agreement*, and these two functions are what make it one rather than an
    // announcement. `DayOverrideTransition` refuses the same things client-side, but a client is
    // not where an adversarial counterparty is stopped, and this product's premise is that the
    // counterparty may be one.
    //
    // `get(..., {})` throughout: reading a missing key in Firestore Rules is an evaluation error,
    // not null, and every document written before this field existed has no `dayOverrides` —
    // the same hazard that already bit `isPartnerOf` in this file.

    // True when a write changes `dayOverrides` in exactly the one date it names, in a way the
    // caller is entitled to.
    //
    // The date comes from the document's own `lastSwapDate` because Rules cannot iterate a map:
    // there is no way to ask "for every changed key ...". Naming the key and then requiring the
    // diff to affect only that key makes a lie self-defeating — claim the wrong date and the
    // `hasOnly` check fails on the date that actually changed.
    //
    // Four legitimate shapes, and nothing else:
    //
    // 1. **An offer.** No entry for that date yet; the new one is PENDING and credits the caller
    //    as its author. `requestedBy` is what stops a parent deciding their own swap, so a forged
    //    author here would defeat the whole mechanism one level down.
    // 2. **A re-offer.** An entry exists and is being replaced by a fresh PENDING one, again
    //    authored by the caller. One override per date is the semantics and the newest offer is
    //    the live one, including a counter-offer over the co-parent's. It may replace an accepted
    //    swap: renegotiating an agreed day has to be possible, and it is not silent — the other
    //    parent sees the request in their inbox and the arrows on that date. The replaced
    //    entry's answer moves into the new entry's `earlier` list (`DayOverrideDecisionCodec`
    //    strings), and while the new offer waits — or once it is declined — the day stays where
    //    the latest accepted answer there put it (`DayOverride.agreedToParent`). That list now
    //    moves a day, so it is written only as the app writes it ([earlierWrittenAsTheAppDoes]):
    //    a forged "accepted" in it would be an agreement the co-parent never gave. An offer may
    //    also leave the list out, as an older build's does; the day then reads as it always did
    //    while pending, by the pattern.
    // 3. **An answer.** The entry was PENDING, the caller is *not* its author, the author is left
    //    as it was, and the decision is credited to the caller. Without the `decidedBy` check the
    //    requester could grant themselves the day while crediting the co-parent — the same
    //    forgery `lastModifiedBy` is validated against, one level down. The `earlier` list is
    //    left as it was, for the same reason: dropping it on a decline would hand the day back
    //    to the pattern over the agreement the decline was keeping.
    // 4. **A withdrawal** (October 2026). The entry was PENDING and the caller *is* its author; it
    //    becomes CANCELLED, credited to the caller, with its slot, its author and its `earlier`
    //    list as they were — so a day whose earlier offer was agreed stays where it was agreed. Only
    //    the author may take an offer back: the co-parent's way to say no is a decline.
    function validDayOverrideWrite(before, after) {
      return validDayOverrideAt(before, after, after.get('lastSwapDate', ''));
    }

    function validDayOverrideAt(before, after, date) {
      return date is string && date.size() > 0 &&
             after.get('dayOverrides', {}).diff(before.get('dayOverrides', {}))
                  .affectedKeys().hasOnly([date]) &&
             (
               // 1 and 2: an offer, over nothing or over whatever was there.
               (after.dayOverrides[date].status == 'PENDING' &&
                after.dayOverrides[date].requestedBy == request.auth.uid &&
                earlierWrittenAsTheAppDoes(before, after, date))
               ||
               // 3: an answer to the co-parent's pending offer.
               (date in before.get('dayOverrides', {}) &&
                before.dayOverrides[date].status == 'PENDING' &&
                before.dayOverrides[date].requestedBy != request.auth.uid &&
                after.dayOverrides[date].requestedBy == before.dayOverrides[date].requestedBy &&
                after.dayOverrides[date].decidedBy == request.auth.uid &&
                (after.dayOverrides[date].status == 'ACCEPTED' ||
                 after.dayOverrides[date].status == 'DECLINED') &&
                after.dayOverrides[date].get('earlier', []) ==
                  before.dayOverrides[date].get('earlier', []))
               ||
               // 4: the author's withdrawal of their own pending offer.
               (date in before.get('dayOverrides', {}) &&
                before.dayOverrides[date].status == 'PENDING' &&
                before.dayOverrides[date].requestedBy == request.auth.uid &&
                after.dayOverrides[date].status == 'CANCELLED' &&
                after.dayOverrides[date].requestedBy == request.auth.uid &&
                after.dayOverrides[date].decidedBy == request.auth.uid &&
                after.dayOverrides[date].toParent == before.dayOverrides[date].toParent &&
                after.dayOverrides[date].get('earlier', []) ==
                  before.dayOverrides[date].get('earlier', []))
             );
    }

    // An offer's `earlier` list, when it carries one, is exactly what `DayOverrideTransition`
    // writes: the replaced entry's own list, plus the replaced entry's answer when it had one (a
    // pending entry was never an agreement), and nothing over a day that had no entry.
    function earlierWrittenAsTheAppDoes(before, after, date) {
      return !('earlier' in after.dayOverrides[date]) ||
             after.dayOverrides[date].earlier == earlierAfterReplacing(before, date);
    }

    function earlierAfterReplacing(before, date) {
      return !(date in before.get('dayOverrides', {})) ? [] :
             before.dayOverrides[date].status == 'PENDING' ? before.dayOverrides[date].get('earlier', []) :
             before.dayOverrides[date].get('earlier', []).concat([dayOverrideAnswer(before.dayOverrides[date])]);
    }

    // `DayOverrideDecisionCodec.encode` of a stored entry:
    // `d1|toParent|requestedBy|requestedAt|status|decidedBy|decidedAt|groupId`.
    function dayOverrideAnswer(entry) {
      return 'd1|' + entry.toParent + '|' + entry.requestedBy + '|' + entry.get('requestedAt', '') +
             '|' + entry.status + '|' + entry.get('decidedBy', '') + '|' + entry.get('decidedAt', '') +
             '|' + entry.get('groupId', '');
    }

    // True when a write that calls itself a swap changes nothing but the swap.
    //
    // Without this, a pattern rewrite could ride along on a write stamped `lastModifiedKind:
    // 'SWAP'` — and `CustodyChangeAnnouncement` suppresses the banner for exactly that stamp, so
    // the co-parent's schedule would be replaced with no banner at all. That is the same
    // silencing the `lastModifiedBy` rule below exists to prevent, arriving through the door this
    // package just added.
    //
    // `lastModifiedAt` is deliberately absent from the allowed set, which is what keeps a swap
    // from re-dating the document: that field is what `CustodyModelRepository.isNewer` compares
    // to decide which phone's document survives, and the winner is re-pushed over the loser.
    function swapWriteTouchesOnlyTheSwap(before, after) {
      return after.diff(before).affectedKeys()
                  .hasOnly(['dayOverrides', 'lastSwapDate', 'lastModifiedBy', 'lastModifiedKind',
                            'contactWindows', 'seasonalLayers', 'childOverrides',
                            'proposalPlanCitation']) &&
             contactWindowsKeptOrDropped(before, after) &&
             seasonalLayersKeptOrDropped(before, after) &&
             childOverridesKeptOrDropped(before, after) &&
             planCitationKeptOrDropped(before, after);
    }

    // True when a write leaves `contactWindows` (MON-6b) exactly as it was, or drops the key.
    //
    // The contact windows are part of the agreed pattern, so a swap or proposal write may not
    // change them — that would be a pattern change riding on a write whose banner is suppressed,
    // the same silencing `swapWriteTouchesOnlyTheSwap` exists to refuse. Only a pattern write
    // (which stamps `lastModifiedBy` and is announced) may set them.
    //
    // **Dropping** the key is allowed, and that is not a loophole but backward compatibility: a
    // build that predates the field rewrites the whole document with `set()` and cannot carry a
    // key it has never heard of, so without this clause every swap and every proposal from a
    // co-parent on an older build would be denied the moment the pair had any window at all. It
    // costs nothing on the calendar: a current build reads a missing key as "written by an older
    // build" and keeps its own copy (`CustodyModelRepository.mirrorIntoRoom`), and a removal it
    // makes itself is an explicit empty list written by a pattern write.
    function contactWindowsKeptOrDropped(before, after) {
      return !('contactWindows' in after) ||
             !after.diff(before).affectedKeys().hasAny(['contactWindows']);
    }

    // True when a write leaves `seasonalLayers` (MON-14) exactly as it was, or drops the key.
    //
    // The same rule as `contactWindowsKeptOrDropped`, for the same two reasons. A seasonal layer
    // is part of the agreed pattern — it decides whose day a whole summer is — so a swap or a
    // proposal write may not change it: only a pattern write, which stamps `lastModifiedBy` and
    // is announced, may. And a build that predates the field rewrites the whole document without
    // the key, so dropping it must stay allowed or every swap and proposal from an older
    // co-parent would be denied the moment the pair had a layer; a current build reads a missing
    // key as "written by an older build" and keeps its own copy.
    function seasonalLayersKeptOrDropped(before, after) {
      return !('seasonalLayers' in after) ||
             !after.diff(before).affectedKeys().hasAny(['seasonalLayers']);
    }

    // True when a write leaves `childOverrides` (FAM-4) exactly as it was, or drops the key.
    //
    // The same rule as the two above, for the same two reasons. A child's own schedule is part of
    // the agreed arrangement — it decides whose every day is for that child — so only a pattern
    // write, which stamps `lastModifiedBy` and is announced, may change it; a swap or proposal
    // write that did would move a child in silence. And a build that predates the key rewrites
    // the whole document without it, so dropping it stays allowed; a build that knows the key
    // reads its absence as an older build's write and keeps its own copy.
    function childOverridesKeptOrDropped(before, after) {
      return !('childOverrides' in after) ||
             !after.diff(before).affectedKeys().hasAny(['childOverrides']);
    }

    // True when a write only puts, clears, or records the outcome of a custody *proposal* (item
    // 7) — it never touches the agreed pattern, its dates, or `lastModifiedBy`. That is the whole
    // safety property: a proposal write can never move anyone's calendar, so it is allowed
    // without stamping `lastModifiedBy` (the transition deliberately leaves it, or
    // `CustodyChangeAnnouncement` would read the pending pattern change as the proposer's own
    // echo and swallow its banner). Accepting a proposal is a different write — it changes the
    // model and stamps the accepter — and passes the normal pattern branch below, not this one.
    function proposalWriteTouchesOnlyProposal(before, after) {
      return after.diff(before).affectedKeys()
                  .hasOnly(['proposal', 'lastDecision', 'contactWindows', 'seasonalLayers',
                            'childOverrides', 'proposalPlanCitation']) &&
             contactWindowsKeptOrDropped(before, after) &&
             seasonalLayersKeptOrDropped(before, after) &&
             childOverridesKeptOrDropped(before, after);
    }

    // True when a write leaves `proposalPlanCitation` (MON-21) exactly as it was, or drops the
    // key. A swap write re-sends the pending proposal verbatim and so must re-send its citation
    // verbatim too; dropping it is what a build that predates the field does, and costs only the
    // "from the parenting plan" line on the other phone.
    function planCitationKeptOrDropped(before, after) {
      return !('proposalPlanCitation' in after) ||
             !after.diff(before).affectedKeys().hasAny(['proposalPlanCitation']);
    }

    // The shape of a proposal's parenting-plan citation (MON-21), on every write: absent — an
    // older build's proposal, or no proposal at all — or a string of at most 128 characters that
    // sits beside a pending `proposal`. It is a citation (`PlanCitationCodec`,
    // "p1|<questionId>|<16 hex>"), never text a reader is shown, so the bound is the whole of what
    // the rule needs to know about its content.
    //
    // It goes where the proposal goes. It may not outlive the proposal — accepting, declining or
    // withdrawing clears both, and a citation left beside no proposal would cite nothing — and
    // only the parent whose proposal it is may put or change it, whether the citation or the
    // proposal under it is what moves: otherwise the co-parent could re-attribute somebody's
    // proposal to a plan answer they never read. Removing it with the proposal needs no such
    // check; that is the decline.
    function planCitationValid(before, after) {
      return !('proposalPlanCitation' in after) ||
             (after.proposalPlanCitation is string &&
              after.proposalPlanCitation.size() <= 128 &&
              'proposal' in after &&
              after.proposal is map &&
              (!after.diff(before).affectedKeys().hasAny(['proposalPlanCitation', 'proposal']) ||
               after.proposal.get('proposedBy', '') == request.auth.uid));
    }

    // The same bound on a newly created document, which has no `before` to diff against. No client
    // creates the document with a proposal on it — the first schedule of a pair is simply saved —
    // so this only keeps a create from planting an oversized or orphaned key.
    function planCitationValidOnCreate(data) {
      return !('proposalPlanCitation' in data) ||
             (data.proposalPlanCitation is string &&
              data.proposalPlanCitation.size() <= 128 &&
              'proposal' in data &&
              data.proposal is map &&
              data.proposal.get('proposedBy', '') == request.auth.uid);
    }

    // The canonical pair id for a 2-element participants list — the same sorted-join formula
    // as Kotlin's `ConversationKey.of(uidA, uidB)` and `CustodyKey.of(uidA, uidB)`
    // (`listOf(uidA, uidB).sorted().joinToString("__")`). Shared by two collections:
    // `conversations` (inside `canRepointMessage` below, and bound directly into its own `create`
    // rule since September 2026) and `custody_models` (bound directly into its `create` rule, so a
    // document whose id does not match its own participants can never be created). Pinned
    // against the Kotlin side drifting apart by matching tests on each side: `ConversationKeyTest`
    // and `CustodyKeyTest` (Kotlin) assert their respective `of(...)` calls against the literal
    // this formula also produces, and `conversations-messages.test.js`'s "computes the same
    // canonical id..." case re-points a message to that literal string and asserts it is
    // allowed. If any formula ever changes, one side of a pin breaks before the others silently
    // disagree with it.
    //
    // Every document this function is ever handed has exactly two participants (both
    // collections' `create` rules require `participants.size() == 2`), so indexing `[0]`/`[1]`
    // is safe.
    function canonicalPairId(participants) {
      return participants[0] < participants[1]
        ? participants[0] + '__' + participants[1]
        : participants[1] + '__' + participants[0];
    }

    // True when a message may move from `before.conversationId` to `after.conversationId` —
    // the legacy-conversation merge (Task 5). The destination must be *the* canonical
    // conversation for the source conversation's participants — nowhere else.
    //
    // This used to be "the caller participates in both, and the two conversations name the same
    // pair of participants" — which is exactly as loose as it sounds: a participant could create
    // a second, same-pair conversation nobody observes (permitted by the `conversations` create
    // rule) and re-point the *other* participant's message into it, deleting it from the shared
    // thread in every way that matters even though `messages` states `allow delete: if false`
    // three lines below this block. Constraining the destination to the one computable id closes
    // this completely: a message can only ever move *into* the canonical thread, never out of
    // it or sideways into a look-alike, which is all the migration ever needs.
    //
    // The caller's participation in the source conversation is already required by the outer
    // `allow update` condition below before this function is even called; re-checking it here
    // would be a second `get()` on the same document for the same fact.
    function canRepointMessage(before, after) {
      return after.conversationId == canonicalPairId(
        get(/databases/$(database)/documents/conversations/$(before.conversationId)).data.participants
      );
    }

    // ---- Users ---------------------------------------------------------
    // Users can read/write their own profile and read their partner's profile.
    //
    // **A parent's own health data is gone** (GDPR Art. 5(1)(c), data minimisation): this
    // document is readable by the co-parent, so an adult's `allergies` and `medicalProfile` reached
    // their ex-partner. A create may carry neither key, and an update may not add or change one.
    // An update may still leave a key an older build stored untouched — refusing every write to
    // such a document would lock its owner out of their own profile (and their FCM token) until
    // something removed it — and may remove it: this build's profile save sends
    // `FieldValue.delete()` for both, and the operator-run `purgeParentHealthFields` callable
    // clears the rest. Pinned in `firestore-tests/rules/users-profile.test.js`.
    function parentHealthKeyAbsent(key) {
      return !(key in request.resource.data);
    }

    function parentHealthKeyNotWritten(key) {
      return parentHealthKeyAbsent(key) ||
             !(key in request.resource.data.diff(resource.data).affectedKeys());
    }

    // `healthDataConsent` records the parent's explicit consent to entering their children's
    // health details (GDPR Art. 9(2)(a); `domain/consent/HealthConsent.kt`): exactly
    // `{version, atMillis}`, both integers. Absent means never given or withdrawn.
    function healthConsentValid(data) {
      return !('healthDataConsent' in data) || (
        data.healthDataConsent is map &&
        data.healthDataConsent.keys().hasOnly(['version', 'atMillis']) &&
        data.healthDataConsent.keys().hasAll(['version', 'atMillis']) &&
        data.healthDataConsent.version is int &&
        data.healthDataConsent.version >= 1 &&
        data.healthDataConsent.atMillis is int &&
        data.healthDataConsent.atMillis > 0
      );
    }

    // `aiConsent` records the parent's opt-in to AI assist (MON-12; `functions/ai-assist.js`,
    // which reads it as admin and refuses a call without it): exactly `{version, grantedAt}`,
    // `version` an integer of at least 1 and `grantedAt` either epoch millis (the
    // `healthDataConsent` style) or the server's timestamp of this very write. Absent means never
    // given or withdrawn — withdrawal is deleting the field. It sits on the owner's own document,
    // so only the owner writes it (`isOwner` below); the co-parent can read that it was given, as
    // they can read the rest of the profile, and cannot give or withdraw it.
    //
    // Checked only when the write adds or changes it: a stored server timestamp no longer equals
    // `request.time`, and a later ordinary profile save that repeats it must not be refused.
    // Pinned in `firestore-tests/rules/ai-assist.test.js`.
    function aiConsentShapeValid(data) {
      return data.aiConsent is map &&
        data.aiConsent.keys().hasOnly(['version', 'grantedAt']) &&
        data.aiConsent.keys().hasAll(['version', 'grantedAt']) &&
        data.aiConsent.version is int &&
        data.aiConsent.version >= 1 &&
        ((data.aiConsent.grantedAt is int && data.aiConsent.grantedAt > 0) ||
         (data.aiConsent.grantedAt is timestamp && data.aiConsent.grantedAt == request.time));
    }

    function aiConsentCreateValid() {
      return !('aiConsent' in request.resource.data) || aiConsentShapeValid(request.resource.data);
    }

    function aiConsentUpdateValid() {
      return !('aiConsent' in request.resource.data) ||
             !('aiConsent' in request.resource.data.diff(resource.data).affectedKeys()) ||
             aiConsentShapeValid(request.resource.data);
    }

    // `paymentIban`: the account this parent receives a settle-up payment on, which the co-parent's
    // phone turns into a payment code (`PaymentAccounts`). Written by its owner alone, like the
    // rest of the profile, and only as something an IBAN can be — the client checks the digits.
    function paymentIbanValid(data) {
      return !('paymentIban' in data) ||
             (data.paymentIban is string && data.paymentIban.size() >= 15 && data.paymentIban.size() <= 34);
    }

    // `parentRole`: how this parent's stickers address them — "dad", "mom" or "parent" (October
    // 2026, owner decision; docs/DESIGN-stickers-and-subscription.md). Written by its owner alone,
    // like the rest of the profile, and only as one of the three words.
    function parentRoleValid(data) {
      return !('parentRole' in data) || data.parentRole in ['dad', 'mom', 'parent'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isPartnerOf(userId);

      allow create: if isOwner(userId) &&
                      'email' in request.resource.data &&
                      'name' in request.resource.data &&
                      isValidLength(request.resource.data.name, 1, 100) &&
                      // See `update` below: a profile must not be born self-paired either, or
                      // the same hole reopens through the create path.
                      request.resource.data.get('partnerId', '') != userId &&
                      // The server-owned fields `update` pins may not be *born* either. A profile
                      // created with `partnerIds: [victim]` made `myAudience()` name the victim,
                      // so the creator could write events, children and pets into the victim's
                      // sync with `isMyAudience` satisfied — and before `delete` was closed, any
                      // account could get here again by deleting its own profile first. Nothing
                      // the app creates carries any of them: `ensureProfile`, `updateUser`,
                      // `setHealthConsent` and the FCM token merge write identity and settings
                      // only, and pairing (`acceptPairingInvitation`, admin) adds the rest later.
                      // An empty value is what an unpaired profile honestly holds, so it passes.
                      request.resource.data.get('partnerId', '') == '' &&
                      request.resource.data.get('partnerIds', []).size() == 0 &&
                      request.resource.data.get('pendingRevocationOf', []).size() == 0 &&
                      !('role' in request.resource.data) &&
                      !('slotMovedAt' in request.resource.data) &&
                      parentHealthKeyAbsent('medicalProfile') &&
                      parentHealthKeyAbsent('allergies') &&
                      healthConsentValid(request.resource.data) &&
                      aiConsentCreateValid() &&
                      paymentIbanValid(request.resource.data) &&
                      parentRoleValid(request.resource.data) &&
                      (!('firebaseUid' in request.resource.data) ||
                       request.resource.data.firebaseUid == null ||
                       request.resource.data.firebaseUid == request.auth.uid);

      // `partnerId` may never name the document's own owner. It is unconstrained otherwise —
      // pairing and unpairing write it from `functions/index.js` on Admin credentials, which
      // bypasses this rule — but a self-reference is what made `isPartnerOf(me)` answer true
      // for me, and that answer is the gate on the co-parent branch of nearly every other
      // collection in this file.
      //
      // The concrete damage was to revocation. `custody_models` get/update require the pairing
      // behind the stored `participants` to still be live, precisely so an ex-partner loses the
      // shared schedule the moment either `partnerId` clears. An ex-partner who wrote
      // `partnerId: <own uid>` satisfied that check against themselves and kept reading and
      // *rewriting* the schedule indefinitely — the app having already reported the link ended.
      // The same self-reference let an account create a `conversations` document with any
      // stranger as the second participant and post messages into it.
      //
      // `role`, `partnerId`, `partnerIds` and `pendingRevocationOf` are **server-owned**:
      // `acceptPairingInvitation` and `unpairCoParent` write them as admin, and the client
      // deliberately omits them from its profile writes (`UserRepositoryImpl.updateUser`). A client
      // may still *repeat* the stored value — `diff().affectedKeys()` counts only what changed —
      // but may not move any of the four. (`pendingRevocationOf` is what tells
      // `stampOwnBlankFamilyIds` an earlier relationship is still being unwound; clearing it
      // would let the server stamp an old household's records into a new one.) Before this pin a parent could flip their own slot and take the co-parent's
      // colour, or put both parents in one slot and switch the expense split off for the pair.
      allow update: if isOwner(userId) &&
                      request.resource.data.get('partnerId', '') != userId &&
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'partnerId', 'partnerIds', 'pendingRevocationOf']) &&
                      // `slotMovedAt` is the server's word to this parent's phone that a pairing
                      // moved their slot (`slotsForPairing`). The phone removes it once it has
                      // re-stamped its records; it may never write or move it.
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['slotMovedAt']) ||
                       !('slotMovedAt' in request.resource.data)) &&
                      parentHealthKeyNotWritten('medicalProfile') &&
                      parentHealthKeyNotWritten('allergies') &&
                      healthConsentValid(request.resource.data) &&
                      aiConsentUpdateValid() &&
                      paymentIbanValid(request.resource.data) &&
                      parentRoleValid(request.resource.data) &&
                      isValidLength(request.resource.data.get('name', ''), 0, 100) &&
                      (!('firebaseUid' in request.resource.data) ||
                       request.resource.data.firebaseUid == null ||
                       request.resource.data.firebaseUid == request.auth.uid);

      // Never from a client. Account deletion removes the profile as admin (`deleteAccount`), and
      // nothing in the app deletes it otherwise. An owner who could delete it could create it
      // again — and a create is the one write that has no stored value to compare against, which
      // is how `partnerIds` was re-seeded before `create` pinned it too.
      allow delete: if false;
    }

    // ---- Google OAuth fingerprints ---------------------------------------
    // `google_oauth/{uid}` holds a SHA-256 of the refresh token that account was issued
    // (SEC-1 §2). **No client may touch it, in either direction.**
    //
    // The read side matters as much as the write side, and less obviously. The document exists
    // so that moving the OAuth client secret out of the APK does not leave the refresh callable
    // as an oracle that would refresh any stolen token for anybody — it answers "is this the
    // token this account was issued". A client that could read the fingerprint could test
    // candidate tokens offline; one that could write it could claim somebody else's.
    //
    // `exchangeGoogleAuthCode` and `refreshGoogleAccessToken` run on Admin credentials and
    // bypass these rules, which is what makes a flat denial workable rather than merely strict.
    match /google_oauth/{userId} {
      allow read, write: if false;
    }

    // ---- AI assist quota (MON-12) --------------------------------------------
    // `ai_usage/{uid}` is the daily count `aiAssist` keeps per account: `{day, count,
    // updatedAtMillis}` and nothing about what was asked. **Closed to every client**: a parent who
    // could write it would reset their own quota, and the callable, on Admin credentials, is its
    // only reader and writer. Account deletion removes it (`deleteAccountDataImpl`).
    match /ai_usage/{userId} {
      allow read, write: if false;
    }

    // ---- Calendar feeds (MON-17) ---------------------------------------------
    // `calendar_feeds/{sha256(token)}` — one read-only iCalendar link each: the family it
    // serves, who made it, and when it was last fetched. **No client may touch it, in either
    // direction**, for the reason `google_oauth` above is closed. The document id is the hash of
    // the only credential the feed has, so a client that could list the collection could learn
    // which families have a link, and one that could write it could mint a feed into somebody
    // else's family, point an existing one at another family, or keep a revoked one alive.
    // `createCalendarFeed`, `listCalendarFeeds`, `revokeCalendarFeed` and the `calendarFeed`
    // HTTPS function run on Admin credentials and are its only door.
    match /calendar_feeds/{feedHash} {
      allow read, write: if false;
    }

    // ---- Friend profiles ------------------------------------------------
    // A trusted third person (guardian, friend, grandparent — item 16) authors their own
    // profile; the two parents read it but never write it, so nobody puts words in a
    // grandmother's mouth. The document id is the friend's own uid.
    //
    // `familyParents` is the read gate: the parents allowed to see this profile. The friend sets
    // it on create (to the parents of every family that has admitted them — two per family, so at
    // least two) and it is immutable to the friend afterwards; `acceptCalendarFriendInvitation`
    // adds a new family's two parents when the friend redeems a second family's code (L-5),
    // running as Admin. A friend widening it only exposes their *own* profile, and it lets a
    // parent's read be a plain array-membership check with no per-document `get()`.
    match /friend_profiles/{friendUid} {
      allow read: if isAuthenticated() && (
        request.auth.uid == friendUid ||
        request.auth.uid in resource.data.get('familyParents', [])
      );

      allow create: if isOwner(friendUid) &&
                      'name' in request.resource.data &&
                      isValidLength(request.resource.data.name, 1, 100) &&
                      request.resource.data.get('familyParents', []) is list &&
                      request.resource.data.get('familyParents', []).size() >= 2 &&
                      request.resource.data.get('familyParents', []).size() <= 40;

      // Owner-only, and the read gate is immutable — a friend may edit their name, photo or
      // blood group but never rewrite who can see the profile.
      allow update: if isOwner(friendUid) &&
                      request.resource.data.familyParents == resource.data.familyParents;

      allow delete: if isOwner(friendUid);
    }

    // ---- Calendar-friend grants ----------------------------------------
    // The grant that lets a friend read one family's calendar (item 16), keyed
    // `{familyId}__{friendUid}` (L-5) so `isCalendarFriendOf` builds the path from the record's
    // family and the caller and reads it in one `get()` — and so one friend can hold a grant in
    // each of several families instead of the second overwriting the first. Written only by
    // `acceptCalendarFriendInvitation` (below); read by the friend, to learn which families they
    // may query (`where('friendUid', '==', uid)`), and by either parent of the family
    // (`where('familyParents', 'array-contains', uid)`). `familyId`, `friendUid`,
    // `familyParents` and `expiresAtMillis` are the fields the events read rule depends on;
    // `familyId` is `FamilyKey.of(familyParents)` and is what scopes the grant to **one** of the
    // inviter's families (M-6). A per-person grant from before L-5 (`calendar_friends/{friendUid}`,
    // no `friendUid` field) admits nothing and is readable by its parents only, until
    // `backfillRecordFamilyIds` re-keys it.
    match /calendar_friends/{grantId} {
      allow read: if isAuthenticated() && (
        resource.data.get('friendUid', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('familyParents', [])
      );

      // **No client may write a grant, at all.** The only writer is
      // `acceptCalendarFriendInvitation`, which runs on Admin credentials and therefore
      // bypasses this rule entirely; on the Android side `FriendRepositoryImpl` only ever
      // observes this collection and deletes from it (`revokeFriend`), so closing writes here
      // costs no client path.
      //
      // What it closes is a total breach of the events collection. The previous condition asked
      // only that the *written document* name the caller among its two `familyParents` and
      // credit them as `grantedBy` — both fields the caller supplies. So any authenticated
      // account could write a grant for itself with
      // `familyParents: [ownUid, victimUid]`, an expiry far in the future, and `grantedBy`
      // itself, and every one of those checks passed. `isCalendarFriendOf(victimUid)` then
      // answered true, and the third disjunct of the `events` read rule below handed over the
      // victim's whole calendar — by document id, and by the list query
      // `where('createdByFirebaseUid', '==', victimUid)`, whose structure the rule permits.
      // Knowing a uid was the entire prerequisite, and a uid is not a secret: an ex-partner
      // holds one, and so does anyone who has ever shared a document with the victim.
      //
      // Worse than a read, it was a door around revocation. `unpairCoParent` narrows
      // `sharedWith` on every shared document, but a grant lives outside that list by design
      // (the whole point of holding it centrally), so an ex-partner could restore their view of
      // the calendar with a single write, after the app had told the other parent access was
      // revoked.
      //
      // The callable is where the checks that matter already live: it proves the *inviter* is a
      // paired parent, derives `familyParents` from that pairing rather than from anything the
      // accepter sent, and refuses a parent redeeming their own family's invitation.
      allow create, update: if false;

      // Either parent may revoke by deleting the grant; the friend cannot delete their own
      // (that would let a friend hide a revocation from the parents' view).
      allow delete: if isAuthenticated() &&
                      request.auth.uid in resource.data.get('familyParents', []);
    }

    // ---- Professional grants (MON-18) ------------------------------------
    // A mediator, lawyer, guardian ad litem or therapist admitted to read one family's calendar,
    // parenting plan and custody schedule. Id `{familyId}__{proUid}`, so `isProfessionalOf` reads
    // it in one `get()` built from what the rule already holds.
    //
    // Three writers, and each may do exactly one thing:
    //   - `acceptProfessionalInvitation` (Admin, bypasses this rule) creates it, with the
    //     inviting parent's consent already in `consents`;
    //   - the **other** parent adds their own consent — the second key that makes it active;
    //   - **either** parent deletes it, alone, at any time. Revocation needs one person because
    //     a parent who wants a stranger out of the family's calendar must not need the other's
    //     agreement to get them out.
    // The professional writes nothing. They cannot grant themselves anything, extend their own
    // expiry, or consent on a parent's behalf — and they cannot delete the grant either, so a
    // parent's list never loses a row that the parent did not remove.
    match /professional_grants/{grantId} {
      // `list` on the same terms: the professional's query filters `proUid == me`, a parent's
      // `familyParents array-contains me`, and Firestore validates either by its structure.
      allow read: if isAuthenticated() && (
        resource.data.get('proUid', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('familyParents', [])
      );

      allow create: if false;

      // A parent adds or re-stamps their **own** consent and touches nothing else: the outer
      // `hasOnly` keeps the write off the expiry, the parents and the professional; the inner one
      // keeps one parent from consenting for the other. The value must be a positive number
      // (epoch millis), so removing one's own key — which `get` reads as 0 —
      // is refused rather than silently turning consent into its absence; a parent who no longer
      // consents revokes. An expired grant cannot be consented to: it would open nothing, and a
      // parent seeing "active" beside it would be told something false.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.get('familyParents', []) &&
                      request.time.toMillis() < resource.data.get('expiresAtMillis', 0) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consents']) &&
                      request.resource.data.get('consents', {})
                        .diff(resource.data.get('consents', {}))
                        .affectedKeys().hasOnly([request.auth.uid]) &&
                      request.resource.data.get('consents', {}).get(request.auth.uid, 0) is number &&
                      request.resource.data.get('consents', {}).get(request.auth.uid, 0) > 0;

      allow delete: if isAuthenticated() &&
                      request.auth.uid in resource.data.get('familyParents', []);
    }

    // ---- Events --------------------------------------------------------
    // Owners and shared partners have access. Date fields are ISO strings, so
    // no timestamp-type or ordering checks here (that is enforced app-side).
    // True when a write that records an answer to an event (`acceptance` ACCEPTED or DECLINED)
    // is that answer's own parent's (security audit, October 2026). The fields were open to the
    // creator, so Alice could write `{acceptance: 'ACCEPTED', acceptedBy: BOB}` on her own event —
    // or turn Bob's DECLINED back — and the record would carry an agreement Bob never gave. Now an
    // answer that *changes* must name the caller in `acceptedBy`, and the caller must not be the
    // creator, which is `EventAcceptanceTransition`'s own rule. Re-sending the stored answer
    // unchanged (the creator's next save after Bob answered) and moving back to PENDING or
    // NOT_REQUIRED (an edit that asks again) stay open. On create, `before` is `{}`.
    function answerWrittenByItsParent(before, after) {
      return (after.get('acceptance', 'NOT_REQUIRED') == before.get('acceptance', 'NOT_REQUIRED') &&
              after.get('acceptedBy', '') == before.get('acceptedBy', '')) ||
             !(after.get('acceptance', 'NOT_REQUIRED') in ['ACCEPTED', 'DECLINED']) ||
             (after.get('acceptedBy', '') == request.auth.uid &&
              request.auth.uid != after.get('createdByFirebaseUid', ''));
    }

    // True when a non-creator's edit of an event leaves its `familyId` alone, or fills a blank one
    // with the family of exactly the creator and the caller (see the events update rule).
    function partnerKeepsFamily(before, after) {
      return after.get('familyId', '') == before.get('familyId', '') ||
             (before.get('familyId', '') == '' &&
              isFamilyMember(after.get('familyId', '')) &&
              after.familyId.split('__').size() == 2 &&
              before.get('createdByFirebaseUid', '') in after.familyId.split('__'));
    }

    // True when a write leaves a stamped `familyId` exactly as it was. Only a blank one may move,
    // and the caller's own branch says to what (`familyIsMineOrBlank`, `partnerKeepsFamily`).
    //
    // A record keeps its family (CLAUDE.md item 18), and that applies to its creator too: the
    // family decides who else reads it — the co-parent of an expense, a calendar friend or a
    // professional of an event — so moving an A record to B hands it to B's people. Blanking is
    // refused as well, because blank → B is a fill: two writes would walk around a bound on one.
    // A device whose row lacks a family the server already stamped writes `''` here and is
    // refused until its sync brings the stamp down; a refused upload stays queued.
    function familyKept(before, after) {
      return before.get('familyId', '') == '' ||
             after.get('familyId', '') == before.get('familyId', '');
    }

    match /events/{eventId} {
      // Creator, a shared partner, or a live calendar friend of the creator (item 16). The
      // friend disjunct is last so a parent's own read short-circuits before any `get()`.
      allow read: if isAuthenticated() && (
        resource.data.createdByFirebaseUid == request.auth.uid ||
        request.auth.uid in resource.data.get('sharedWith', []) ||
        isCalendarFriendOf(resource.data.createdByFirebaseUid,
                           resource.data.get('familyId', '')) ||
        // A professional with an active, two-consent grant over this event's family (MON-18).
        // Last, after the friend, so neither a parent's nor a friend's read pays for it. A
        // private event never reaches Firestore (item 3), so there is nothing private to admit.
        isProfessionalOfRecord(resource.data.createdByFirebaseUid,
                               resource.data.get('familyId', ''))
      );

      // Presence-based validation only — the real document carries the full
      // schema, so an exact key-set match must NOT be required.
      allow create: if isAuthenticated() &&
                      request.resource.data.createdByFirebaseUid == request.auth.uid &&
                      request.resource.data.keys().hasAll(['title', 'startDateTime', 'eventType', 'parentOwner']) &&
                      isValidLength(request.resource.data.title, 1, 200) &&
                      // Who may see it is bound to who the writer is — see `isMyAudience`.
                      isMyAudience(request.resource.data.get('sharedWith', [])) &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                      // …and, once it names a family, to that family's two parents: a parent in
                      // two families may not show one family's event to the other's co-parent
                      // (item 38's bound, which children and pets already had).
                      audienceWithinItsFamily(request.resource.data, noGuests()) &&
                      answerWrittenByItsParent({}, request.resource.data);

      // Creator, or a partner with read_write permission, may update. The creator
      // field is immutable. lastModifiedBy is intentionally NOT required to equal
      // the caller: the client doesn't reliably stamp the editor on every write
      // path, and forcing it here silently denied legitimate partner edits.
      // Two shapes, and only the creator gets the wider one.
      //
      // A shared partner editing with `read_write` may change the event itself but not **who
      // can see it**: `sharedWith` and `permissions` must come back unchanged. Without that
      // pin, a partner could append an arbitrary uid and hand a stranger the creator's event
      // (the read rule below is plain membership), or drop the creator's co-parent from the
      // list — which removes the event from that parent's sync feed, a silent deletion by
      // another name, in a collection whose `delete` is deliberately creator-only.
      //
      // `.get()` on both fields for the reason stated at the top of this file: a document
      // written without one would otherwise make this rule *error*, and an erroring rule
      // denies — locking a legitimate editor out with no way back.
      allow update: if isAuthenticated() && (
        (resource.data.createdByFirebaseUid == request.auth.uid &&
         // The creator may re-shape the audience, but may only *add* their own family: an
         // audience is a grant, and this is the bound `create` places on it, applied to
         // what the write admits rather than to what an older write already had.
         onlyFamilyAdded(resource.data, request.resource.data) &&
         familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
         // A stamped event stays in its family, and what the write adds is that family's.
         familyKept(resource.data, request.resource.data) &&
         onlyFamilyAddedToItsFamily(resource.data, request.resource.data, noGuests())) ||
        (request.auth.uid in resource.data.get('sharedWith', []) &&
         resource.data.get('permissions', '') == 'read_write' &&
         request.resource.data.get('sharedWith', []) == resource.data.get('sharedWith', []) &&
         request.resource.data.get('permissions', '') == resource.data.get('permissions', '') &&
         // Nor which household it belongs to, nor whether it is private. `familyId` decides who
         // else reads it (a calendar friend, a professional, the calendar feed) and `isPrivate`
         // hides it from the feed and the server's revision record — both the creator's call.
         // The one move a co-parent's phone legitimately makes is filling a *blank* family with
         // the pair's own: its `FamilyIdBackfill` stamps a downloaded event that came without one,
         // and its next save writes that back. Only the family both of them are in qualifies.
         partnerKeepsFamily(resource.data, request.resource.data) &&
         request.resource.data.get('isPrivate', false) == resource.data.get('isPrivate', false))
      ) && request.resource.data.createdByFirebaseUid == resource.data.createdByFirebaseUid &&
        answerWrittenByItsParent(resource.data, request.resource.data);

      allow delete: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid;
    }

    // ---- Event revisions (MON-4) ----------------------------------------
    // One immutable document per saved revision of a non-private event: the whole event as the
    // editing device saved it, who saved it, when their device says they did, and when the server
    // received it. docs/DESIGN-court-record.md §4 is the design; CLAUDE.md item 25 the invariants.
    //
    // **Create only, for everybody, for ever.** That is the whole guarantee the export sells: a
    // revision, once written, can be changed or removed by neither parent. `update` and `delete`
    // are false with no exception — an account deletion runs as admin and bypasses this, which
    // is the one path meant to remove them.

    // True when the caller may edit the event document [ev] — its creator, or a co-parent the
    // event is shared with under `read_write`. The same two branches as the events update rule.
    function mayEditEvent(ev) {
      return ev.get('createdByFirebaseUid', '') == request.auth.uid ||
             (request.auth.uid in ev.get('sharedWith', []) &&
              ev.get('permissions', '') == 'read_write');
    }

    // True when the caller may record a revision of [eventId].
    //
    // A missing event does not refuse its creator, deliberately. The revision comes from a device
    // outbox, and the event may not have landed yet (created offline) or may already be gone
    // (created and deleted offline, or swept 90 days after its tombstone); refusing either would
    // strand the outbox for ever. It grants nothing: the author is the caller and the audience is
    // bound to the caller's own family below, so a revision of a missing event is the caller's own
    // words under their own name — which is what creating an event already is. **Only the event's
    // creator, though**, as the revision's own copy of the event says: anybody else could file
    // "revisions" under the id of an event that was swept or turned private, and a non-creator's
    // edit of an event that no longer exists is not a save the record has to keep.
    //
    // An event that exists also bounds the revision's audience by **its** family, whatever family
    // the revision itself names: an unstamped revision of a family-A event must not carry A's
    // event to the other family's co-parent.
    function mayRecordRevisionOf(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
          ? (mayEditEvent(get(/databases/$(database)/documents/events/$(eventId)).data) &&
             revisionWithinEventFamily(
               get(/databases/$(database)/documents/events/$(eventId)).data))
          : request.resource.data.event.get('createdByFirebaseUid', '') == request.auth.uid;
    }

    // The revision's audience against the stored event's family, when it names one.
    function revisionWithinEventFamily(ev) {
      return !(ev.get('familyId', '') is string) ||
             withinFamily(request.resource.data.sharedWith.toSet(), ev.get('familyId', ''));
    }

    match /event_versions/{versionId} {
      // The revision's own audience, frozen when it was saved. Not the event's current one and
      // not `calendar_friends`: a friend sees the calendar as it stands, and the history of how
      // the two parents edited it is theirs. Unpair does not narrow it either — the ex-partner
      // keeps the revisions they could see, as they keep the chat thread.
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.get('sharedWith', []);

      // `srv_` ids and the `recordedBy` key (outside `hasOnly` below) are the server's: the
      // `recordServerEventRevision` function records a write no phone recorded under
      // `srv_<eventId>_<commit time>`, and a client that could take that id first would keep
      // the server's revision out (docs/DESIGN-court-record.md §11).
      allow create: if isAuthenticated() &&
                      !versionId.matches('srv_.*') &&
                      request.resource.data.keys().hasOnly(
                        ['eventId', 'kind', 'editorUid', 'deviceTimeMillis', 'recordedAt',
                         'sharedWith', 'familyId', 'event', 'formatVersion']) &&
                      request.resource.data.keys().hasAll(
                        ['eventId', 'kind', 'editorUid', 'deviceTimeMillis', 'recordedAt',
                         'sharedWith', 'familyId', 'event', 'formatVersion']) &&
                      request.resource.data.editorUid == request.auth.uid &&
                      // The server's clock, and only the server's: the client writes
                      // `FieldValue.serverTimestamp()`, which is exactly `request.time`.
                      request.resource.data.recordedAt == request.time &&
                      request.resource.data.deviceTimeMillis is int &&
                      request.resource.data.kind in ['created', 'updated', 'deleted'] &&
                      request.resource.data.formatVersion is int &&
                      request.resource.data.eventId is string &&
                      request.resource.data.event is map &&
                      request.resource.data.event.get('id', '') == request.resource.data.eventId &&
                      request.resource.data.sharedWith is list &&
                      request.auth.uid in request.resource.data.sharedWith &&
                      isMyAudience(request.resource.data.sharedWith) &&
                      familyIsMineOrBlank(request.resource.data.familyId) &&
                      // A revision is kept for ever and unpair never narrows it, so an audience
                      // outside its family would be a disclosure nothing can take back.
                      withinFamily(request.resource.data.sharedWith.toSet(),
                                   request.resource.data.familyId) &&
                      mayRecordRevisionOf(request.resource.data.eventId);

      allow update, delete: if false;
    }

    // `export_receipts/{recordId}` — the SHA-256 of an exported file, registered under the record
    // id the file prints (MON-16, docs/DESIGN-court-record.md §10).
    //
    // **Closed to every client, in both directions.** The callables in `functions/` are the only
    // readers and writers, as admin: `reserveExportRecordId` mints the id, `registerExportReceipt`
    // records the hash once, and `verifyExport` answers a verifier with a fixed, identity-free
    // view. A client that could write here could register a hash for a file the app never made,
    // or re-date one it did; a client that could read here could learn who exported what and
    // when — `generatorUid` and `familyId` are exactly what `verifyExport` refuses to disclose.
    // Firestore denies by default, so this block changes nothing at runtime; it exists so the
    // intent is stated and `firestore-tests/rules/export-receipts.test.js` has something to pin.
    match /export_receipts/{recordId} {
      allow read, write: if false;
    }

    // ---- Child info ----------------------------------------------------
    // Shared between a parent pair via the sharedWith list.
    // True when `guests` names the caller and their grant has run out — or carries no usable
    // expiry at all.
    //
    // **Fail closed, and read `GuestGrantPolicy` before changing this.** That file is the
    // statement all three implementations of this question must agree with: the app, this rule,
    // and `sweepExpiredGuests`. The comparison is a strict `<` against `expiresAtMillis`, so a
    // grant expiring at noon is not active at noon in any of the three.
    //
    // Epoch millis rather than the ISO strings the rest of this schema uses, and that is not a
    // stylistic slip: Rules cannot parse a string into a timestamp, so an ISO expiry could not be
    // compared here at all and this rule could only ever check that a guest *is* a guest.
    //
    // A grant with no `expiresAtMillis`, or a non-positive one, is expired. `get(…, 0)` is what
    // makes an absent field a value rather than an evaluation error — the hazard that has already
    // bitten this file twice.
    function guestGrantExpired(data) {
      return data.get('guests', {}).keys().hasAny([request.auth.uid]) &&
             (data.guests[request.auth.uid].get('expiresAtMillis', 0) <= 0 ||
              data.guests[request.auth.uid].get('expiresAtMillis', 0) <= request.time.toMillis());
    }

    match /child_info/{childInfoId} {
      // A guest reads through `sharedWith` like anybody else — that is why they are put in it —
      // but only while their grant stands. A parent is never in `guests`, so this costs them
      // nothing.
      //
      // The rule is the weaker half of the expiry. It stops the read, but the uid stays in
      // `sharedWith`, so the record keeps coming back from the audience query and the guest
      // keeps appearing in the audience. `sweepExpiredGuests` is what actually removes them;
      // this is what holds until it runs.
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.get('sharedWith', []) &&
                    !guestGrantExpired(resource.data);

      allow create: if isAuthenticated() &&
                      request.resource.data.createdByFirebaseUid == request.auth.uid &&
                      request.auth.uid in request.resource.data.sharedWith &&
                      request.resource.data.keys().hasAll(['childName', 'createdByFirebaseUid', 'sharedWith']) &&
                      isValidLength(request.resource.data.childName, 1, 100) &&
                      // The audience minus the guests it names must be the writer's own family.
                      isMyGuestlessAudience(request.resource.data) &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                      // …and, once the record names a family, that family's two parents.
                      audienceWithinItsFamily(request.resource.data, guestUidsOf(request.resource.data));

      // Being in the audience is not permission to write. `sharedWith` is what makes the
      // document *readable*, and package G2 puts a guest — a grandparent, for a weekend — into
      // it for exactly that reason. Under the old rule, which asked only for membership, that
      // would have made them an editor of a child's medical record: notes, allergies, the
      // medical profile and the photographs G1 added. A writer must be the creator or the
      // creator's partner.
      //
      // Membership is still required on top, and deliberately: it is what keeps a document
      // whose `sharedWith` has been stripped un-updatable rather than quietly writable by its
      // creator again. Part 3 of `child-info.test.js` pins that, and it is the state that once
      // could only be escaped by deleting the document.
      //
      // **The creator can never be written out of their own record, and a non-creator may only
      // let guests in.** Both updates used to leave `sharedWith` free, so the co-parent could
      // strip the creator from a child's medical record — leaving it unreadable and, since the
      // update rule keys on membership, un-updatable by the parent who wrote it — or hand it to
      // any uid at all. A parent's own edit may admit only their family and the guests it names,
      // the bound `create` places on the whole list applied to what the edit adds; the
      // co-parent's may add nothing but the keys of the `guests` map they are writing.
      //
      // **"Their family" is the record's own, once it names one.** `onlyFamilyOrGuestsAdded`
      // accepts any of the writer's co-parents, and a parent in two families has two: switching
      // the phone to the second family and syncing re-uploaded every child of the first with the
      // second family's parent in `sharedWith`, medical details and all, and the write passed.
      // `onlyFamilyAddedToItsFamily` bounds what a write adds to the parents the record's family id
      // names, before and after the write.
      //
      // **"The creator's partner" is a parent of the record's own family** (`isRecordPartner`).
      // `isPartnerOf(creator)` asked a question about the creator, and a parent in two families
      // has two partners: the other family's co-parent, once in the audience — as a guest Zuzana
      // let in, or as what the item-38 leak left behind — became a full editor who could extend
      // or drop their own guest grant, mint guests, drop the family's other parent and re-stamp
      // the record into their own family. A guest never takes the partner branch, and the record
      // keeps its family on both branches (`familyKept`, `partnerKeepsFamily`), so the bound below
      // cannot be walked around in two writes.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.sharedWith &&
                      resource.data.createdByFirebaseUid in request.resource.data.sharedWith &&
                      (
                        (resource.data.createdByFirebaseUid == request.auth.uid &&
                         onlyFamilyOrGuestsAdded(resource.data, request.resource.data) &&
                         familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                         familyKept(resource.data, request.resource.data)) ||
                        (isRecordPartner(resource.data, request.resource.data) &&
                         request.auth.uid in request.resource.data.sharedWith &&
                         onlyGuestsAdded(resource.data, request.resource.data))
                      ) &&
                      onlyFamilyAddedToItsFamily(resource.data, request.resource.data,
                                                 guestUidsOf(request.resource.data)) &&
                      request.resource.data.createdByFirebaseUid == resource.data.createdByFirebaseUid;

      allow delete: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid;
    }

    // True when the caller may edit a child's or a pet's record as the creator's co-parent: one
    // of the two parents the record's family names (and still the creator's co-parent), or — for
    // a record that names no family yet — any co-parent of the creator, the older bound. Never a
    // guest, before or after the write: a guest reads, and a parent who names themselves a guest
    // would be swept out of their own child's record when the grant ran out. The family stays as
    // it was, or a blank one is filled with the creator's and the caller's (`partnerKeepsFamily`).
    function isRecordPartner(before, after) {
      return (before.get('familyId', '') == ''
                ? isPartnerOf(before.createdByFirebaseUid)
                : (isFamilyMember(before.familyId) &&
                   before.createdByFirebaseUid in before.familyId.split('__') &&
                   isPartnerOf(before.createdByFirebaseUid))) &&
             !(request.auth.uid in before.get('guests', {})) &&
             !(request.auth.uid in after.get('guests', {})) &&
             partnerKeepsFamily(before, after);
    }

    // The uids a child record's write lets in as guests: the keys of the `guests` map it carries.
    // A pet has no guests, so its rules pass `noGuests()` where a child's pass this.
    function guestUidsOf(data) {
      return data.get('guests', {}).keys().toSet();
    }

    function noGuests() {
      return [].toSet();
    }

    // True when [familyId] names no family — the blank an unpaired parent's records carry, which
    // has no parents to bound by — or names exactly two people and every uid in [uids] (a Set) is
    // one of them.
    //
    // The two parents come from the id itself, `FamilyKey.of`'s two uids sorted and joined with
    // `__` — the same reading `isFamilyMember` and the vault's audience bound make, so no document
    // is read. Exactly two, not "any part": an id with a third part would otherwise admit whoever
    // it names. A non-string id is refused here as it is by `familyIsMineOrBlank`.
    function withinFamily(uids, familyId) {
      return familyId == '' ||
             (familyId is string &&
              familyId.split('__').size() == 2 &&
              uids.difference(familyId.split('__').toSet()).size() == 0);
    }

    // On create: the whole audience of a child or pet record, its guests taken out, is the
    // record's own family when it names one.
    function audienceWithinItsFamily(data, guestUids) {
      return withinFamily(data.get('sharedWith', []).toSet().difference(guestUids),
                          data.get('familyId', ''));
    }

    // On update: every uid a write adds to a child or pet record's `sharedWith`, its guests
    // excepted, is a parent of the family the record named before the write **and** of the one it
    // names after. Both, because a record keeps its family (CLAUDE.md item 18) and a bound on the
    // new id alone is walked around by re-stamping the record into the other family. On the
    // additions only, for the reason `onlyFamilyAdded` gives: a removal is never refused, which is
    // also what lets a leaked uid be taken out by whichever parent writes next.
    function onlyFamilyAddedToItsFamily(before, after, guestUids) {
      return withinFamily(addedToAudience(before, after, guestUids), before.get('familyId', '')) &&
             withinFamily(addedToAudience(before, after, guestUids), after.get('familyId', ''));
    }

    // The uids a write adds to `sharedWith`, as a Set, [guestUids] taken out.
    function addedToAudience(before, after, guestUids) {
      return after.get('sharedWith', []).toSet()
        .difference(before.get('sharedWith', []).toSet())
        .difference(guestUids);
    }

    // True when the audience of a child's record, with its guests taken out, is the
    // writer's own family. A guest is admitted by being a key of the `guests` map the same write
    // carries, so a uid in `sharedWith` that is neither a guest nor family is a stranger.
    function isMyGuestlessAudience(data) {
      return data.get('sharedWith', []).toSet()
        .difference(data.get('guests', {}).keys().toSet())
        .difference(myAudience())
        .size() == 0;
    }

    // True when every uid the write adds to `sharedWith` is a guest it names.
    function onlyGuestsAdded(before, after) {
      return after.get('sharedWith', []).toSet()
        .difference(before.get('sharedWith', []).toSet())
        .difference(after.get('guests', {}).keys().toSet())
        .size() == 0;
    }

    // True when every uid the write adds to `sharedWith` is a guest it names or the writer's
    // own family — the creator's bound, and `onlyFamilyAdded` with guests allowed for. On the
    // additions rather than the whole list for the reason given there.
    function onlyFamilyOrGuestsAdded(before, after) {
      return after.get('sharedWith', []).toSet()
        .difference(before.get('sharedWith', []).toSet())
        .difference(after.get('guests', {}).keys().toSet())
        .difference(myAudience())
        .size() == 0;
    }

    // ---- Pets ------------------------------------------------------------
    // Shared between a parent pair via the `sharedWith` list, the same shape as
    // `child_info` — a pet moves between the two homes and both parents need its
    // medications, feeding routine and vet. Pets have no guest grants (a sitter is not
    // modelled here), so this block is `child_info` without the guest-expiry gate.
    //
    // As with `child_info`, a list query is served by `whereArrayContains('sharedWith', …)`
    // in `FirestorePetDataSource`, so `allow read` keys on membership. Being in the
    // audience is not permission to write: a writer must be the creator or the creator's
    // partner, and `createdByFirebaseUid` is immutable across an update.
    match /pets/{petId} {
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.get('sharedWith', []);

      // The family bound is `child_info`'s with no guest exception: a pet has no guests, so a
      // `guests` map on a pet document admits nobody — with a family or without one. The child
      // helpers take the `guests` keys out of the audience before bounding it, and on a pet with
      // no family that let any uid in, for ever: the pets read rule checks no grant expiry.
      allow create: if isAuthenticated() &&
                      request.resource.data.createdByFirebaseUid == request.auth.uid &&
                      request.auth.uid in request.resource.data.sharedWith &&
                      request.resource.data.keys().hasAll(['name', 'createdByFirebaseUid', 'sharedWith']) &&
                      isValidLength(request.resource.data.name, 1, 100) &&
                      isMyAudience(request.resource.data.sharedWith) &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                      audienceWithinItsFamily(request.resource.data, noGuests());

      // Same three bounds as `child_info`, and read its comment for why — without guests: the
      // creator may add only family, the co-parent nobody.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.sharedWith &&
                      resource.data.createdByFirebaseUid in request.resource.data.sharedWith &&
                      (
                        (resource.data.createdByFirebaseUid == request.auth.uid &&
                         onlyFamilyAdded(resource.data, request.resource.data) &&
                         familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                         familyKept(resource.data, request.resource.data)) ||
                        (isRecordPartner(resource.data, request.resource.data) &&
                         request.auth.uid in request.resource.data.sharedWith &&
                         addedToAudience(resource.data, request.resource.data, noGuests()).size() == 0)
                      ) &&
                      onlyFamilyAddedToItsFamily(resource.data, request.resource.data, noGuests()) &&
                      request.resource.data.createdByFirebaseUid == resource.data.createdByFirebaseUid;

      allow delete: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid;
    }

    // ---- Family documents (the vault, MON-23) ---------------------------
    // One document per file a parent filed for the family: a court order, a school letter, a
    // passport scan. The document is the *index* of a file in Cloud Storage; the bytes live at
    // `storagePath`, gated by `storage.rules`' `family_documents` block, and this document never
    // carries a download URL — a token URL bypasses Storage rules entirely, so the field is
    // refused by `vaultKeysOnly`.
    //
    // **Shared by definition.** There is no private vault document (item 3 has no counterpart
    // here), so the family is required, not `familyIsMineOrBlank`, and the audience is bounded
    // twice: by `isMyAudience` like every per-document audience since item 23, and by the family
    // id itself, so a parent with two co-parents cannot show one family's court order to the
    // other family's parent.
    //
    // After creation only the title, the category and the tombstone move, and only the uploader
    // moves them. The co-parent reads and can open the file but cannot rename, re-file or delete
    // what the other parent filed: in a product whose records settle disagreements, "who filed
    // this, and is it still what they filed" has to stay answerable. A delete is a tombstone
    // (item 14); `sweepDeletedDocuments` removes the document and its file after 90 days.
    function vaultContentTypes() {
      return ['application/pdf', 'image/jpeg', 'image/png', 'image/heic', 'image/heif',
              'image/webp'];
    }

    function vaultKeysOnly(data) {
      return data.keys().hasOnly(['id', 'familyId', 'createdByFirebaseUid', 'sharedWith',
                                  'title', 'category', 'fileName', 'storagePath',
                                  'contentType', 'sizeBytes', 'sha256', 'createdAtMillis',
                                  'deletedAtMillis', 'deletedBy']);
    }

    function validVaultCategory(category) {
      return category in ['court_order', 'school', 'medical', 'identity', 'other'];
    }

    function validVaultFile(data, docId) {
      return isValidLength(data.fileName, 1, 120) &&
             !data.fileName.matches('.*[/|].*') &&
             data.storagePath ==
               'family_documents/' + data.familyId + '/' + docId + '/' + data.fileName &&
             data.contentType in vaultContentTypes() &&
             data.sizeBytes is int &&
             data.sizeBytes > 0 &&
             data.sizeBytes < 20 * 1024 * 1024 &&
             data.sha256 is string &&
             data.sha256.matches('^[0-9a-f]{64}$') &&
             data.createdAtMillis is int;
    }

    match /family_documents/{docId} {
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.get('sharedWith', []);

      allow create: if isAuthenticated() &&
                      vaultKeysOnly(request.resource.data) &&
                      !('deletedAtMillis' in request.resource.data) &&
                      !('deletedBy' in request.resource.data) &&
                      request.resource.data.id == docId &&
                      request.resource.data.createdByFirebaseUid == request.auth.uid &&
                      // A live family only: an ended family's vault stays readable by both
                      // parents (unpair no longer narrows it) and takes nothing new.
                      isLiveFamilyMember(request.resource.data.familyId) &&
                      request.auth.uid in request.resource.data.sharedWith &&
                      isMyAudience(request.resource.data.sharedWith) &&
                      request.resource.data.sharedWith.toSet()
                        .difference(request.resource.data.familyId.split('__').toSet())
                        .size() == 0 &&
                      isValidLength(request.resource.data.title, 1, 200) &&
                      validVaultCategory(request.resource.data.category) &&
                      validVaultFile(request.resource.data, docId);

      allow update: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid &&
                      vaultKeysOnly(request.resource.data) &&
                      (
                        (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['title', 'category']) &&
                         isValidLength(request.resource.data.title, 1, 200) &&
                         validVaultCategory(request.resource.data.category)) ||
                        (request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['deletedAtMillis', 'deletedBy']) &&
                         request.resource.data.deletedBy == request.auth.uid &&
                         request.resource.data.deletedAtMillis is int)
                      );

      // Tombstones only (item 14). The sweep and account deletion run as admin.
      allow delete: if false;
    }

    // ---- Expenses (receipt sync) --------------------------------------
    // The one collection where "a co-parent of the author" was standing in for "in the same
    // family", and the only real leak a second co-parent opens (docs/DESIGN-multi-family.md,
    // M-4). An expense carries no per-document audience — `splitBetween` is cost-splitting
    // math, not visibility — so the rule asked `isPartnerOf(createdByFirebaseUid)`, which is
    // true for *every* co-parent of the author. A person with two co-parents therefore showed
    // each of them everything they had ever spent, in both families.
    //
    // The audience is now the record's own family. `sharedWith`-style per-document lists were
    // considered and rejected here: an expense would need one written on it, and the field
    // would then have to be pinned against every writer, where `familyId` needs no pinning
    // because it is only ever written by the creator (update below is creator-only).
    //
    // **There is deliberately no `isPartnerOf` fallback for an unstamped document, and the
    // reason is sharper than tidiness: a fallback re-opens the leak it was added to soften.**
    // Firestore validates a *query* by its structure, not by running the rule over the results
    // (CLAUDE.md item 12). While the rule still mentioned `isPartnerOf(createdByFirebaseUid)`
    // on any branch, the old client query — `whereIn('createdByFirebaseUid', [me, partner])` —
    // structurally satisfied it, so Firestore accepted the whole query and handed back both
    // families' expenses. Proved against the emulator: with the branch, that query returned a
    // second family's document; without it, the query is rejected outright.
    //
    // The cost is that a document carrying no `familyId` is readable only by its author. That
    // is why `backfillRecordFamilyIds` must finish **before** these rules are deployed, not
    // after — see the ordered steps in docs/DESIGN-multi-family.md, M-4.
    match /expenses/{expenseId} {
      // Live, not merely named: see `isLiveFamilyMember`. The author keeps their own records.
      allow read: if isAuthenticated() && (
        resource.data.createdByFirebaseUid == request.auth.uid ||
        isLiveFamilyMember(resource.data.get('familyId', ''))
      );

      // The family stamped on it must be the writer's own — see `familyIsMineOrBlank`. Before
      // that bound any account could file an expense into somebody else's ledger.
      allow create: if isAuthenticated() &&
                      request.resource.data.createdByFirebaseUid == request.auth.uid &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', ''));

      // Creator-only, matching delete (owner decision, Aug 2026 walkthrough: a co-parent
      // must not be able to rewrite the other's recorded expense). The partner still reads.
      allow update: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid &&
                      request.resource.data.createdByFirebaseUid == resource.data.createdByFirebaseUid &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                      // The family is the audience here: re-stamping an A expense to B would show
                      // it to B's co-parent at once (`isLiveFamilyMember`).
                      familyKept(resource.data, request.resource.data);

      allow delete: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid;
    }

    // ---- Budgets ---------------------------------------------------------
    // Category spending limits, same posture as `expenses`: only the two paired
    // parents involved may read/write. The document written by
    // `BudgetRepositoryImpl.addBudget()` previously carried no owner field at all
    // (not even a broken `sharedWith`), so an unfiltered query synced every user's
    // budgets under the old permissive rules and would have been denied outright,
    // structurally, by any non-trivial rule under the strict ones. Fixed the same
    // way as `expenses`: the client now stamps `createdByFirebaseUid` on write and
    // filters its read query on it; the rule gates on that field plus `isPartnerOf`.
    match /budgets/{budgetId} {
      // Same move as `expenses` above, and read its comment for why: a budget carries no
      // audience either, so `isPartnerOf(author)` showed both of a person's co-parents every
      // budget they had ever set.
      allow read: if isAuthenticated() && (
        resource.data.createdByFirebaseUid == request.auth.uid ||
        isLiveFamilyMember(resource.data.get('familyId', ''))
      );

      allow create: if isAuthenticated() &&
                      request.resource.data.createdByFirebaseUid == request.auth.uid &&
                      request.resource.data.keys().hasAll(
                        ['category', 'monthlyLimit', 'createdByFirebaseUid']) &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', ''));

      // Either parent of the budget's own family may edit it — budgets are a shared plan,
      // unlike an expense, which is one parent's record of what they paid. Scoped to the
      // family for the same reason the read is: `isPartnerOf(author)` would let a co-parent
      // from another family rewrite this one's limits.
      allow update: if isAuthenticated() && (
        resource.data.createdByFirebaseUid == request.auth.uid ||
        isLiveFamilyMember(resource.data.get('familyId', ''))
      ) && request.resource.data.createdByFirebaseUid == resource.data.createdByFirebaseUid &&
        request.resource.data.get('familyId', '') == resource.data.get('familyId', '');

      allow delete: if isAuthenticated() &&
                      resource.data.createdByFirebaseUid == request.auth.uid;
    }

    // True when the status in [after] is one the caller may have set: unchanged by anyone, an
    // answer by the addressee, a withdrawal by the requester.
    function changeRequestStatusMove(before, after) {
      return after.get('status', '') == before.get('status', '') ||
             (after.get('status', '') in ['ACCEPTED', 'DECLINED'] &&
              request.auth.uid == before.requestedTo) ||
             (after.get('status', '') == 'CANCELLED' &&
              request.auth.uid == before.requestedBy);
    }

    // True when a change request's `familyId` is blank or names exactly its two parties. A request
    // is between two adults, so its family is a fact about the record (`ChangeRequestRepositoryImpl`
    // derives it from the pair): a request stamped A but addressed to the author's co-parent in B
    // would carry an A event's title and times to B.
    function changeRequestFamilyValid(data) {
      return data.requestedBy != data.requestedTo &&
             withinFamily([data.requestedBy, data.requestedTo].toSet(),
                          data.get('familyId', ''));
    }

    // ---- Change requests ----------------------------------------------
    // Event change requests: only the requester or the addressee may access.
    match /change_requests/{requestId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.requestedBy ||
        request.auth.uid == resource.data.requestedTo
      );

      // Never deleted from a client (security audit, October 2026). A request is the record of
      // what one parent asked and the other answered, and History is derived from it (item 40);
      // a delete either party could make erased it from both phones. No client deletes one —
      // a withdrawal is the `CANCELLED` status — and account deletion runs as admin.
      allow delete: if false;

      // An update is a *decision*, never a rewrite. The two parties, the event and the proposed
      // times are pinned, so the addressee cannot "accept" a request while changing what it
      // asked for, and neither side can re-address it to a third uid who would then hold
      // read/update/delete on it. What may move is the status, when it was answered, and the
      // family stamp a backfill adds — the fields `ChangeRequestRepositoryImpl.updateStatus`
      // actually changes; it writes the whole document, so unchanged keys do not count.
      //
      // **Who decides is pinned too.** Only the addressee answers (`ACCEPTED`, `DECLINED`) and only
      // the requester withdraws (`CANCELLED`) — the values `ChangeRequestStatus.name` writes, and
      // the two paths `ChangeRequestViewModel` offers each side. Before this either party could set
      // any status, so a requester could mark their own request accepted on the addressee's phone.
      // A write that leaves the status alone (the family stamp) is either party's.
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.requestedBy ||
        request.auth.uid == resource.data.requestedTo
      ) && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'respondedAt', 'familyId']) &&
        familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
        // The stamp may fill a blank, with the two parties' own family, and never move.
        familyKept(resource.data, request.resource.data) &&
        changeRequestFamilyValid(request.resource.data) &&
        changeRequestStatusMove(resource.data, request.resource.data);

      // A request must be authored by the caller and addressed to their live co-parent.
      //
      // The condition used to accept either field naming the caller, which allowed both halves
      // of a forgery. Naming *yourself as the addressee* let anybody write a request stamped
      // `requestedBy: <victim>` — and `FirestoreChangeRequestDataSource` subscribes to both
      // fields, so it landed in the victim's inbox as a request they appear to have sent
      // themselves, while the forger kept read/update/delete on it. Naming yourself as the
      // author let anybody address free-form text to *any* uid, co-parent or not: an inbox
      // reachable by strangers, in an app whose users are people who may be avoiding one.
      allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.requestedBy &&
                      isPartnerOf(request.resource.data.requestedTo) &&
                      familyIsMineOrBlank(request.resource.data.get('familyId', '')) &&
                      changeRequestFamilyValid(request.resource.data);
    }

    // ---- Request clocks (phase 3a) -------------------------------------
    // `request_deadlines/{clockId}` — the clock of one request that waits on the other parent: a
    // day swap, a change request, an event awaiting acceptance, a custody proposal, an expense
    // split proposal (`family_settings`, October 2026). It holds the
    // deadline the proposer chose, the first moment the request would change something (the
    // cap), and the marks the two phones add as the request is received, opened, reminded about,
    // given a last chance and closed. The design is
    // docs/superpowers/specs/2026-10-15-zuzana-feedback-phase-3a-requests-never-hang-design.md §5;
    // the client's one definition of the stored shape is `RequestDeadlineDocument`.
    //
    // **A document of its own, because the request's record cannot take a new key.** A change
    // request's update rule admits three fields, the custody document's swap and proposal writes
    // are closed lists, and an older build rewrites a whole change request when it answers. So
    // an older build never reads or writes this collection, and **nothing here refuses an
    // answer**: `change_requests`, `custody_models` and `events` are untouched, and a co-parent
    // on an older build answers a request whatever its clock says (spec §5.5). A request whose
    // clock never arrives behaves as one without a clock.
    //
    // **Two writers, and each field has one.** The proposer creates the clock, gives a last
    // chance, and closes it. The answering parent's phone records when it received the clock
    // (with the reminders it planned, in one write), when the parent first opened the request,
    // and each reminder it showed. Every update is exactly one of those five shapes, each bounded
    // by `diff().affectedKeys()`: the deadline, the cap, the two parents and the creation time
    // never move once written, a field written once is not written again, and neither parent
    // writes the other's.
    //
    // **The server's clock stamps what the server has to vouch for.** `createdAt`, `lastChanceAt`
    // and `closedAt` are `FieldValue.serverTimestamp()`, pinned to `request.time` as
    // `event_versions.recordedAt` is: a millis value a client chose, bounded to minutes of
    // `request.time`, would be refused whenever an offline phone's queue lands hours later. What
    // a phone reads off its own clock — when it received the clock, when it opened the request,
    // where a last chance ends — is epoch millis checked against the server's, with five minutes
    // either way because device clocks drift. Either way matters: a clock that is a little wrong
    // is wrong by the same amount on every retry, so a bound with room on one side only refuses
    // such a phone for good. The reminders get none: they are planned from the document's own
    // `createdAt` and deadline, so they are checked against those, exactly.

    // The farthest deadline a clock may carry: 31 days past the write. The app clamps itself to
    // 30 (`AnswerBy.MAX_AHEAD_MILLIS`); the day between is for a phone whose clock runs fast.
    function requestClockMaxAheadMillis() {
      return 31 * 24 * 60 * 60 * 1000;
    }

    // How far a phone's own clock may be from the server's, behind or ahead: five minutes.
    function requestClockSkewMillis() {
      return 5 * 60 * 1000;
    }

    // The longest a last chance may run, counted from the moment it is given: 24 hours.
    function requestClockLastChanceMillis() {
      return 24 * 60 * 60 * 1000;
    }

    // The id a clock must carry, built from the caller and the clock's own fields: its kind, the
    // proposer's uid and the reference it times — and for a proposal or a split the family too,
    // because their reference is a timestamp, unique only within one family's custody document or
    // `family_settings` document. `RequestDeadlineId` builds the same string on the client.
    //
    // The proposer's uid is in the id because the other parent can see the rest of it. Rebuilt
    // here from the *caller*, it stops the other parent creating a request's clock first and
    // stripping its deadline, or faking an early "No answer". The parts are joined with `_`,
    // which a Firebase uid never contains, so two proposers cannot spell the same id. The create
    // rule checks the kind is one of the five before it asks for the id.
    function requestClockId(data) {
      return data.kind in ['proposal', 'split']
          ? data.kind + '_' + request.auth.uid + '_' + data.familyId + '_' + data.ref
          : data.kind + '_' + request.auth.uid + '_' + data.ref;
    }

    // A new clock: the proposer's, for a request to their live co-parent, with the required keys,
    // the optional ones and nothing that is written later.
    //
    // **`createdAt` is the server's.** The client writes `FieldValue.serverTimestamp()`, which is
    // exactly `request.time`; a time it chose is refused.
    //
    // **The family is one the caller is in, that still exists and that names two adults**, and
    // the responder is the other one: `isLiveFamilyMember` reads the id and the existence of
    // `families/{id}` (unpair deletes it), the `split` is the same read of the id, and a pair's id
    // always has exactly two parts (`FamilyKey.of`). So a clock can neither address a stranger
    // nor outlive the relationship it was made in.
    //
    // **An optional field is absent, not null**: the writer leaves it out (`capMillis` when
    // nothing ahead would change, `firstDate` and `dayCount` for everything but a swap).
    function requestClockCreateValid(clockId, data) {
      return data.keys().hasAll(['kind', 'ref', 'familyId', 'proposerUid', 'responderUid',
                                 'participants', 'createdAt', 'answerByMillis']) &&
             data.keys().hasOnly(['kind', 'ref', 'familyId', 'proposerUid', 'responderUid',
                                  'participants', 'createdAt', 'answerByMillis',
                                  'capMillis', 'firstDate', 'dayCount']) &&
             data.kind in ['swap', 'change', 'event', 'proposal', 'split'] &&
             isValidLength(data.ref, 1, 100) &&
             data.familyId is string &&
             clockId == requestClockId(data) &&
             data.proposerUid == request.auth.uid &&
             isLiveFamilyMember(data.familyId) &&
             data.familyId.split('__').size() == 2 &&
             data.responderUid in data.familyId.split('__') &&
             data.responderUid != request.auth.uid &&
             data.participants is list &&
             data.participants.size() == 2 &&
             request.auth.uid in data.participants &&
             data.responderUid in data.participants &&
             data.createdAt == request.time &&
             data.answerByMillis is int &&
             data.answerByMillis > request.time.toMillis() &&
             data.answerByMillis <= request.time.toMillis() + requestClockMaxAheadMillis() &&
             (!('capMillis' in data) ||
              (data.capMillis is int && data.capMillis > data.answerByMillis)) &&
             (!('firstDate' in data) || isValidLength(data.firstDate, 10, 10)) &&
             (!('dayCount' in data) ||
              (data.dayCount is int && data.dayCount >= 1 && data.dayCount <= 366));
    }

    // One reminder of the plan: absent past the plan's length, otherwise a whole number of millis
    // between the clock's creation and its deadline. Rules cannot loop over a list and a plan
    // holds three at most, so the plan's write asks this of places 0, 1 and 2.
    function requestClockReminderValid(times, place, fromMillis, toMillis) {
      return times.size() <= place ||
             (times[place] is int && times[place] >= fromMillis && times[place] <= toMillis);
    }

    // The answering parent's phone recording that it received the clock and the reminders it
    // planned, in one write and once: all three keys arrive together, none was there before (a
    // `hasAll` on the diff alone would pass for a key that merely changed).
    function requestClockPlanWrite(before, after) {
      return request.auth.uid == before.responderUid &&
             after.diff(before).affectedKeys().hasOnly(
               ['deliveredAtMillis', 'remindersPlanned', 'reminderTimesMillis']) &&
             after.diff(before).affectedKeys().hasAll(
               ['deliveredAtMillis', 'remindersPlanned', 'reminderTimesMillis']) &&
             !('deliveredAtMillis' in before) &&
             !('remindersPlanned' in before) &&
             !('reminderTimesMillis' in before) &&
             after.deliveredAtMillis is int &&
             // Stamped by the phone's own clock about a second after the server created the clock,
             // so a phone that runs behind stamps a moment before `createdAt`: room for that.
             after.deliveredAtMillis >= before.createdAt.toMillis() - requestClockSkewMillis() &&
             after.deliveredAtMillis <= request.time.toMillis() + requestClockSkewMillis() &&
             after.remindersPlanned is int &&
             after.remindersPlanned >= 0 &&
             after.remindersPlanned <= 3 &&
             after.reminderTimesMillis is list &&
             after.reminderTimesMillis.size() == after.remindersPlanned &&
             requestClockReminderValid(after.reminderTimesMillis, 0,
                                       before.createdAt.toMillis(), before.answerByMillis) &&
             requestClockReminderValid(after.reminderTimesMillis, 1,
                                       before.createdAt.toMillis(), before.answerByMillis) &&
             requestClockReminderValid(after.reminderTimesMillis, 2,
                                       before.createdAt.toMillis(), before.answerByMillis);
    }

    // The answering parent opening the request for the first time: once, and as the phone's own
    // clock reads it — no more than the skew before the clock was created and no more than the
    // skew past the server's time, the same room delivery has and for the same reason.
    function requestClockOpeningWrite(before, after) {
      return request.auth.uid == before.responderUid &&
             after.diff(before).affectedKeys().hasOnly(['seenAtMillis']) &&
             after.diff(before).affectedKeys().hasAll(['seenAtMillis']) &&
             !('seenAtMillis' in before) &&
             after.seenAtMillis is int &&
             after.seenAtMillis >= before.createdAt.toMillis() - requestClockSkewMillis() &&
             after.seenAtMillis <= request.time.toMillis() + requestClockSkewMillis();
    }

    // The answering parent's phone counting a reminder it showed: one more than the last, never
    // above what it planned. A clock with no plan has nothing to count. `increment(1)` arrives
    // here as the value it produces, so the app's write and a plain value are judged alike.
    function requestClockReminderShownWrite(before, after) {
      return request.auth.uid == before.responderUid &&
             after.diff(before).affectedKeys().hasOnly(['remindersShown']) &&
             after.diff(before).affectedKeys().hasAll(['remindersShown']) &&
             after.remindersShown is int &&
             after.remindersShown == before.get('remindersShown', 0) + 1 &&
             after.remindersShown <= before.get('remindersPlanned', 0);
    }

    // The proposer's last chance, given once, after the deadline and before the clock was closed.
    // The server stamps when it was given; it ends within 24 hours of that and, when the request
    // has a cap, no later than the cap — a last chance must not outlive the thing it decides.
    //
    // **The 24 hours get the skew on top.** The proposer's phone ends a last chance a day from its
    // own now (`RequestClock.lastChanceWindowMillis`), and this measures the day from the server's:
    // a phone whose clock leads the server's by more than the write's latency would otherwise send
    // an end past the bound on every retry. The cap gets none — it is a stored time, not a clock
    // reading, and the phone ends a last chance an hour before it.
    function requestClockLastChanceWrite(before, after) {
      return request.auth.uid == before.proposerUid &&
             after.diff(before).affectedKeys().hasOnly(['lastChanceAt', 'lastChanceUntilMillis']) &&
             after.diff(before).affectedKeys().hasAll(['lastChanceAt', 'lastChanceUntilMillis']) &&
             !('lastChanceAt' in before) &&
             !('lastChanceUntilMillis' in before) &&
             !('outcome' in before) &&
             request.time.toMillis() > before.answerByMillis &&
             after.lastChanceAt == request.time &&
             after.lastChanceUntilMillis is int &&
             after.lastChanceUntilMillis > request.time.toMillis() &&
             after.lastChanceUntilMillis <=
               request.time.toMillis() + requestClockLastChanceMillis() +
               requestClockSkewMillis() &&
             (!('capMillis' in before) || after.lastChanceUntilMillis <= before.capMillis);
    }

    // The proposer closing the clock because nobody answered: once, after the deadline, with the
    // one outcome there is and the server's stamp of when. The outcome is the only state a clock
    // stores; the rest is derived on each phone from the times.
    //
    // With a single legal outcome a second closure could never *change* `outcome`, so `hasAll` on
    // the diff would already refuse it. The explicit absent-before checks say "once" without
    // leaning on that, and keep it true on the day a second outcome is allowed.
    function requestClockClosureWrite(before, after) {
      return request.auth.uid == before.proposerUid &&
             after.diff(before).affectedKeys().hasOnly(['outcome', 'closedAt']) &&
             after.diff(before).affectedKeys().hasAll(['outcome', 'closedAt']) &&
             !('outcome' in before) &&
             !('closedAt' in before) &&
             request.time.toMillis() > before.answerByMillis &&
             after.outcome == 'no_answer' &&
             after.closedAt == request.time;
    }

    match /request_deadlines/{clockId} {
      // The two parents, and only them. Firestore judges a list by its structure, so a query has
      // to be keyed on `participants` with the caller's uid (`array-contains`) — the app adds the
      // family, or a deadline, as a second filter. A `get` of a clock that does not exist is a
      // permission error, not "not found", as it is for `change_requests`: a reader treats it as
      // no clock.
      //
      // **Keyed on `participants` alone, on purpose**, with no live-family check: a clock stays
      // readable to both parents after they unpair, as `event_versions` and the chat do (spec
      // §5.2). It is part of what the two of them recorded about a request, and a "No answer" in
      // History must not vanish from one phone because the relationship ended. Creating a clock
      // still needs a live family.
      allow get, list: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() &&
                      requestClockCreateValid(clockId, request.resource.data);

      allow update: if isAuthenticated() && (
        requestClockPlanWrite(resource.data, request.resource.data) ||
        requestClockOpeningWrite(resource.data, request.resource.data) ||
        requestClockReminderShownWrite(resource.data, request.resource.data) ||
        requestClockLastChanceWrite(resource.data, request.resource.data) ||
        requestClockClosureWrite(resource.data, request.resource.data)
      );

      // Nobody. Account deletion removes a departing parent's clocks as the server, which
      // bypasses these rules.
      allow delete: if false;
    }

    // ---- Payments between the parents (25 October 2026) -------------------
    // `payments/{familyId}__{kind}__{yyyy-MM}__{currency}`: the payer says they paid, the parent
    // paid says the money arrived. Each step is written by the parent it is about, once, with the
    // server's clock, so neither can say the other paid or received. Kept as the family's history
    // after an unpair; account deletion removes the departing parent's, as admin.
    function paymentAmountValid(amount) {
      return amount is string && amount.matches('^[0-9]{1,9}[.][0-9]{2}$');
    }

    function paymentCreateValid(paymentId, data) {
      return data.keys().hasOnly(['familyId', 'participants', 'kind', 'month', 'currency', 'amount',
                                  'payerUid', 'payeeUid', 'paidBy', 'paidAt']) &&
             data.keys().hasAll(['familyId', 'participants', 'kind', 'month', 'currency', 'amount',
                                 'payerUid', 'payeeUid', 'paidBy', 'paidAt']) &&
             data.kind in ['expenses', 'support'] &&
             data.month is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') &&
             data.currency is string && data.currency.matches('^[A-Z]{3}$') &&
             paymentAmountValid(data.amount) &&
             paymentId == data.familyId + '__' + data.kind + '__' + data.month + '__' + data.currency &&
             isLiveFamilyMember(data.familyId) &&
             data.payerUid == request.auth.uid &&
             data.paidBy == request.auth.uid &&
             data.payeeUid is string &&
             data.payeeUid != request.auth.uid &&
             data.payeeUid in data.familyId.split('__') &&
             data.participants is list &&
             data.participants.size() == 2 &&
             data.participants.hasAll(data.familyId.split('__')) &&
             data.participants[0] < data.participants[1] &&
             data.paidAt == request.time;
    }

    match /payments/{paymentId} {
      allow get, list: if isAuthenticated() && request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() && paymentCreateValid(paymentId, request.resource.data);

      // The payee confirms, once, while the family is live. Nothing else ever changes.
      allow update: if isAuthenticated() &&
                      resource.data.payeeUid == request.auth.uid &&
                      !('confirmedAt' in resource.data) &&
                      isLiveFamilyMember(resource.data.familyId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['confirmedAt', 'confirmedBy']) &&
                      request.resource.data.confirmedAt == request.time &&
                      request.resource.data.confirmedBy == request.auth.uid;

      allow delete: if false;
    }

    // ---- Child support (25 October 2026) -----------------------------------
    // `support_agreements/{familyId}`: the agreed monthly amount, day and payer, and at most one
    // proposal. Money is never set for somebody else: even the first agreement is a proposal the
    // other parent accepts, copying it field for field. Unpair and account deletion remove it.
    function supportTermsValid(terms, participants) {
      return terms.amount is string && terms.amount.matches('^[0-9]{1,9}[.][0-9]{2}$') &&
             terms.currency is string && terms.currency.matches('^[A-Z]{3}$') &&
             terms.dayOfMonth is int && terms.dayOfMonth >= 1 && terms.dayOfMonth <= 28 &&
             terms.payerUid is string && terms.payerUid in participants &&
             terms.fromMonth is string && terms.fromMonth.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function supportProposalValid(proposal, participants) {
      return proposal is map &&
             proposal.keys().hasOnly(['amount', 'currency', 'dayOfMonth', 'payerUid', 'fromMonth',
                                      'proposedBy', 'proposedAtMillis']) &&
             proposal.keys().hasAll(['amount', 'currency', 'dayOfMonth', 'payerUid', 'fromMonth',
                                     'proposedBy', 'proposedAtMillis']) &&
             supportTermsValid(proposal, participants) &&
             proposal.proposedBy == request.auth.uid &&
             proposal.proposedAtMillis is int;
    }

    function supportAcceptance(before, after) {
      return 'proposal' in before &&
             before.proposal.proposedBy != request.auth.uid &&
             !('proposal' in after) &&
             after.agreement is map &&
             after.agreement.keys().hasOnly(['amount', 'currency', 'dayOfMonth', 'payerUid', 'fromMonth']) &&
             after.agreement.amount == before.proposal.amount &&
             after.agreement.fromMonth == before.proposal.fromMonth &&
             after.agreement.currency == before.proposal.currency &&
             after.agreement.dayOfMonth == before.proposal.dayOfMonth &&
             after.agreement.payerUid == before.proposal.payerUid &&
             after.diff(before).affectedKeys().hasOnly(['agreement', 'proposal', 'lastModifiedBy']);
    }

    function supportProposalOnly(before, after) {
      return supportProposalValid(after.proposal, before.participants) &&
             (!('proposal' in before) || before.proposal.proposedBy == request.auth.uid) &&
             after.diff(before).affectedKeys().hasOnly(['proposal', 'lastModifiedBy']);
    }

    // A decline by the other parent or a withdrawal by the proposer: the proposal goes, the
    // agreement stays as it was.
    function supportProposalCleared(before, after) {
      return 'proposal' in before &&
             !('proposal' in after) &&
             after.diff(before).affectedKeys().hasOnly(['proposal', 'lastModifiedBy']);
    }

    match /support_agreements/{familyId} {
      allow get: if isFamilyMember(familyId) &&
                    (resource == null || request.auth.uid in resource.data.participants);

      allow create: if isLiveFamilyMember(familyId) &&
                      request.resource.data.keys().hasOnly(['participants', 'proposal', 'lastModifiedBy']) &&
                      request.resource.data.participants is list &&
                      request.resource.data.participants.size() == 2 &&
                      request.resource.data.participants.hasAll(familyId.split('__')) &&
                      request.resource.data.participants[0] < request.resource.data.participants[1] &&
                      request.resource.data.lastModifiedBy == request.auth.uid &&
                      supportProposalValid(request.resource.data.proposal, request.resource.data.participants);

      allow update: if isLiveFamilyMember(familyId) &&
                      request.auth.uid in resource.data.participants &&
                      request.resource.data.participants == resource.data.participants &&
                      request.resource.data.lastModifiedBy == request.auth.uid &&
                      (supportProposalOnly(resource.data, request.resource.data) ||
                       supportAcceptance(resource.data, request.resource.data) ||
                       supportProposalCleared(resource.data, request.resource.data));

      allow delete: if false;
    }

    // ---- Stickers ------------------------------------------------------
    // A small badge one parent receives (October 2026, owner decision;
    // docs/DESIGN-stickers-and-subscription.md): from the co-parent, or from the app for answering
    // on time. Seen by its receiver, and by a parent sender as delivered — never by anybody else,
    // and not part of the chat or the export.
    //
    // Two shapes of create, nothing else. **A parent's sticker** goes from the caller to the other
    // parent of a family that still exists, in one of the fixed phrases (no free text, so nothing
    // can be turned into sarcasm). **The app's sticker** is the caller's own, under an id that
    // spells the caller, the kind and the ISO week — so it is create-once per week, a second
    // create being an update the update rule refuses. The app's stickers are not checked against
    // the request clocks here: a phone that awards itself a sticker it did not earn shows it to
    // nobody but itself.
    function isParentStickerKind(kind) {
      return kind in ['great_parent', 'thank_you', 'kids_happy', 'good_team', 'well_done',
                      'patience', 'flexible'];
    }

    function isAppStickerKind(kind) {
      return kind in ['on_time', 'regular'];
    }

    function stickerCreateValid(stickerId, data) {
      return data.keys().hasOnly(['to', 'from', 'participants', 'familyId', 'kind', 'createdAt']) &&
             data.keys().hasAll(['to', 'from', 'participants', 'familyId', 'kind', 'createdAt']) &&
             data.createdAt == request.time &&
             data.to is string &&
             data.familyId is string &&
             ((data.from == request.auth.uid &&
               data.to != request.auth.uid &&
               isParentStickerKind(data.kind) &&
               isLiveFamilyMember(data.familyId) &&
               data.to in data.familyId.split('__') &&
               data.participants is list &&
               data.participants.size() == 2 &&
               data.participants.toSet() == [data.from, data.to].toSet()) ||
              (data.from == 'app' &&
               data.to == request.auth.uid &&
               isAppStickerKind(data.kind) &&
               data.participants == [request.auth.uid] &&
               (data.familyId == '' || isFamilyMember(data.familyId)) &&
               stickerId.matches('app_' + request.auth.uid + '_' + data.kind + '_[0-9]{4}-W[0-9]{2}')));
    }

    match /stickers/{stickerId} {
      // Its receiver and, for a parent's sticker, its sender. A list is keyed on `to` (the
      // receiver's shelf) or `from` (what this parent sent).
      allow get, list: if isAuthenticated() &&
                         (resource.data.to == request.auth.uid ||
                          resource.data.from == request.auth.uid);

      allow create: if isAuthenticated() && stickerCreateValid(stickerId, request.resource.data);

      // The receiver marks it seen, once, with the server's clock. Nothing else ever changes.
      allow update: if isAuthenticated() &&
                      resource.data.to == request.auth.uid &&
                      !('seenAt' in resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']) &&
                      request.resource.data.seenAt == request.time;

      // Nobody. Unpair removes a family's stickers and account deletion a departing parent's, as
      // the server.
      allow delete: if false;
    }

    // ---- Invitations ---------------------------------------------------
    // A single document backs the short code, the QR image and the share
    // link. Redemption goes through the acceptPairingInvitation callable —
    // the Admin SDK there is what looks a code up, so clients never need to
    // read invitations addressed to somebody else.
    // Shape check for the `kind` field that tells a guest invitation from a co-parent one.
    //
    // Absent means co-parent: every invitation written before guests existed carries no
    // `kind`, and those must keep pairing. Any *other* value is refused outright rather than
    // treated as co-parent — a document this file does not understand is not one it should
    // let a callable act on later.
    //
    // A guest invitation additionally names the child record it opens and the instant the
    // grant ends, and that instant must still be in the future when the document is written.
    // None of this is the real gate: `acceptGuestInvitation` re-checks every one of these
    // with Admin credentials, and it also checks the thing rules cannot cheaply check — that
    // the inviter holds the named record as a parent rather than as a guest. This only stops
    // a malformed invitation existing in the first place.
    // A **friend** invitation (item 16) names no child record — it opens the whole calendar of
    // one family — so it carries the grant's end instant, which must still be in the future, and
    // the family, one the inviter is in. Like the guest kind, this only stops a malformed document
    // existing;
    // `acceptCalendarFriendInvitation` re-checks everything with Admin credentials, including
    // the thing rules cannot cheaply check: that the inviter is a *paired parent*.
    // A **professional** invitation (MON-18) names the family it opens — one the inviter is in —
    // the profession, and an end no more than 180 days out. `acceptProfessionalInvitation`
    // re-checks all of it, clamps the end again, and checks the family is still a live pairing.
    function validInvitationKind(data) {
      return !data.keys().hasAny(['kind']) || (
        data.kind == 'guest' &&
        data.keys().hasAll(['childInfoId', 'guestExpiresAt']) &&
        data.childInfoId is string &&
        data.childInfoId.size() > 0 &&
        data.guestExpiresAt is number &&
        data.guestExpiresAt > request.time.toMillis()
      ) || (
        // A friend invitation names the family it opens, one the inviter is in. Without it the
        // callable had to guess, and its guess — the inviter's singular `partnerId`, which the
        // server keeps on the *first* co-parent — admitted a friend meant for family B to family
        // A's calendar, which A's other parent never chose.
        data.kind == 'friend' &&
        data.keys().hasAll(['friendExpiresAt', 'familyId']) &&
        data.friendExpiresAt is number &&
        data.friendExpiresAt > request.time.toMillis() &&
        isFamilyMember(data.familyId)
      ) || (
        data.kind == 'professional' &&
        data.keys().hasAll(['professionalRole', 'professionalExpiresAt', 'familyId']) &&
        isProfessionalRole(data.professionalRole) &&
        data.professionalExpiresAt is number &&
        data.professionalExpiresAt > request.time.toMillis() &&
        data.professionalExpiresAt <= request.time.toMillis() + professionalMaxMillis() &&
        isFamilyMember(data.familyId)
      );
    }

    // The professions a `professional` invitation may name (MON-18). A label, not a permission:
    // every role reads the same two things. Listed so the stored value is one the app can word.
    function isProfessionalRole(role) {
      return role in ['mediator', 'lawyer', 'guardian_ad_litem', 'therapist', 'other'];
    }

    // The longest a professional grant may run: 180 days, in millis. The same constant is
    // `PROFESSIONAL_MAX_DAYS` in functions/index.js and `ProfessionalGrantPolicy.MAX_DURATION_DAYS`
    // on the client; the callable clamps to it again, so this only stops a malformed offer.
    function professionalMaxMillis() {
      return 180 * 24 * 60 * 60 * 1000;
    }

    // True when the caller's token carries an address Firebase has actually verified.
    //
    // `request.auth.token.email` alone is not evidence of anything: Firebase issues it for an
    // email/password account the moment it is registered, with no verification step, so anybody
    // may hold a token claiming an address that is not theirs. This file used to gate invitation
    // access on exactly that claim, which meant an attacker who knew the victim's address could
    // register it unverified, read the pending invitation addressed to it — **including its
    // `code`, which is a bearer credential for the whole family** — and redeem it, or simply set
    // it to `rejected` and quietly break the pairing. Google sign-in carries a verified address,
    // so the ordinary path is unaffected.
    function hasVerifiedEmail() {
      return request.auth.token.get('email_verified', false) == true &&
             request.auth.token.get('email', null) != null;
    }

    // The longest an invitation code may live: eight days, in millis. See the create rule.
    function invitationMaxMillis() {
      return 8 * 24 * 60 * 60 * 1000;
    }

    // What an invitation says about its sender is the sender's own (security audit, October
    // 2026). `fromUserEmail` is what the recipient's incoming-invite card shows beside the name
    // and accepts on, so a free-text one let a stranger who knew the victim's address send an
    // invitation "from" the ex's email; it must be the caller's own sign-in address, or blank.
    // `fromUserName` stays the sender's choice — `users/{uid}.name` is too — and is only bounded
    // (256: the app falls back to the address when there is no name).
    function invitationSenderTruthful(data) {
      return (!data.keys().hasAny(['fromUserEmail']) ||
              data.fromUserEmail == '' ||
              data.fromUserEmail == request.auth.token.get('email', '')) &&
             (!data.keys().hasAny(['fromUserName']) ||
              (data.fromUserName is string && data.fromUserName.size() <= 256));
    }

    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        (hasVerifiedEmail() && resource.data.toEmail == request.auth.token.email)
      );

      allow create: if isAuthenticated() &&
                      request.resource.data.fromUserId == request.auth.uid &&
                      request.resource.data.keys().hasAll(
                        ['code', 'toEmail', 'status', 'createdAt', 'expiresAt']) &&
                      isValidLength(request.resource.data.code, 6, 6) &&
                      request.resource.data.status == 'pending' &&
                      // A number in the future, like the guest and friend expiries below. The
                      // callables enforce expiry only when the field *is* a number, so an inviter
                      // could mint a code that never expired by writing a string here — and a
                      // six-character code that never expires is one a brute force eventually finds.
                      request.resource.data.expiresAt is number &&
                      request.resource.data.expiresAt > request.time.toMillis() &&
                      // And not far in the future (security audit, October 2026): the app's
                      // longest code lives seven days, and a code that lives a year is a year of
                      // guesses. Eight days leaves a day for a phone whose clock runs ahead.
                      request.resource.data.expiresAt <= request.time.toMillis() + invitationMaxMillis() &&
                      invitationSenderTruthful(request.resource.data) &&
                      validInvitationKind(request.resource.data);

      // The inviter may withdraw their own invite (status -> cancelled); the
      // addressed recipient may decline it (status -> rejected). Accept goes
      // through the callable, which bypasses rules with Admin credentials.
      allow update: if isAuthenticated() &&
                      (
                        (resource.data.fromUserId == request.auth.uid &&
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'cancelled' &&
                         request.resource.data.code == resource.data.code &&
                         request.resource.data.toEmail == resource.data.toEmail &&
                         request.resource.data.expiresAt == resource.data.expiresAt &&
                         request.resource.data.fromUserId == resource.data.fromUserId &&
                         request.resource.data.createdAt == resource.data.createdAt) ||
                        (hasVerifiedEmail() &&
                         resource.data.toEmail == request.auth.token.email &&
                         resource.data.status == 'pending' &&
                         request.resource.data.status == 'rejected' &&
                         request.resource.data.code == resource.data.code &&
                         request.resource.data.toEmail == resource.data.toEmail &&
                         request.resource.data.expiresAt == resource.data.expiresAt &&
                         request.resource.data.fromUserId == resource.data.fromUserId &&
                         request.resource.data.createdAt == resource.data.createdAt)
                      );

      allow delete: if isAuthenticated() &&
                      resource.data.fromUserId == request.auth.uid;
    }

    // ---- Notification queue -------------------------------------------
    // Drained by the `sendNotification` Cloud Function; clients may only enqueue.
    //
    // A queued document carries `targetUserId` plus a free-form `data.title`/`data.body`
    // that `sendNotification` now delivers data-only for the client to render verbatim.
    // While `create` was open to any authenticated caller, anyone who learned another
    // user's UID could push arbitrary notification text to them — a phishing primitive in
    // an app about family conflict. A client may now only notify itself or its real
    // co-parent, using the same `isPartnerOf` relationship the rest of this file gates on.
    //
    // The Cloud Functions that write here (`acceptPairingInvitation`, `unpairCoParent`,
    // `notifyOfChatMessage` and the other callables and triggers) all use the Admin SDK, which bypasses
    // security rules entirely, so this restriction does not affect them.
    // Types a client may enqueue. An **allow-list**, and the asymmetry is the point: forgetting
    // to add a new client type here makes its push fail to enqueue, which is obvious, while
    // forgetting to add a new server-only type to a deny-list would let any co-parent forge it,
    // which is not. `pairing_accepted`, `pairing_removed` and `chat_message` are absent because
    // only Cloud Functions produce them, and those write as admin and bypass these rules — so a
    // co-parent cannot announce a pairing that did not happen, or a chat message they did not
    // send under a name that is not theirs.
    //
    // The same list lives in `PushPayload.CLIENT_TYPES` on the client; this is the half that is
    // enforced.
    // A write that only touches the proposal and its outcome.
    //
    // The agreed share and its author must both be untouched — that is what stops a proposal
    // write from moving the money in silence, the same shape
    // `proposalWriteTouchesOnlyProposal` gives the custody document. `participants` is compared
    // by the caller.
    function ratioProposalOnly(before, after) {
      return after.momShareBasisPoints == before.momShareBasisPoints &&
             after.get('lastModifiedBy', '') == before.get('lastModifiedBy', '') &&
             after.get('lastModifiedAtMillis', 0) == before.get('lastModifiedAtMillis', 0) &&
             // A proposal left on the document must be the caller's own. Without this pin a
             // parent could write a proposal credited to the co-parent and then, in a second
             // write, "accept" it themselves — `ratioAcceptance` only asks that the proposer not
             // be the acceptor — and re-price every future expense alone. The whole point of
             // this document is that money moves by agreement, never by announcement.
             (!('proposal' in after) || after.proposal == null ||
              after.proposal.get('proposedBy', '') == request.auth.uid);
    }

    // Whether the write is the caller taking up the **co-parent's** proposal.
    //
    // This is the *only* update that may move the agreed share, and that is the whole difference
    // between this document and `custody_models`. A custody pattern is last-write-wins with a
    // banner; money is not. Requiring "the caller stamped themselves" the way the custody rule
    // does would have let either parent re-price every future expense on their own and told the
    // other only through a notification — an announcement, not an agreement.
    //
    // Four conditions, and each one closes a way round it: there must be a proposal to accept;
    // the caller must not be the one who made it; the new share must be exactly the proposed one
    // (so an "acceptance" cannot smuggle in a third figure); and the proposal must be cleared, so
    // the same one cannot be accepted twice at two different values.
    //
    // The proposal is tested for null as well as for absence: the client writes the whole
    // document, which omits the key, but a partial `update({proposal: null})` stores an explicit
    // null, and both mean "there is no longer a proposal".
    function ratioAcceptance(before, after, uid) {
      return 'proposal' in before &&
             before.proposal != null &&
             before.proposal.proposedBy != uid &&
             after.momShareBasisPoints == before.proposal.momShareBasisPoints &&
             after.lastModifiedBy == uid &&
             (!('proposal' in after) || after.proposal == null);
    }

    function isClientPushType(type) {
      return type in [
        'event_created', 'event_updated', 'event_deleted', 'event_important',
        'sticker_received',
        'child_info_updated',
        'change_request_created', 'change_request_accepted',
        'change_request_declined', 'change_request_cancelled',
        'custody_proposal_proposed', 'custody_proposal_accepted', 'custody_proposal_declined',
        'day_swap_offered', 'day_swap_accepted', 'day_swap_declined',
        'day_swap_group_offered', 'day_swap_group_accepted', 'day_swap_group_declined',
        'split_ratio_proposed', 'split_ratio_accepted', 'split_ratio_declined',
        'split_ratio_agreed',
        'records_shared',
        'request_last_chance',
        'expense_added'
      ];
    }

    match /notification_queue/{notificationId} {
      allow read: if false;
      // The addressee check stops a stranger notifying anyone. It does not stop a *live*
      // co-parent, and it cannot: they are entitled to notify you. What the rest adds is a
      // limit on *what they can make the notification say* (SEC-3).
      //
      // **A client may not write `title` or `body` at all.** They used to be the payload: the
      // sending device composed the sentence and `sendNotification` relayed it for the other
      // phone to render verbatim, with the app's own icon, on a lock screen, by someone the
      // user may be trying to keep at a distance. The bounds that used to be here capped how
      // *long* that text could be and nothing else. Now the payload carries a type and a few
      // names, and the receiving device writes the sentence from its own string resources —
      // so the frame cannot be forged, and it arrives in the reader's language rather than the
      // sender's. Refusing the two keys is what keeps a client from going back to the old way.
      //
      // The names that do ride along are still bounded. They are an event's title, a child's
      // name, a parent's display name and an ISO date — all things the co-parent legitimately
      // chooses, so the cap is against a wall of text rather than against the content.
      allow create: if isAuthenticated() &&
                      'targetUserId' in request.resource.data &&
                      (
                        request.resource.data.targetUserId == request.auth.uid ||
                        isPartnerOf(request.resource.data.targetUserId)
                      ) &&
                      isClientPushType(request.resource.data.get('data', {}).get('type', '')) &&
                      !('title' in request.resource.data.get('data', {})) &&
                      !('body' in request.resource.data.get('data', {})) &&
                      isValidLength(request.resource.data.get('data', {}).get('subject', ''), 0, 200) &&
                      isValidLength(request.resource.data.get('data', {}).get('actorName', ''), 0, 100) &&
                      isValidLength(request.resource.data.get('data', {}).get('date', ''), 0, 20) &&
                      // A grouped swap's day count, as a decimal string. Bounded like every
                      // other free-text key: a field the rule does not know about is a field
                      // with no bound.
                      isValidLength(request.resource.data.get('data', {}).get('dayCount', ''), 0, 4) &&
                      // A request's deadline, as epoch millis in decimal text (13 characters
                      // today) - the day-swap, change-request, custody-proposal and split-proposal
                      // pushes carry it so their first notification can say when to answer by, and
                      // a last chance carries where it ends. Bounded like every key a client writes.
                      isValidLength(request.resource.data.get('data', {}).get('answerBy', ''), 0, 20) &&
                      // A new expense's figures (`expense_added`): plain decimals and a currency
                      // code, which the receiving phone formats. Bounded like every key a client
                      // writes.
                      isValidLength(request.resource.data.get('data', {}).get('amount', ''), 0, 24) &&
                      isValidLength(request.resource.data.get('data', {}).get('share', ''), 0, 24) &&
                      isValidLength(request.resource.data.get('data', {}).get('currency', ''), 0, 8) &&
                      isPushFamily(request.resource.data.get('data', {}).get('familyId', ''),
                                   request.resource.data.targetUserId);
      allow update, delete: if false;
    }

    // The family a push belongs to (M-8): absent, or one the sender **and** the addressee are
    // both in. The receiving device switches to it before opening the tap target, so an
    // unbounded or foreign id would be a way to steer somebody's app. Two uids of at most 128
    // characters and the `__` separator is 258, which is the length bound every free-text key
    // here carries; membership is read off the id itself, like `isFamilyMember`, so this costs
    // no document read. The receiving side refuses a family its user is not in regardless
    // (`SelectedFamilySource.select`) — this is the half that is enforced before it is stored.
    function isPushFamily(familyId, targetUserId) {
      return familyId == '' ||
             (isValidLength(familyId, 1, 258) &&
              isFamilyMember(familyId) &&
              targetUserId in familyId.split('__'));
    }

    // ---- Custody -------------------------------------------------------
    // One document per pair, id derived from the two UIDs (CustodyKey / canonicalPairId).
    // `allow get`, deliberately not `allow read`: this collection is read by document id
    // alone, so no `where` filter has to mirror this rule, and spelling it as `get` (which
    // excludes `list`) keeps that structurally true instead of merely conventional — a later
    // `whereArrayContains('participants', uid)` query is rejected outright rather than
    // silently accepted.
    //
    // `participants` is fixed at creation (see `create`) and immutable after (see `update`),
    // so a stale document can't be narrowed the way `events`/`child_info` are swept on unpair.
    // Instead `get`/`update` additionally require the pairing to still be live (`isPartnerOf`)
    // on top of stored membership, so an ex-partner loses access the moment either side's
    // `partnerId` clears. `delete` intentionally stays on stored `participants` alone: a
    // document must remain deletable by either named participant even once the pairing behind
    // it is gone, or a stale/orphaned document becomes permanent by a different route.
    // ---- Families ---------------------------------------------------------
    // One co-parenting relationship: the two adults, and the id every record they share is
    // named with. The id is `FamilyKey.of(uidA, uidB)` — the same string `custody_models`,
    // `family_settings` and `conversations` are already keyed by, which is why those three need
    // no migration at all.
    //
    // **`members` and `slots` are written only by Cloud Functions, never by a client.** The
    // document is the membership, and the membership is the grant: `acceptPairingInvitation`
    // and `unpairCoParent` write it as admin, bypassing rules. A create path open to clients
    // would let anyone name themselves a member of any pair — the same escalation the
    // `users`-array design would have shipped. `slots` is the same kind of value one level
    // down: a parent who could set their own would take the co-parent's colour and re-point
    // what `parentOwner` means across the whole calendar.
    //
    // **`caresFor` is the one exception, and the asymmetry is deliberate.** It says whether
    // this family's app offers child records, pet records or both, per parent, unioned; it
    // decides which sections are drawn and nothing about whose records are whose. A parent
    // already has exactly that authority over `users/{uid}.caresFor`, which is where the field
    // lived before it became a fact about a family rather than about a person
    // (docs/DESIGN-multi-family.md, M-3).
    //
    // Reads are open to the two members. A list is allowed on the same terms, so a client can
    // ask "which families am I in" with one indexed query rather than being told the answer by
    // a field it could have forged: Firestore validates a query's *structure*, so a query
    // filtered on `members array-contains` the caller's own uid is guaranteed to return only
    // documents that would pass, while an unfiltered one is rejected outright.
    match /families/{familyId} {
      allow get: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow list: if isAuthenticated() && request.auth.uid in resource.data.members;

      // A member may edit their own `caresFor` entry, and nothing else. Two nested `hasOnly`
      // checks, because either one alone is not enough: the outer keeps the write away from
      // `members` and `slots`, the inner keeps one parent from answering for the other.
      //
      // `.get('caresFor', {})` on **both** sides. A family created before this field existed
      // carries no such key, and reading a missing key in Rules is an evaluation error, not
      // null — a rule that errors denies, which would lock exactly those pairs out of the
      // first write they need to make. The same hazard that has already bitten this file
      // twice. On the request side it also means a write that removes the key outright diffs
      // as both members' entries changing, and is refused rather than erroring.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.members &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['caresFor']) &&
                      request.resource.data.get('caresFor', {})
                        .diff(resource.data.get('caresFor', {}))
                        .affectedKeys().hasOnly([request.auth.uid]);

      allow create, delete: if false;
    }

    // `parenting_plans/{familyId}` — the two halves of one family's parenting plan (MON-5).
    //
    // One document, two halves. Every field is a map keyed by uid, and each parent writes only
    // their own key: the practice this copies is the paper one, where each parent fills the form
    // in separately and a mediator lays the two side by side. That makes the rule the whole
    // security model — a parent who could edit the other's half could put words in their mouth in
    // a document they may hand to a court.
    //
    // Keyed by `FamilyKey.of`, so `isFamilyMember` decides membership from the id itself with no
    // document read, exactly as `custody_models`' `allow get` does. It also answers correctly for
    // a document that does not exist yet, which is every pair's first read — the screen subscribes
    // before either parent has written anything, and `resource` is null there.
    match /parenting_plans/{planId} {
      // Split from `list` deliberately: nothing queries this collection, and a rule that keys on
      // the document id cannot constrain a query, so allowing `list` would be allowing a scan.
      // A professional with an active grant over this family reads it too (MON-18), and writes
      // nothing: `planHalfIsMine` below keys every write on the caller being a family member.
      allow get: if isFamilyMember(planId) || isProfessionalOf(planId);

      // Create and update are the same intent expressed twice, because `resource` is null on a
      // create and reading through it there is an evaluation error, not null — the hazard this
      // file has already been bitten by more than once. On create the maps must contain nothing
      // but this parent's key; on update the *diff* of each map must touch nothing but it.
      // Writing needs the family still **live** (security audit, October 2026): unpair leaves the
      // plan in place for both parents to read and export, and with `isFamilyMember` alone an
      // ex-partner went on rewriting their half of a document either of them may hand a court.
      allow create: if isLiveFamilyMember(planId) &&
                      planFieldsOnly(request.resource.data) &&
                      planHalfIsMine(request.resource.data);

      allow update: if isLiveFamilyMember(planId) &&
                      planFieldsOnly(request.resource.data) &&
                      planDiffIsMine(request.resource.data, resource.data);

      // A plan is never deleted from a client. Wiping an account is a server-side teardown, and
      // an ordinary delete here would take the co-parent's half with it — the asymmetry
      // `data/sync/Tombstone.kt` exists to prevent, one document up.
      allow list, delete: if false;
    }

    match /custody_models/{modelId} {
      // Two cases, and the missing-document one is not a nicety.
      //
      // `resource` is **null for a document that does not exist**, so
      // `resource.data.participants` raises a Null value error there — and a rule that errors
      // is a rule that denies. `CustodyModelRepository` subscribes its shared listener at
      // startup, before either parent has ever saved a schedule, so the first read of every
      // new pair is a read of a document that is not there. Under the single-clause version
      // that read was denied, the listener failed permanently, and the stream's retry loop
      // spun forever: custody sync could never start for a pair that had not already, somehow,
      // written the document. Both handsets were observed doing exactly this.
      //
      // For the missing case the caller must still be one of the two uids the document id is
      // built from, so this is not an existence oracle for strangers — `canonicalPairId` is
      // derivable from any two uids, and without this clause anyone could probe whether a
      // given pair has a schedule. `isPartnerOf` is deliberately *not* required here: there is
      // no document to protect yet, and demanding a live pairing would deny the empty snapshot
      // to a device whose own pairing write has not landed, which is the same startup race in
      // a different disguise.
      allow get: if isAuthenticated() && (
                   resource == null
                     ? request.auth.uid in modelId.split('__')
                     : (request.auth.uid in resource.data.participants &&
                        (isPartnerOf(resource.data.participants[0]) ||
                         isPartnerOf(resource.data.participants[1])))
                 ) ||
                 // A professional with an active grant over this family (MON-18) reads the
                 // schedule — present or not yet written, so their listener starts cleanly —
                 // and can write none of it: every write below requires a participant.
                 isProfessionalOf(modelId);

      // The id must be the canonical id of the document's own participants. Without this, any
      // authenticated account could create custody_models/{momUid}__{dadUid} with unrelated
      // participants, permanently squatting a pair's document: neither Mom nor Dad could ever
      // pass read/update/delete afterward (all three key on `participants`), and their own
      // genuine `.set()` would be evaluated as an update against someone else's data and
      // denied the same way. Binding the id here, combined with requiring the caller be one
      // of exactly the two named uids, makes that impossible — nobody outside the real pair
      // can ever satisfy this rule at this id. `isPartnerOf` additionally requires the pairing
      // itself to already be live, the same shape `conversations` uses below.
      //
      // `participants[0] < participants[1]` additionally requires the *stored* array itself to
      // be sorted, not merely id-equivalent to a sorted pair: `canonicalPairId` normalises
      // order for the id comparison above, so an unsorted array — e.g. [momUid, dadUid] where
      // dadUid < momUid — passes that check too, since it resolves to the same id either way.
      // But `update` demands exact array equality (below), which is order-sensitive, and every
      // client writes `CustodyKey.of`'s sorted order — so an unsorted stored array would deny
      // every subsequent write forever, with no rule path able to re-sort it back (recovery
      // would need delete-then-recreate, and no client path does that; Task 9 only ever
      // `.set()`s, which Firestore evaluates as `update` over an existing document). This makes
      // the `canonicalPairId` ternary redundant at this call site, but it is left in place —
      // it documents the id/participants relationship and the two call sites stay identical.
      //
      // `lastModifiedBy` must be the caller, on create and on update alike. It is not
      // bookkeeping: `CustodyChangeAnnouncement.toAnnounce` suppresses any change whose
      // `lastModifiedBy` equals the reader's own uid, which is how a device ignores the echo of
      // its own write. Unvalidated, either parent could overwrite the shared schedule while
      // stamping the *other's* uid on it, and the co-parent's phone would file the change as its
      // own echo and never raise the banner — defeating the spec's "last write wins, but never
      // silently" with one field, in a product whose premise is an adversarial counterparty.
      // This is deliberately stricter than `conversations` below, which has no banner resting on
      // the field. An update must therefore carry the field: a partial write that leaves a stale
      // author behind is the same silencing without the bad faith, and every client write goes
      // through `FirestoreCustodyDataSource.setCustody`, which always stamps the signed-in uid.
      //
      // `dayOverrides` must be empty on create, for the reason `noForeignMarksOnCreate` exists
      // for `conversations`: without it, whoever's client wins the race to create the
      // deterministic-id document could bake in an already-ACCEPTED swap, and every restriction
      // the update rule places on deciding one would be moot. No client path needs it — a swap
      // is offered against an existing shared schedule, never alongside the first one.
      allow create: if isAuthenticated() &&
                      request.resource.data.participants.size() == 2 &&
                      request.auth.uid in request.resource.data.participants &&
                      modelId == canonicalPairId(request.resource.data.participants) &&
                      request.resource.data.participants[0] < request.resource.data.participants[1] &&
                      request.resource.data.lastModifiedBy == request.auth.uid &&
                      request.resource.data.get('dayOverrides', {}).keys().size() == 0 &&
                      planCitationValidOnCreate(request.resource.data) &&
                      (isPartnerOf(request.resource.data.participants[0]) ||
                       isPartnerOf(request.resource.data.participants[1]));

      // participants is immutable. Without this an existing participant could swap the other
      // one out for a third account: they would still be in the array and it would still hold
      // two uids, but the document id - derived from the original pair - would no longer name
      // who it is shared with, and the co-parent would lose the schedule with no trace.
      //
      // Two more clauses, both about one-off day swaps:
      //
      // - A write that changes `dayOverrides` must be a legitimate swap — see
      //   `validDayOverrideWrite`. Otherwise either parent could grant themselves a day and the
      //   other would merely be told, which is an announcement, not an agreement.
      // - A write that *calls itself* a swap must change nothing else — see
      //   `swapWriteTouchesOnlyTheSwap`. The banner is suppressed for that stamp, so without
      //   this a pattern rewrite could ride along on it and replace the co-parent's schedule
      //   in silence.
      // Two shapes of update are allowed, and a participant of the pair must always be the
      // caller:
      //
      // - a **proposal-only** write (put/withdraw/decline a proposal, or record its outcome),
      //   which by `proposalWriteTouchesOnlyProposal` cannot move the agreed pattern and so does
      //   not have to stamp `lastModifiedBy`; or
      // - a **pattern or swap** write, which must stamp `lastModifiedBy` with the caller and obey
      //   the day-override and swap-only constraints. Accepting a proposal is this shape.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants &&
                      request.resource.data.participants == resource.data.participants &&
                      (isPartnerOf(resource.data.participants[0]) ||
                       isPartnerOf(resource.data.participants[1])) &&
                      planCitationValid(resource.data, request.resource.data) &&
                      (
                        proposalWriteTouchesOnlyProposal(resource.data, request.resource.data) ||
                        (
                          request.resource.data.lastModifiedBy == request.auth.uid &&
                          (request.resource.data.get('dayOverrides', {}) ==
                             resource.data.get('dayOverrides', {}) ||
                           validDayOverrideWrite(resource.data, request.resource.data)) &&
                          (request.resource.data.get('lastModifiedKind', 'PATTERN') != 'SWAP' ||
                           swapWriteTouchesOnlyTheSwap(resource.data, request.resource.data))
                        )
                      );

      allow delete: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants;
    }

    // ---- Family settings (the agreed expense split) --------------------
    // One document per pair, id derived from the two UIDs exactly as `custody_models` is —
    // `canonicalPairId`, so the two documents of a pair can never disagree about which pair
    // they belong to.
    //
    // `allow get`, deliberately not `allow read`: this collection is read by document id alone,
    // so spelling it as `get` (which excludes `list`) makes that structurally true rather than
    // merely conventional, and a later `whereArrayContains('participants', uid)` is rejected
    // outright instead of quietly working.
    match /family_settings/{pairId} {
      // The missing-document clause is mandatory, not a nicety, and the reason is on record:
      // `resource` is null for a document that does not exist, `resource.data.participants`
      // raises a Null value error there, and a rule that errors is a rule that denies. The
      // repository subscribes before either parent has agreed anything, so the first read of
      // every new pair is a read of a document that is not there — under a single-clause
      // version that read is denied, the listener fails permanently, and its retry loop spins
      // forever. That is exactly what happened to `custody_models`, on two real handsets.
      //
      // The caller must still be one of the two uids the id is built from, so this is not an
      // existence oracle: `canonicalPairId` is derivable from any two uids, and without the
      // clause anyone could probe whether a given pair has an agreement.
      allow get: if isAuthenticated() && (
                   resource == null
                     ? request.auth.uid in pairId.split('__')
                     : (request.auth.uid in resource.data.participants &&
                        (isPartnerOf(resource.data.participants[0]) ||
                         isPartnerOf(resource.data.participants[1])))
                 );

      // The id must be the canonical id of the document's own participants, and the stored
      // array must itself be sorted. Both for the reasons `custody_models` documents at length:
      // without the first, any account could squat a pair's document at a derivable id and
      // permanently lock both parents out of it; without the second, `update`'s order-sensitive
      // equality would deny every subsequent write forever with no rule path able to re-sort it.
      //
      // No proposal may be baked in on create — the `noForeignMarksOnCreate` reflex. Whoever
      // wins the race to create the deterministic-id document would otherwise arrive with an
      // unanswerable proposal already on it, and every restriction the update rule places on
      // deciding one would be moot. No client path needs it: a ratio is proposed against an
      // existing agreement, never alongside the first one.
      //
      // The share is bounded. A ratio outside 0..10000 basis points is not a share, and the
      // client that would multiply it into a debt has no reason to defend itself against one.
      allow create: if isAuthenticated() &&
                      request.resource.data.participants.size() == 2 &&
                      request.auth.uid in request.resource.data.participants &&
                      pairId == canonicalPairId(request.resource.data.participants) &&
                      request.resource.data.participants[0] < request.resource.data.participants[1] &&
                      request.resource.data.lastModifiedBy == request.auth.uid &&
                      request.resource.data.momShareBasisPoints is int &&
                      request.resource.data.momShareBasisPoints >= 0 &&
                      request.resource.data.momShareBasisPoints <= 10000 &&
                      !('proposal' in request.resource.data) &&
                      (isPartnerOf(request.resource.data.participants[0]) ||
                       isPartnerOf(request.resource.data.participants[1]));

      // Exactly two shapes, and the split between them is what makes this an agreement rather
      // than an announcement:
      //
      // - a **proposal-only** write (put one, withdraw one, or record its outcome), which by
      //   `ratioProposalOnly` cannot move the agreed share; or
      // - an **acceptance** of the co-parent's proposal, which is the only write that may move
      //   it, and only to the figure they proposed.
      //
      // Deliberately *stricter* than `custody_models`, which admits any write that stamps its
      // author. A custody pattern is last-write-wins with a banner; a split that priced every
      // future expense could not be. Under the looser rule, a parent who happened to be the
      // document's last author could re-price everything unilaterally and the co-parent would
      // learn of it from a notification.
      //
      // `participants` is immutable either way. Without that, an existing participant could swap
      // the other out for a third account: the array would still hold two uids, but the id —
      // derived from the original pair — would no longer name who the agreement is with, and the
      // co-parent would lose it with no trace.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants &&
                      request.resource.data.participants == resource.data.participants &&
                      (isPartnerOf(resource.data.participants[0]) ||
                       isPartnerOf(resource.data.participants[1])) &&
                      request.resource.data.momShareBasisPoints is int &&
                      request.resource.data.momShareBasisPoints >= 0 &&
                      request.resource.data.momShareBasisPoints <= 10000 &&
                      (
                        ratioProposalOnly(resource.data, request.resource.data) ||
                        ratioAcceptance(resource.data, request.resource.data, request.auth.uid)
                      );

      // Deletable by either named participant even once the pairing behind it is gone, so an
      // orphaned document cannot become permanent. `unpairCoParent` deletes it as admin.
      allow delete: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants;
    }

    // ---- Conversations & messages --------------------------------------
    // 1:1 threads between the two paired parents. Deliberately minimal —
    // the chat feature's own hardening is a separate spec; without these
    // blocks the collections are deny-by-default and pairing's auto-created
    // conversation fails to sync.
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() &&
                    request.auth.uid in resource.data.participants;

      // A participant may amend only their own read/delivery mark. Without this, either
      // parent could write the other's `lastReadAt` and mark their own messages as read
      // on the recipient's behalf.
      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants &&
                      request.resource.data.participants == resource.data.participants &&
                      ownMarkOnly(resource.data, request.resource.data, 'lastReadAt') &&
                      ownMarkOnly(resource.data, request.resource.data, 'lastDeliveredAt') &&
                      !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(departureMarks());

      // A newly created conversation may not carry a foreign uid in either mark map (see
      // `noForeignMarksOnCreate`) — otherwise the update-time restriction above is moot,
      // since a forged mark could be baked into the document at creation instead.
      //
      // **The id is the pair's, and nothing else** (`ConversationKey.of`: the two uids sorted and
      // joined). Without that bind a participant could create a second thread for the same pair
      // under any id — a look-alike nobody else's phone observes — or squat the id of a pair they
      // are not in with their own participants, so the real pair's `ensureConversation` became an
      // update of a document naming somebody else, which the update rule refuses for ever. The
      // participants are stored sorted, as `ensureConversation` writes them, so the id and the
      // list say the same thing and `canonicalPairId` can index them. Only the functions (admin)
      // and legacy documents from before the bind carry any other id.
      allow create: if isAuthenticated() &&
                      request.auth.uid in request.resource.data.participants &&
                      request.resource.data.participants.size() == 2 &&
                      request.resource.data.participants[0] < request.resource.data.participants[1] &&
                      conversationId == canonicalPairId(request.resource.data.participants) &&
                      (isPartnerOf(request.resource.data.participants[0]) ||
                       isPartnerOf(request.resource.data.participants[1])) &&
                      noForeignMarksOnCreate(request.resource.data, 'lastReadAt') &&
                      noForeignMarksOnCreate(request.resource.data, 'lastDeliveredAt') &&
                      !request.resource.data.keys().hasAny(departureMarks());

      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
                    request.auth.uid in
                      get(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
                        .data.participants;

      // Membership of the thread, **and the pairing behind it still live** — the same gate
      // `conversations` create and `custody_models` get already apply. Unpair keeps the thread
      // for its history but must end the writing: without this an ex-partner kept posting, and
      // `onChatMessageCreated` kept pushing it to the other parent's lock screen.
      // `attachments` is bounded because since MON-23 it carries file references
      // (`ChatAttachmentCodec`) as well as the one event id a change-request card names; ten is
      // far above what any client writes and keeps a message document a message.
      // `timestamp` is the sender's own clock, and the export prints it (security audit, October
      // 2026): unbounded, a parent could post today a message dated a month ago and have it sit
      // in the record in date order. A number must lie between thirty days ago — a message the
      // outbox held while the phone was offline keeps the time it was written — and five minutes
      // ahead. The server's own receipt time is the document's `createTime`, which Firestore keeps
      // and no client can set; nothing is stamped on the message, because a retried `set()` of a
      // landed message would then be an update this rule refuses. An older build's ISO string is
      // left as it was.
      allow create: if isAuthenticated() &&
                      request.resource.data.senderId == request.auth.uid &&
                      (!(request.resource.data.get('timestamp', '') is number) ||
                       (request.resource.data.timestamp <= request.time.toMillis() + 5 * 60 * 1000 &&
                        request.resource.data.timestamp >= request.time.toMillis() - 30 * 24 * 60 * 60 * 1000)) &&
                      request.resource.data.get('attachments', []).size() <= 10 &&
                      request.auth.uid in
                        get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
                          .data.participants &&
                      (isPartnerOf(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
                          .data.participants[0]) ||
                       isPartnerOf(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
                          .data.participants[1])) &&
                      // A thread kept after a co-parent deleted their account takes no new message:
                      // it is there to be read and exported. The pairing check above already fails
                      // once the account is gone; this says so outright, whatever `isPartnerOf` does.
                      get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
                          .data.get('departedUid', '') == '';

      // Participants may flip the read flag, or — as of the legacy-conversation merge
      // (Task 5) — re-point a message to a different conversation and nothing else. The two
      // paths are disjoint `hasOnly` branches, so a single write can satisfy at most one:
      // isRead and conversationId can never change in the same write, and neither path opens
      // a way to touch content, sender, timestamp or attachments. See `canRepointMessage` for
      // what constrains the destination.
      allow update: if isAuthenticated() &&
                      request.auth.uid in
                        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
                          .data.participants &&
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) ||
                        (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conversationId']) &&
                          canRepointMessage(resource.data, request.resource.data)
                        )
                      );

      allow delete: if false;
    }
  }
}
